<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios.RendimientoServiciosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="8,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Rendimiento de servicios" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Historial de utilizaciones completadas con los precios y costos aplicados en cada operación." Foreground="{StaticResource Muted}" Margin="0,3,0,8"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Desde" VerticalAlignment="Center"/><DatePicker x:Name="FromPicker"/><TextBlock Text="Hasta" VerticalAlignment="Center" Margin="8,0,0,0"/><DatePicker x:Name="ToPicker"/><Button Content="Consultar" Click="Refresh_Click"/></StackPanel><UniformGrid Grid.Row="2" Columns="4" Margin="0,8"><Border Background="White" Padding="9" Margin="2"><StackPanel><TextBlock Text="Utilizaciones completadas" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UsesText" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="9" Margin="2"><StackPanel><TextBlock Text="Ingreso directo atribuido" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RevenueText" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="9" Margin="2"><StackPanel><TextBlock Text="Costos externos aplicados" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CostText" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="9" Margin="2"><StackPanel><TextBlock Text="Contribución identificable" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MarginText" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid><DataGrid Grid.Row="3" x:Name="PerformanceGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Usos completados" Binding="{Binding Usos}" Width="125"/><DataGridTextColumn Header="Ingreso adicional" Binding="{Binding Ingreso, StringFormat=Bs\ {0:N2}}" Width="145"/><DataGridTextColumn Header="Usos incluidos / adquiridos" Binding="{Binding UsosPaquete}" Width="155"/><DataGridTextColumn Header="Costo externo" Binding="{Binding Costo, StringFormat=Bs\ {0:N2}}" Width="130"/><DataGridTextColumn Header="Contribución conocida" Binding="{Binding Contribucion, StringFormat=Bs\ {0:N2}}" Width="160"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="4" Text="Los servicios incluidos y previamente adquiridos no se cuentan como ingreso directo en el periodo de utilización; el importe se reconoce en la compra. La contribución solo incluye precio directo y costo aplicado; no representa utilidad neta." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7"/></Grid></UserControl>
