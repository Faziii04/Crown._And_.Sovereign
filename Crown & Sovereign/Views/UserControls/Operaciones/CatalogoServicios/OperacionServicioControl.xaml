<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios.OperacionServicioControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="8,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Configuración operativa" FontSize="17" FontWeight="SemiBold"/><WrapPanel Grid.Row="1" Margin="0,10"><Border Background="#F1F5F9" CornerRadius="5" Padding="10" Margin="2"><TextBlock x:Name="OperationalText"/></Border><Border Background="#F1F5F9" CornerRadius="5" Padding="10" Margin="2"><TextBlock x:Name="DurationText"/></Border></WrapPanel><DataGrid Grid.Row="2" x:Name="EmployeeGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Empleado elegible" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="180"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"><ComboBox x:Name="EmployeeBox" Width="260" DisplayMemberPath="Nombre"/><Button Content="Asociar empleado" Click="Add_Click"/><Button Content="Desactivar asociación" Style="{StaticResource SecondaryButton}" Click="Remove_Click"/><TextBlock Text="La asociación indica elegibilidad; no confirma disponibilidad en una fecha." TextWrapping="Wrap" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0"/></StackPanel></Grid></UserControl>
