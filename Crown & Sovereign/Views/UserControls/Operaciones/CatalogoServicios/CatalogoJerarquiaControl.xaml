<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios.CatalogoJerarquiaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:Crown___Sovereign.Models" xmlns:detail="clr-namespace:Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios">
 <Grid Margin="2,10,2,2"><Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="260"/><ColumnDefinition Width="*" MinWidth="420"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,10,0">
   <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Jerarquía de servicios" FontSize="16" FontWeight="SemiBold" Margin="3,2,0,4"/><TextBox x:Name="SearchBox" ToolTip="Nombre, categoría, descripción, empleado, proveedor, producto o paquete" TextChanged="Search_Changed"/><ComboBox x:Name="StateFilter" SelectionChanged="Filter_Changed"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Expandir" Style="{StaticResource SecondaryButton}" Click="Expand_Click" Padding="8,5"/><Button Content="Contraer" Style="{StaticResource SecondaryButton}" Click="Collapse_Click" Padding="8,5"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,3,0,6"><Button Content="＋ Principal" Click="NewRoot_Click"/><Button Content="＋ Subservicio" Style="{StaticResource SecondaryButton}" Click="NewChild_Click"/></StackPanel></StackPanel>
    <TreeView x:Name="ServiceTree" SelectedItemChanged="Service_Selected"><TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type models:ServiceTreeNode}" ItemsSource="{Binding Children}"><Grid Margin="1,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Estado}" Foreground="{StaticResource Muted}" FontSize="10" Margin="8,0,2,0" VerticalAlignment="Center"/></Grid></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView>
   </DockPanel>
  </Border>
  <detail:DetalleServicioControl Grid.Column="1" x:Name="ServiceDetail"/>
 </Grid>
</UserControl>
