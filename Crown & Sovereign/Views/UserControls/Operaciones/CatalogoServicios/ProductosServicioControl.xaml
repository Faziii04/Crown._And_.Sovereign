<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios.ProductosServicioControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="8,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Productos asociados" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Configura los productos incluidos al prestar el servicio. Configurar una relación no descuenta inventario." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal"><ComboBox x:Name="ProductBox" Width="280" DisplayMemberPath="Nombre"/><TextBox x:Name="QuantityBox" Width="90" Text="1" ToolTip="Cantidad incluida"/><Button Content="Agregar / actualizar" Click="Add_Click"/></StackPanel><DataGrid Grid.Row="2" x:Name="ProductGrid" AutoGenerateColumns="False" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="160"/><DataGridTextColumn Header="Cantidad incluida" Binding="{Binding Cantidad}" Width="130"/><DataGridTextColumn Header="Existencias actuales" Binding="{Binding Existencias}" Width="140"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Quitar asociación" Style="{StaticResource SecondaryButton}" Click="Remove_Click"/></StackPanel></Grid></UserControl>
