<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios.CatalogoServiciosControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:catalog="clr-namespace:Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios">
 <Grid Background="{StaticResource Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,14">
   <StackPanel><TextBlock Text="Catálogo de servicios" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Gestiona la oferta del hotel, sus condiciones operativas y sus relaciones comerciales." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
  </Border>
  <UniformGrid Grid.Row="1" Columns="4" Margin="18,10,18,0">
   <Button Style="{StaticResource SecondaryButton}" Click="Activos_Click"><StackPanel><TextBlock Text="Servicios activos" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ActiveCount" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Incluye agrupaciones y ofertas" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Button>
   <Button Style="{StaticResource SecondaryButton}" Click="Reservables_Click"><StackPanel><TextBlock Text="Servicios reservables" Foreground="{StaticResource Muted}"/><TextBlock x:Name="BookableCount" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Ofertas independientes activas" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Button>
   <Button Style="{StaticResource SecondaryButton}" Click="Appointments_Click"><StackPanel><TextBlock Text="Requieren cita" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AppointmentCount" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Entre los servicios reservables" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Button>
   <Button Style="{StaticResource SecondaryButton}" Click="Review_Click"><StackPanel><TextBlock Text="Requieren revisión" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ReviewCount" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Configuración por verificar" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Button>
  </UniformGrid>
  <TabControl Grid.Row="2" Margin="18,0,18,14">
   <TabItem Header="Catálogo"><catalog:CatalogoJerarquiaControl x:Name="CatalogPage"/></TabItem>
   <TabItem Header="Disponibilidad y configuración"><catalog:DisponibilidadServiciosControl x:Name="ReadinessPage"/></TabItem>
   <TabItem Header="Rendimiento"><catalog:RendimientoServiciosControl/></TabItem>
  </TabControl>
 </Grid>
</UserControl>
