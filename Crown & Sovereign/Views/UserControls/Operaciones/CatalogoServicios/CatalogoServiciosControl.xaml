<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios.CatalogoServiciosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Crown___Sovereign.Models">
    <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Catálogo de servicios" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Jerarquía de servicios, requisitos, proveedores y recursos asociados." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="＋ Servicio principal" Click="NewRoot_Click"/><Button Content="＋ Subservicio" Style="{StaticResource SecondaryButton}" Click="NewChild_Click"/></StackPanel></Grid></Border>
        <Grid Grid.Row="1" Margin="24,14"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,12,0"><TreeView x:Name="ServiceTree" SelectedItemChanged="Service_Selected"><TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}" DataType="{x:Type views:ServiceTreeNode}"><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="{StaticResource Primary}" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView></Border>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><StackPanel><DockPanel><StackPanel><TextBlock x:Name="ServiceName" Text="Selecciona un servicio" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ServiceCategory" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><Button x:Name="EditButton" DockPanel.Dock="Right" Content="Editar servicio" Style="{StaticResource SecondaryButton}" Click="Edit_Click" IsEnabled="False"/></DockPanel><Separator Margin="0,16"/><TextBlock Text="Descripción operativa" FontWeight="SemiBold"/><TextBlock x:Name="DescriptionText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/><UniformGrid Columns="2"><StackPanel Margin="3"><TextBlock Text="Precio de referencia" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PriceText" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="3"><TextBlock Text="Cita" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AppointmentText" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="3"><TextBlock Text="Cobertura" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CoverageText" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="3"><TextBlock Text="Duración" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DurationText" FontSize="16" FontWeight="SemiBold"/></StackPanel></UniformGrid><TextBlock Text="Proveedor y recurso asociado" FontWeight="SemiBold" Margin="3,16,0,4"/><TextBlock x:Name="ProviderText" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
