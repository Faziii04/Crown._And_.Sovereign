<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios.ComercialServicioControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="8,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Configuración comercial" FontSize="17" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Editar servicio" Click="Edit_Click"/></DockPanel><TextBlock Grid.Row="1" x:Name="PriceText" FontSize="15" FontWeight="SemiBold" Margin="0,8"/><TextBlock Grid.Row="2" Text="Proveedores y costos vinculados · Los términos se administran en Convenios." FontWeight="SemiBold" Margin="0,2,0,5"/><DataGrid Grid.Row="3" x:Name="ProviderGrid" Margin="0,0,0,0" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/><DataGridTextColumn Header="Convenio" Binding="{Binding Convenio}" Width="*"/><DataGridTextColumn Header="Vigencia" Binding="{Binding Vigencia}" Width="150"/><DataGridTextColumn Header="Costo" Binding="{Binding Costo, StringFormat=Bs\ {0:N2}}" Width="105"/><DataGridTextColumn Header="Margen estimado" Binding="{Binding Margen, StringFormat=Bs\ {0:N2}}" Width="130"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="4" Text="Cobertura por paquete · Cada paquete conserva su propia regla." FontWeight="SemiBold" Margin="0,10,0,5"/><DataGrid Grid.Row="5" x:Name="PackageGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Paquete" Binding="{Binding Paquete}" Width="*"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Cobertura}" Width="150"/><DataGridTextColumn Header="Límite" Binding="{Binding Limite}" Width="120"/><DataGridTextColumn Header="Alcance" Binding="{Binding Alcance}" Width="140"/></DataGrid.Columns></DataGrid></Grid></UserControl>
