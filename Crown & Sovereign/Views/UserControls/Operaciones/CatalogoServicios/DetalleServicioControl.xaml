<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios.DetalleServicioControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:detail="clr-namespace:Crown___Sovereign.Views.UserControls.Operaciones.CatalogoServicios">
 <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="13">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><DockPanel><StackPanel><TextBlock x:Name="ServiceName" Text="Selecciona un servicio" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ServicePath" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="EditButton" Content="Editar configuración" Click="Edit_Click" IsEnabled="False"/><Button x:Name="StateButton" Content="Desactivar" Style="{StaticResource SecondaryButton}" Click="State_Click" IsEnabled="False"/></StackPanel></DockPanel>
    <TextBlock x:Name="StatusLine" Margin="0,8,0,0" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/><UniformGrid Columns="4" Margin="0,6,0,0"><StackPanel><TextBlock Text="Precio oficial" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PriceText" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="Duración" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DurationText" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="Empleados" Foreground="{StaticResource Muted}"/><TextBlock x:Name="EmployeeCount" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="Paquetes" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PackageCount" FontWeight="SemiBold"/></StackPanel></UniformGrid></StackPanel>
   <Grid Grid.Row="1"><TabControl x:Name="DetailTabs" Visibility="Collapsed"><TabItem Header="Información"><detail:InformacionServicioControl x:Name="InfoPage"/></TabItem><TabItem Header="Operación"><detail:OperacionServicioControl x:Name="OperationPage"/></TabItem><TabItem Header="Comercial"><detail:ComercialServicioControl x:Name="CommercialPage"/></TabItem><TabItem Header="Productos"><detail:ProductosServicioControl x:Name="ProductsPage"/></TabItem><TabItem Header="Imágenes"><detail:ImagenesServicioControl x:Name="ImagesPage"/></TabItem></TabControl><TextBlock x:Name="EmptyState" Text="Selecciona un servicio en la jerarquía para consultar su configuración, relaciones y comportamiento comercial." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="30"/></Grid>
  </Grid>
 </Border>
</UserControl>
