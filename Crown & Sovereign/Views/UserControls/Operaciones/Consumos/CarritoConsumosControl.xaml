<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.Consumos.CarritoConsumosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Consumo actual" FontSize="17" FontWeight="SemiBold"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="CartList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Producto.Nombre}" FontWeight="SemiBold"/><TextBlock Text="{Binding Producto.Precio, StringFormat='Bs {0:N2} por unidad'}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Cobertura}" Foreground="{StaticResource Information}" FontSize="10"/><TextBlock Text="{Binding Subtotal, StringFormat='Subtotal Bs {0:N2}'}" FontWeight="SemiBold" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="−" Tag="{Binding Producto.Id}" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="Quantity_Click"/><TextBlock Text="{Binding Cantidad}" VerticalAlignment="Center" MinWidth="24" TextAlignment="Center"/><Button Content="+" Tag="{Binding Producto.Id}" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="Quantity_Click"/></StackPanel><Button Grid.Column="2" Content="×" Tag="{Binding Producto.Id}" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource Danger}" Padding="7,3" VerticalAlignment="Center" Click="Remove_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8,12,8,0"><StackPanel><Grid><TextBlock Text="Total adicional" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="TotalText" HorizontalAlignment="Right" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/></Grid><Button Content="Registrar consumo" Margin="0,12,0,0" Click="Confirm_Click"/><TextBlock Text="Actualiza inventario y carga únicamente consumos no incluidos." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="3,5"/></StackPanel></Border></Grid>
</UserControl>
