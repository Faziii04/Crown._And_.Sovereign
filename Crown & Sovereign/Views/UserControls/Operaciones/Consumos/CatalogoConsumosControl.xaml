<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.Consumos.CatalogoConsumosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="SearchBox" Width="240" ToolTip="Buscar producto" TextChanged="Search_Changed"/><ComboBox x:Name="CategoryBox" Width="160" SelectionChanged="Category_Changed"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ProductList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Width="190" Padding="13" Margin="5"><StackPanel><Border Height="66" Background="#F1F5F9" CornerRadius="5"><TextBlock Text="▣" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Primary}"/></Border><TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Categoria}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Precio, StringFormat='Bs {0:N2}'}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="{Binding Stock, StringFormat='Stock: {0}'}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding CoberturaTexto}" Foreground="{StaticResource Information}" FontSize="10" TextWrapping="Wrap"/><Button Content="Agregar al pedido" Tag="{Binding}" Click="Add_Click" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
</UserControl>
