<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.Mantenimiento.IncidenciasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><ComboBox x:Name="StateBox" Width="180" SelectionChanged="Filter_Changed"/><Button Content="Reportar incidencia" DockPanel.Dock="Right" Click="Create_Click"/></DockPanel><DataGrid x:Name="IncidentGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}" Width="100"/><DataGridTextColumn Header="Incidencia" Binding="{Binding Descripcion}" Width="2*"/><DataGridTextColumn Header="Prioridad" Binding="{Binding Prioridad}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/><DataGridTextColumn Header="Impacto" Binding="{Binding Bloqueo}" Width="130"/><DataGridTemplateColumn Header="Acción" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Crear orden" Style="{StaticResource SecondaryButton}" Click="Order_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Resolver" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Resolver" Style="{StaticResource SecondaryButton}" Click="Resolve_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></UserControl>
