<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.Mantenimiento.OrdenesMantenimientoControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DataGrid x:Name="OrdersGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Incidencia" Binding="{Binding Incidencia}" Width="2*"/><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}" Width="100"/><DataGridTextColumn Header="Asignado a" Binding="{Binding AsignadoA}" Width="*"/><DataGridTextColumn Header="Fecha estimada" Binding="{Binding FechaEstimada, StringFormat=dd/MM/yyyy}" Width="130"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/></DataGrid.Columns></DataGrid></UserControl>
