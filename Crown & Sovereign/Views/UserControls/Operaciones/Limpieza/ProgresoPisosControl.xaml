<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.Limpieza.ProgresoPisosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="FloorList" Margin="12"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Piso, StringFormat=Piso {0}}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Progreso}" Maximum="100" Height="13" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Texto}" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></UserControl>
