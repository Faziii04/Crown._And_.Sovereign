<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.Limpieza.TableroLimpiezaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><ComboBox x:Name="StateBox" Width="170" SelectionChanged="Filter_Changed"/><Button Content="Nueva tarea" DockPanel.Dock="Right" Click="Create_Click"/></DockPanel><DataGrid x:Name="TaskGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}" Width="100"/><DataGridTextColumn Header="Piso" Binding="{Binding Piso}" Width="70"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*"/><DataGridTextColumn Header="Asignado a" Binding="{Binding Empleado}" Width="*"/><DataGridTextColumn Header="Hora" Binding="{Binding Hora, StringFormat=HH:mm}" Width="90"/><DataGridTextColumn Header="Prioridad" Binding="{Binding Prioridad}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/><DataGridTemplateColumn Header="Acción" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Avanzar" Style="{StaticResource SecondaryButton}" Click="Advance_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></UserControl>
