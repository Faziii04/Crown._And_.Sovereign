<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.Inventario.CatalogoProductosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBox x:Name="SearchBox" Width="260" ToolTip="Buscar producto" TextChanged="Search_Changed"/><Button Content="Nuevo producto" DockPanel.Dock="Right" Click="Create_Click"/></DockPanel><DataGrid x:Name="ProductsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Edit_Click"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="2*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*"/><DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=Bs {0:N2}}" Width="110"/><DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/><DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo}" Width="80"/><DataGridCheckBoxColumn Header="Incluido en paquete" Binding="{Binding IncluidoEnPaquete}" Width="150"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
