<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.Inventario.MovimientosInventarioControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBox x:Name="SearchBox" Width="260" ToolTip="Buscar producto o motivo" TextChanged="Filter_Changed"/><ComboBox x:Name="TypeBox" Width="190" Margin="8,0" SelectionChanged="Filter_Changed"/><TextBlock Text="Las entradas, salidas y ajustes quedan asociados al producto." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><DataGrid x:Name="MovementGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/><DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90"/><DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="2*"/><DataGridTextColumn Header="Existencia resultante" Binding="{Binding ExistenciaResultante}" Width="150"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
