<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.Inventario.ExistenciasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="Revisión de stock" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Registrar movimiento" DockPanel.Dock="Right" Click="Movement_Click"/></DockPanel><DataGrid x:Name="StockGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="2*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*"/><DataGridTextColumn Header="Existencia" Binding="{Binding Stock}" Width="110"/><DataGridTextColumn Header="Stock mínimo" Binding="{Binding StockMinimo}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding EstadoStock}" Width="130"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
