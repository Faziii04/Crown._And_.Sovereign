<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.AgendaServicios.SolicitudesServicioControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Solicitudes por programar" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Asigna o reprograma la cita solicitada por el huésped." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10"><TextBox x:Name="SearchBox" Width="280" ToolTip="Huésped, habitación o servicio" TextChanged="Search_Changed"/><ComboBox x:Name="StatusFilter" Width="160" SelectionChanged="Filter_Changed"/></StackPanel><DataGrid x:Name="RequestsGrid" Grid.Row="2" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding Guest}" Width="*"/><DataGridTextColumn Header="Habitación" Binding="{Binding Room}" Width="100"/><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Fecha deseada" Binding="{Binding DesiredDate, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="120"/><DataGridTemplateColumn Header="Acción" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Asignar / reprogramar" Style="{StaticResource SecondaryButton}" Padding="7,5" Click="Schedule_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid>
</UserControl>
