<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.AgendaServicios.CalendarioCitasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Calendario de citas" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Agenda por horario y responsable · doble clic en un bloque para gestionarlo." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10"><DatePicker x:Name="DateFilter" SelectedDateChanged="Filter_Changed"/><ComboBox x:Name="ServiceFilter" Width="170" SelectionChanged="Filter_Changed"/><ComboBox x:Name="EmployeeFilter" Width="220" SelectionChanged="Filter_Changed"/><Button Content="‹ Día anterior" Style="{StaticResource SecondaryButton}" Click="Previous_Click"/><Button Content="Hoy" Style="{StaticResource SecondaryButton}" Click="Today_Click"/><Button Content="Día siguiente ›" Style="{StaticResource SecondaryButton}" Click="Next_Click"/></StackPanel><Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="ScheduleGrid"/></ScrollViewer></Border></Grid>
</UserControl>
