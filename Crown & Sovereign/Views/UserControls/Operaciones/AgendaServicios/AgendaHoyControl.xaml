<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.AgendaServicios.AgendaHoyControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Agenda de hoy" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Cola cronológica de servicios y próximas citas." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><ItemsControl x:Name="MetricsView" Grid.Row="1" Margin="0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4"><StackPanel><TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Valor}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="AppointmentsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Start, StringFormat=HH:mm}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding Service}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Guest}"/><TextBlock Text="{Binding Room, StringFormat='Habitación {0}'}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Employee, StringFormat='Responsable: {0}'}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><Button Grid.Column="2" Content="Gestionar" Tag="{Binding Id}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="Manage_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
</UserControl>
