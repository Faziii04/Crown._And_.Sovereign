<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.Dashboard.OperacionesDashboardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
        <TextBlock Text="Centro de operaciones" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Prioridades del equipo para el turno actual." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
        <ItemsControl ItemsSource="{Binding Metricas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="5"><StackPanel><TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Valor}" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="Agenda próxima" FontSize="17" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding Citas}" AutoGenerateColumns="False" Height="340" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Hora" Binding="{Binding Inicio, StringFormat=HH:mm}" Width="65"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Hab." Binding="{Binding Habitacion}" Width="65"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/></DataGrid.Columns></DataGrid></StackPanel></Border>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="Alertas operativas" FontSize="17" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Alertas}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detalle}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Estado}" Foreground="{StaticResource Warning}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="{Binding Accion}" Tag="{Binding Modulo}" Click="Navigate_Click" Style="{StaticResource SecondaryButton}" Padding="8,5"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </Grid>
    </StackPanel></ScrollViewer>
</UserControl>
