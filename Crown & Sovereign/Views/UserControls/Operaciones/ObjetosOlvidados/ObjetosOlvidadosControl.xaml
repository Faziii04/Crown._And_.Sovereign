<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.ObjetosOlvidados.ObjetosOlvidadosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="24,18"><TextBlock Text="Objetos olvidados" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Registro y seguimiento de objetos encontrados en habitaciones" Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel><Grid Grid.Row="1" Margin="24,0,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBox x:Name="SearchBox" Width="280" ToolTip="Buscar objeto, habitación o estado" TextChanged="Search_Changed"/><Button Content="Registrar objeto" DockPanel.Dock="Right" Click="Create_Click"/></DockPanel><DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Objeto" Binding="{Binding Descripcion}" Width="2*"/><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}" Width="100"/><DataGridTextColumn Header="Encontrado" Binding="{Binding Encontrado, StringFormat=dd/MM/yyyy}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/><DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="2*"/><DataGridTemplateColumn Header="Acción" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Registrar devolución" Style="{StaticResource SecondaryButton}" Click="Return_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Grid></UserControl>
