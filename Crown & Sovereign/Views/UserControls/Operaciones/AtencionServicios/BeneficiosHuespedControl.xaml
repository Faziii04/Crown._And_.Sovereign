<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.AtencionServicios.BeneficiosHuespedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Beneficios del huésped" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PackageText" Foreground="{StaticResource Muted}" Margin="0,3,0,8"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="150"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Coverage}" Width="150"/><DataGridTextColumn Header="Disponibilidad" Binding="{Binding Remaining}" Width="130"/><DataGridTextColumn Header="Cita" Binding="{Binding RequiresAppointment}" Width="75"/><DataGridTextColumn Header="Precio adicional" Binding="{Binding Price}" Width="130"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
