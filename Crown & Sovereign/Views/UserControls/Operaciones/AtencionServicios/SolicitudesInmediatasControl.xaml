<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.AtencionServicios.SolicitudesInmediatasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,10"><TextBlock Text="Solicitudes inmediatas" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Acepta, inicia y registra la entrega en la misma solicitud creada por Recepción." Foreground="{StaticResource Muted}"/></StackPanel><DataGrid x:Name="RequestsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding Guest}" Width="*"/><DataGridTextColumn Header="Hab." Binding="{Binding Room}" Width="70"/><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Solicitud" Binding="{Binding RequestedAt, StringFormat=dd/MM HH:mm}" Width="125"/><DataGridTextColumn Header="Responsable" Binding="{Binding Responsible}" Width="140"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="120"/><DataGridTemplateColumn Header="Iniciar" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Iniciar" Tag="{Binding Id}" Click="Start_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Entrega" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Completar" Tag="{Binding Id}" Click="Complete_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid>
</UserControl>
