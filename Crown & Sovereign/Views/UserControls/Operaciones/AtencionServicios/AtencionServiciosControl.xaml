<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.AtencionServicios.AtencionServiciosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:selectors="clr-namespace:Crown___Sovereign.Views.UserControls.Shared.Selectors" xmlns:services="clr-namespace:Crown___Sovereign.Views.UserControls.Operaciones.AtencionServicios">
    <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,18"><StackPanel><TextBlock Text="Atención de servicios" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Consulta los beneficios del huésped y registra la utilización real." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
        <Grid Grid.Row="1" Margin="24,12"><Grid.ColumnDefinitions><ColumnDefinition Width="315"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><selectors:SelectorHuespedActivoControl x:Name="GuestSelector" Margin="0,0,12,0"/><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="GuestTitle" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="GuestSubtitle" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="ESTANCIA ACTIVA" Foreground="{StaticResource Success}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border>
            <TabControl x:Name="UsageTabs" Grid.Row="1" Margin="0,10,0,0"><TabItem Header="Servicios disponibles"><services:ServiciosDisponiblesControl x:Name="AvailableServicesView"/></TabItem><TabItem Header="Beneficios"><services:BeneficiosHuespedControl x:Name="BenefitsView"/></TabItem><TabItem Header="Resumen"><services:ResumenUtilizacionControl x:Name="UsageSummaryView"/></TabItem><TabItem Header="Historial"><services:HistorialUtilizacionControl x:Name="UsageHistoryView"/></TabItem><TabItem Header="Solicitudes inmediatas"><services:SolicitudesInmediatasControl x:Name="ImmediateRequestsView"/></TabItem></TabControl>
        </Grid></Grid>
    </Grid>
</UserControl>
