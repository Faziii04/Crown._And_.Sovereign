<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.AtencionServicios.ResumenUtilizacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Resumen de utilización" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Servicios confirmados durante la estancia activa." Foreground="{StaticResource Muted}" Margin="0,3,0,8"/></StackPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="4"><StackPanel><TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Valor}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
</UserControl>
