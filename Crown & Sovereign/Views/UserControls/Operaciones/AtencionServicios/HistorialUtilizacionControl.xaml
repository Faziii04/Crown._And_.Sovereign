<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.AtencionServicios.HistorialUtilizacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Historial de utilización" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Registro compartido con estancia y folio." Foreground="{StaticResource Muted}" Margin="0,3,0,8"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Cobertura}" Width="145"/><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo, StringFormat='Bs {0:N2}'}" Width="130"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
