<UserControl x:Class="Crown___Sovereign.Views.UserControls.Operaciones.AtencionServicios.ServiciosDisponiblesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock Text="Servicios disponibles" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Confirma solamente el uso real. Las citas se administran desde Agenda." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,9"/><ItemsControl ItemsSource="{Binding}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Width="228" Padding="13" Margin="5"><StackPanel><TextBlock Text="{Binding Service.Nombre}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Service.Categoria}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Coverage}" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding Price}" Foreground="{StaticResource Muted}" FontSize="11"/><Button Content="{Binding Action}" Tag="{Binding Service}" IsEnabled="{Binding Available}" Click="Register_Click" Margin="0,9,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
</UserControl>
