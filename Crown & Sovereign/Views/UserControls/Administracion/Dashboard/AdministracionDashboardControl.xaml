<UserControl x:Class="Crown___Sovereign.Views.UserControls.Administracion.Dashboard.AdministracionDashboardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Administración del hotel" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Personal, accesos e infraestructura en una vista técnica." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
        <ItemsControl ItemsSource="{Binding Metricas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Valor}" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="Cuentas por rol" FontSize="17" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Roles}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10"><Grid><TextBlock Text="{Binding Rol}" FontWeight="SemiBold"/><TextBlock Text="{Binding Cantidad}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="Actividad reciente" FontSize="17" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding Auditoria}" AutoGenerateColumns="False" Height="260" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM HH:mm}" Width="120"/><DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="110"/><DataGridTextColumn Header="Cambio" Binding="{Binding Cambio}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid>
    </StackPanel></ScrollViewer>
</UserControl>
