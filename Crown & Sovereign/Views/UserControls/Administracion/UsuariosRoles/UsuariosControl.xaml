<UserControl x:Class="Crown___Sovereign.Views.UserControls.Administracion.UsuariosRoles.UsuariosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DataGrid x:Name="UsersGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="*"/><DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*"/><DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="*"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="100"/></DataGrid.Columns></DataGrid></UserControl>
