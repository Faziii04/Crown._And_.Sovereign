<UserControl x:Class="Crown___Sovereign.Views.UserControls.Administracion.Sistema.ModulosParametrosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="24,18"><TextBlock Text="Módulos y parámetros" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Disponibilidad de módulos funcionales" Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel><DataGrid x:Name="ModulesGrid" Grid.Row="1" Margin="24,0,24,20" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Módulo" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="140"/><DataGridTemplateColumn Header="Acción" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Alternar" Style="{StaticResource SecondaryButton}" Click="Toggle_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></UserControl>
