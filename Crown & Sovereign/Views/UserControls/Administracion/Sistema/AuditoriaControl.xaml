<UserControl x:Class="Crown___Sovereign.Views.UserControls.Administracion.Sistema.AuditoriaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="24,18"><TextBlock Text="Auditoría" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Trazabilidad de cambios administrativos" Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel><DataGrid x:Name="AuditGrid" Grid.Row="1" Margin="24,0,24,20" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/><DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="*"/><DataGridTextColumn Header="Acción" Binding="{Binding Cambio}" Width="*"/><DataGridTextColumn Header="Antes" Binding="{Binding Antes}" Width="*"/><DataGridTextColumn Header="Después" Binding="{Binding Despues}" Width="2*"/></DataGrid.Columns></DataGrid></Grid></UserControl>
