<UserControl x:Class="Crown___Sovereign.Views.UserControls.Administracion.Configuracion.ConfiguracionHotelControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="24,18"><TextBlock Text="Configuración del hotel" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Identidad y datos de contacto" Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="24,0,24,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,12,8"><TextBlock Text="Nombre comercial"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,8"><TextBlock Text="Categoría"/><TextBox x:Name="CategoryBox"/></StackPanel><StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8"><TextBlock Text="Dirección"/><TextBox x:Name="AddressBox"/></StackPanel><StackPanel Grid.Row="2" Margin="0,0,12,8"><TextBlock Text="Teléfono"/><TextBox x:Name="PhoneBox"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,8"><TextBlock Text="Correo"/><TextBox x:Name="EmailBox"/></StackPanel><TextBlock x:Name="StatusText" Grid.Row="3" Grid.ColumnSpan="2" Foreground="{StaticResource Success}" Margin="4,8"/><Button Grid.Row="4" Grid.Column="1" Content="Guardar cambios" HorizontalAlignment="Right" Click="Save_Click"/></Grid></Border></Grid></UserControl>
