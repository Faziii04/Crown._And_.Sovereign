<UserControl x:Class="Crown___Sovereign.Views.UserControls.Administracion.Empleados.EmpleadosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Empleados" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Directorio del personal y asignación funcional" Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel><Button Grid.Column="1" Content="Nuevo empleado" VerticalAlignment="Center" Click="Create_Click"/></Grid><Grid Grid.Row="1" Margin="24,0,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="SearchBox" Width="300" HorizontalAlignment="Left" ToolTip="Buscar empleado, cargo o correo" TextChanged="Search_Changed"/><DataGrid x:Name="EmployeesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="*"/><DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="2*"/><DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="*"/><DataGridTextColumn Header="Rol de acceso" Binding="{Binding Rol}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Grid></UserControl>
