<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.SupervisionInventarioRecursosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Inventario y recursos" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Consulta de existencias, servicios relacionados, asignaciones de recursos y consumos registrados." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3"/><WrapPanel><TextBox x:Name="SearchBox" Width="250" ToolTip="Buscar producto, servicio o recurso" TextChanged="Filter_Changed"/><ComboBox x:Name="StockBox" Width="170" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos los productos" IsSelected="True"/><ComboBoxItem Content="Bajo mínimo"/><ComboBoxItem Content="Agotados"/></ComboBox></WrapPanel></StackPanel>
  <TabControl x:Name="InventoryTabs" Grid.Row="1" Margin="0,4,0,0"><TabItem Header="Productos"><DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="150"/><DataGridTextColumn Header="Existencias" Binding="{Binding Stock}" Width="95"/><DataGridTextColumn Header="Mínimo" Binding="{Binding Minimo}" Width="85"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/><DataGridTextColumn Header="Servicios asociados" Binding="{Binding ServiciosAfectados}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Recursos adicionales"><DataGrid x:Name="ResourcesGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Recurso" Binding="{Binding Recurso}" Width="*"/><DataGridTextColumn Header="Reserva" Binding="{Binding ReservaId}" Width="90"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}" Width="90"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/><DataGridTextColumn Header="Periodo" Binding="{Binding Llegada, StringFormat=dd/MM/yyyy}" Width="95"/><DataGridTextColumn Header="Disponibilidad" Binding="{Binding Disponibilidad}" Width="140"/><DataGridCheckBoxColumn Header="Devolución pendiente" Binding="{Binding DevolucionPendiente}" Width="130"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Consumos históricos"><DataGrid x:Name="ConsumptionGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/><DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90"/><DataGridCheckBoxColumn Header="Incluido" Binding="{Binding Incluido}" Width="75"/><DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="160"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </Grid>
</UserControl>

