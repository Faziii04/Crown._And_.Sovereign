<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.ReportesControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:reports="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Supervision.Reportes">
 <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="22,16,22,8"><TextBlock Text="Reportes" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Analiza el rendimiento comercial, financiero y operativo con los registros disponibles." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
  <TabControl x:Name="ReportTabs" Grid.Row="1" Margin="18,0,18,18">
   <TabItem Header="Biblioteca de reportes"><reports:BibliotecaReportesControl x:Name="Library"/></TabItem>
   <TabItem Header="Generador"><reports:GeneradorReportesControl x:Name="Generator"/></TabItem>
   <TabItem Header="Reportes recientes"><reports:ReportesRecientesControl x:Name="Recent"/></TabItem>
  </TabControl>
 </Grid>
</UserControl>
