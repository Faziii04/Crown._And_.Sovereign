<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.ReportesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="24,18"><TextBlock Text="Reportes" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Genera vistas de ocupación, finanzas y operación" Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel><Grid Grid.Row="1" Margin="24,0,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><ComboBox x:Name="ReportBox" Width="230"/><Button Content="Generar vista" DockPanel.Dock="Right" Click="Generate_Click"/></DockPanel><DataGrid x:Name="ReportsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Reporte" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*"/><DataGridTextColumn Header="Generado" Binding="{Binding Generado, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/></DataGrid.Columns></DataGrid></Grid></Grid></UserControl>
