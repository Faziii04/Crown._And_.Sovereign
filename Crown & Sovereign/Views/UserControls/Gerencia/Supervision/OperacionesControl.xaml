<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.OperacionesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ops="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Supervision">
    <Grid Background="{StaticResource Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="24,16,24,8">
            <DockPanel><StackPanel><TextBlock Text="Supervisión operativa" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Supervisa la preparación, capacidad y continuidad operativa del hotel." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Actualizar" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/></DockPanel>
            <DockPanel Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Periodo de actividad" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="PeriodBox" Width="170" SelectionChanged="Period_Changed"><ComboBoxItem Content="Hoy" IsSelected="True"/><ComboBoxItem Content="Ayer"/><ComboBoxItem Content="Últimos 7 días"/><ComboBoxItem Content="Últimos 30 días"/><ComboBoxItem Content="Este mes"/><ComboBoxItem Content="Mes anterior"/><ComboBoxItem Content="Periodo personalizado"/></ComboBox><DatePicker x:Name="FromPicker" Width="140" Visibility="Collapsed"/><TextBlock x:Name="RangeSeparator" Text="a" VerticalAlignment="Center" Visibility="Collapsed"/><DatePicker x:Name="ToPicker" Width="140" Visibility="Collapsed"/></StackPanel><TextBlock x:Name="UpdatedText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
            <TextBlock x:Name="PeriodNote" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ItemsControl x:Name="MetricList" Grid.Row="1" Margin="20,0,20,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Seccion}" Click="Metric_Click" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="4" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Valor}" FontSize="26" FontWeight="SemiBold" Margin="0,3"/><TextBlock Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TabControl x:Name="Sections" Grid.Row="2" Margin="24,0,24,18" SelectionChanged="Section_Changed">
            <TabItem Header="Resumen"><ops:ResumenOperativoControl x:Name="SummaryView"/></TabItem>
            <TabItem Header="Habitaciones"><ops:SupervisionHabitacionesControl x:Name="RoomsView"/></TabItem>
            <TabItem Header="Limpieza"><ops:SupervisionLimpiezaControl x:Name="HousekeepingView"/></TabItem>
            <TabItem Header="Mantenimiento"><ops:SupervisionMantenimientoControl x:Name="MaintenanceView"/></TabItem>
            <TabItem Header="Servicios"><ops:SupervisionServiciosControl x:Name="ServicesView"/></TabItem>
            <TabItem Header="Inventario y recursos"><ops:SupervisionInventarioRecursosControl x:Name="InventoryView"/></TabItem>
        </TabControl>
    </Grid>
</UserControl>
