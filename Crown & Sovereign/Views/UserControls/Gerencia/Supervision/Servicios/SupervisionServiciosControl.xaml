<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.SupervisionServiciosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Supervisión de servicios" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Solicitudes, citas y compromisos adquiridos. La coordinación operativa permanece en su equipo." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3"/><WrapPanel><TextBox x:Name="SearchBox" Width="260" ToolTip="Buscar huésped, servicio o proveedor" TextChanged="Filter_Changed"/><ComboBox x:Name="TypeBox" Width="180" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos los tipos" IsSelected="True"/><ComboBoxItem Content="Solicitud"/><ComboBoxItem Content="Cita"/><ComboBoxItem Content="Traslado"/><ComboBoxItem Content="Compromiso adquirido"/></ComboBox><ComboBox x:Name="StateBox" Width="170" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos los estados" IsSelected="True"/><ComboBoxItem Content="Pendientes"/><ComboBoxItem Content="Confirmada"/><ComboBoxItem Content="Completada"/><ComboBoxItem Content="Cancelada"/></ComboBox></WrapPanel></StackPanel>
  <TabControl x:Name="ServicesTabs" Grid.Row="1" Margin="0,4,0,0"><TabItem Header="Compromisos y coordinación"><DataGrid x:Name="ServicesGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="140"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Hab." Binding="{Binding Habitacion}" Width="65"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM HH:mm}" Width="120"/><DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="145"/><DataGridTextColumn Header="Proveedor / convenio" Binding="{Binding Proveedor}" Width="180"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/><DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Conflictos de agenda"><DataGrid x:Name="ConflictGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/><DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="160"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/><DataGridTextColumn Header="Contexto" Binding="{Binding Detalle}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Coordinación externa"><StackPanel Margin="8"><TextBlock Text="La vigencia de un convenio no prueba disponibilidad del proveedor." Foreground="{StaticResource Warning}" Margin="2,2,2,8" TextWrapping="Wrap"/><DataGrid x:Name="ExternalGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Fecha solicitada" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="Convenio / proveedor" Binding="{Binding Proveedor}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/><DataGridTextColumn Header="Revisión" Binding="{Binding Detalle}" Width="2*"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
  </TabControl>
 </Grid>
</UserControl>

