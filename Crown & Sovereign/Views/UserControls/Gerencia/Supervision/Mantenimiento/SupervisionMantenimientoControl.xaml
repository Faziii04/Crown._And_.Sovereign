<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.SupervisionMantenimientoControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Supervisión de mantenimiento" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Separa incidencia, reparación y bloqueo actual de habitación." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3"/><WrapPanel><TextBox x:Name="SearchBox" Width="230" ToolTip="Buscar habitación o incidencia" TextChanged="Filter_Changed"/><ComboBox x:Name="PriorityBox" Width="145" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todas las prioridades" IsSelected="True"/><ComboBoxItem Content="Urgente"/><ComboBoxItem Content="Alta"/><ComboBoxItem Content="Media"/><ComboBoxItem Content="Baja"/></ComboBox><ComboBox x:Name="StateBox" Width="155" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos los estados" IsSelected="True"/><ComboBoxItem Content="Abiertas"/><ComboBoxItem Content="Resueltas"/></ComboBox></WrapPanel></StackPanel>
  <TabControl x:Name="MaintenanceTabs" Grid.Row="1" Margin="0,4,0,0"><TabItem Header="Incidencias"><DataGrid x:Name="IncidentGrid" AutoGenerateColumns="False" SelectionChanged="Incident_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Hab." Binding="{Binding Habitacion}" Width="75"/><DataGridTextColumn Header="Incidencia" Binding="{Binding Descripcion}" Width="2*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="110"/><DataGridTextColumn Header="Prioridad" Binding="{Binding Prioridad}" Width="95"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="115"/><DataGridTextColumn Header="Impacto observado" Binding="{Binding Impacto}" Width="160"/><DataGridTextColumn Header="Bloqueo actual" Binding="{Binding BloqueoActivo}" Width="100"/><DataGridTextColumn Header="Requiere revisión" Binding="{Binding RequiereBloqueoSinRegistro}" Width="110"/><DataGridTextColumn Header="Reportada" Binding="{Binding Reportada, StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="Reservas próximas" Binding="{Binding ReservasAfectadas}" Width="110"/><DataGridTextColumn Header="Orden vinculada" Binding="{Binding Ordenes}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Órdenes"><DataGrid x:Name="OrderGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Orden" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Incidencia" Binding="{Binding Incidencia}" Width="*"/><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}" Width="90"/><DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="160"/><DataGridTextColumn Header="Fecha estimada" Binding="{Binding Estimada, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/><DataGridCheckBoxColumn Header="Vencida" Binding="{Binding Vencida}" Width="70"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Bloqueos y capacidad"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="BlockedGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Habitación" Binding="{Binding Numero}" Width="95"/><DataGridTextColumn Header="Piso" Binding="{Binding Piso}" Width="60"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*"/><DataGridTextColumn Header="Ocupación" Binding="{Binding Ocupacion}" Width="100"/><DataGridTextColumn Header="Llegada próxima" Binding="{Binding ProximaLlegada}" Width="140"/><DataGridTextColumn Header="Atención" Binding="{Binding NotaAtencion}" Width="2*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Text="El modelo guarda el indicador actual de bloqueo, pero no fechas de inicio/fin. No se presenta una línea de tiempo ni se libera una habitación desde esta vista." Foreground="{StaticResource Warning}" Margin="3,7" TextWrapping="Wrap"/></Grid></TabItem>
   <TabItem Header="Rendimiento"><ScrollViewer><StackPanel Margin="14"><TextBlock Text="Resumen del periodo consultado" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PerformanceText" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="No se estiman costos ni SLA: el modelo no registra costos de reparación ni compromisos de servicio." Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,8"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>


