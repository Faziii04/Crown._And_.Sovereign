<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.PoliticasHotelControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="24,18"><TextBlock Text="Políticas del hotel" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Condiciones operativas y de atención al huésped" Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel><DataGrid x:Name="PoliciesGrid" Grid.Row="1" Margin="24,0,24,20" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Política" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*"/><DataGridTextColumn Header="Valor vigente" Binding="{Binding Valor}" Width="*"/></DataGrid.Columns></DataGrid></Grid></UserControl>
