<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.PoliticasHotelControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:policies="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Supervision.Politicas">
 <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="22,16,22,8"><TextBlock Text="Políticas del hotel" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Consulta y administra las reglas de negocio compatibles con el sistema." Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel>
  <Border Grid.Row="1" Margin="22,0,22,8" Padding="9" CornerRadius="6" Background="#FFF7E6" BorderBrush="#F4D38A" BorderThickness="1"><TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap"/></Border>
  <TabControl x:Name="PolicyTabs" Grid.Row="2" Margin="18,0,18,18">
   <TabItem Header="Alojamiento"><policies:PoliticasAlojamientoControl x:Name="Accommodation"/></TabItem>
   <TabItem Header="Reservas y cancelaciones"><policies:PoliticasReservasControl x:Name="Reservations"/></TabItem>
   <TabItem Header="Pagos y garantías"><policies:PoliticasPagosControl x:Name="Payments"/></TabItem>
   <TabItem Header="Servicios"><policies:PoliticasServiciosControl x:Name="Services"/></TabItem>
   <TabItem Header="Historial de cambios"><policies:HistorialPoliticasControl x:Name="History"/></TabItem>
  </TabControl>
 </Grid>
</UserControl>
