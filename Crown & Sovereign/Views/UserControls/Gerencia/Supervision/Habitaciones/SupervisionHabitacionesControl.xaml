<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.SupervisionHabitacionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><DockPanel><StackPanel><TextBlock Text="Supervisión de habitaciones" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Ocupación, limpieza, bloqueo y preparación son condiciones distintas." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3"/></StackPanel><Button Content="Ver ingresos en riesgo" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="ShowArrivals_Click"/></DockPanel>
   <WrapPanel Margin="0,4"><TextBox x:Name="SearchBox" Width="210" ToolTip="Buscar habitación, tipo o huésped" TextChanged="Filter_Changed"/><ComboBox x:Name="FloorBox" Width="120" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos los pisos" IsSelected="True"/></ComboBox><ComboBox x:Name="StateBox" Width="160" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos los estados" IsSelected="True"/><ComboBoxItem Content="Lista"/><ComboBoxItem Content="Ocupada"/><ComboBoxItem Content="En preparación"/><ComboBoxItem Content="Bloqueada"/><ComboBoxItem Content="Por verificar"/></ComboBox></WrapPanel>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TabControl x:Name="RoomTabs" Margin="0,4,4,0"><TabItem Header="Tablero"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="BoardList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="SelectRoom_Click" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="11" Margin="4" Width="150" Height="112" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{Binding Numero, StringFormat='Hab. {0}'}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Tipo}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Estado}" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Limpieza}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding NotaAtencion}" Foreground="{StaticResource Warning}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
    <TabItem Header="Listado"><DataGrid x:Name="RoomGrid" AutoGenerateColumns="False" SelectionChanged="Room_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Habitación" Binding="{Binding Numero}" Width="90"/><DataGridTextColumn Header="Piso" Binding="{Binding Piso}" Width="55"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/><DataGridTextColumn Header="Ocupación" Binding="{Binding Ocupacion}" Width="90"/><DataGridTextColumn Header="Huésped(es)" Binding="{Binding HuespedesActuales}" Width="150"/><DataGridTextColumn Header="Limpieza" Binding="{Binding Limpieza}" Width="130"/><DataGridCheckBoxColumn Header="Bloqueo" Binding="{Binding BloqueoActivo}" Width="65"/><DataGridTextColumn Header="Próx. ingreso" Binding="{Binding ProximaLlegada}" Width="100"/><DataGridTextColumn Header="Preparación" Binding="{Binding Preparacion}" Width="150"/><DataGridTextColumn Header="Atención" Binding="{Binding NotaAtencion}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="Próximos ingresos"><DataGrid x:Name="ArrivalsGrid" AutoGenerateColumns="False" SelectionChanged="Arrival_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Reserva" Binding="{Binding ReservaId, StringFormat=#\{0\}}" Width="85"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Llegada" Binding="{Binding Llegada, StringFormat=dd/MM/yyyy}" Width="95"/><DataGridTextColumn Header="Habitación(es)" Binding="{Binding Habitaciones}" Width="125"/><DataGridTextColumn Header="Preparación" Binding="{Binding Condicion}" Width="155"/><DataGridTextColumn Header="Condición" Binding="{Binding Prioridad}" Width="130"/></DataGrid.Columns></DataGrid></TabItem>
   </TabControl>
   <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Detalle operativo · solo consulta" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock x:Name="DetailText" Text="Selecciona una habitación o ingreso para consultar su preparación." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBlock Text="Incidencias relacionadas" FontWeight="SemiBold" Margin="0,14,0,4"/><ItemsControl x:Name="RoomIncidents"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6"><StackPanel><TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Resumen}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Alternativas para próxima reserva" FontWeight="SemiBold" Margin="0,14,0,4"/><ItemsControl x:Name="AlternativesList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="RoomBasisText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
  </Grid>
 </Grid>
</UserControl>


