<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.ResumenOperativoControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
  <TextBlock Text="Resumen operativo" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,8"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Estado actual de habitaciones" FontSize="16" FontWeight="SemiBold"/><UniformGrid Columns="2" Margin="0,10"><TextBlock Text="Habitaciones listas"/><TextBlock x:Name="ReadyText" FontWeight="SemiBold"/><TextBlock Text="Ocupadas"/><TextBlock x:Name="OccupiedText" FontWeight="SemiBold"/><TextBlock Text="En preparación / por verificar" TextWrapping="Wrap"/><TextBlock x:Name="PreparingText" FontWeight="SemiBold"/><TextBlock Text="Bloqueadas"/><TextBlock x:Name="BlockedText" FontWeight="SemiBold"/><TextBlock Text="Total consultado"/><TextBlock x:Name="TotalText" FontWeight="SemiBold"/></UniformGrid><TextBlock x:Name="RoomBasis" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
   <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Requieren atención" FontSize="16" FontWeight="SemiBold"/><DataGrid x:Name="AlertsGrid" AutoGenerateColumns="False" Height="240" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Nivel" Binding="{Binding Nivel}" Width="110"/><DataGridTextColumn Header="Situación" Binding="{Binding Titulo}" Width="*"/><DataGridTextColumn Header="Contexto" Binding="{Binding Detalle}" Width="2*"/><DataGridTemplateColumn Header="Acción" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Consultar" Tag="{Binding}" Click="Navigate_Click" Style="{StaticResource SecondaryButton}" Padding="5,3"/><Button Content="Notificar" Tag="{Binding}" Click="Notify_Click" Style="{StaticResource SecondaryButton}" Padding="5,3"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Text="Los avisos se derivan de registros disponibles; consultar no modifica reservas ni tareas." Foreground="{StaticResource Muted}" FontSize="11" Margin="2,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  </Grid>
  <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Preparación de habitaciones" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Tareas completadas por periodo; pendientes y en ejecución reflejan el estado actual." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3" TextWrapping="Wrap"/><UniformGrid Columns="2" Margin="0,10"><TextBlock Text="Tareas programadas en periodo"/><TextBlock x:Name="TasksText" FontWeight="SemiBold"/><TextBlock Text="Completadas en periodo"/><TextBlock x:Name="CompletedText" FontWeight="SemiBold"/><TextBlock Text="En ejecución · actual"/><TextBlock x:Name="InProgressText" FontWeight="SemiBold"/><TextBlock Text="Pendientes · actual"/><TextBlock x:Name="PendingText" FontWeight="SemiBold"/><TextBlock Text="Inspecciones pendientes"/><TextBlock x:Name="InspectionsText" FontWeight="SemiBold"/></UniformGrid></StackPanel></Border>
   <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Próximos compromisos · próximos 7 días" FontSize="16" FontWeight="SemiBold"/><DataGrid x:Name="CommitmentsGrid" AutoGenerateColumns="False" Height="210" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM HH:mm}" Width="120"/><DataGridTextColumn Header="Compromiso" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/></DataGrid.Columns></DataGrid><TextBlock Text="Objetos olvidados en custodia" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock x:Name="LostPropertyText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
  </Grid>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Revisión de consistencia operativa" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Consulta de solo lectura; no corrige datos automáticamente." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,6"/><ItemsControl x:Name="DiagnosticsList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="DiagnosticsEmpty" Text="No se detectaron diferencias con los registros consultados." Foreground="{StaticResource Success}" Visibility="Collapsed" Margin="3"/></StackPanel></Border>
  <TextBlock x:Name="LimitationText" Foreground="{StaticResource Warning}" FontSize="11" Margin="6,7,6,2" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</UserControl>



