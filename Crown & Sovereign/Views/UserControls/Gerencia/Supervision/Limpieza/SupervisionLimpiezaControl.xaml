<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.SupervisionLimpiezaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Supervisión de limpieza" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Consulta tareas e inspecciones registradas. La preparación no modifica la operación." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3"/><UniformGrid Columns="5" Margin="0,6"><Border Background="White" Padding="8" Margin="3"><StackPanel><TextBlock Text="Programadas" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ScheduledText" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="8" Margin="3"><StackPanel><TextBlock Text="Completadas" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CompletedText" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="8" Margin="3"><StackPanel><TextBlock Text="En ejecución" Foreground="{StaticResource Muted}"/><TextBlock x:Name="InProgressText" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="8" Margin="3"><StackPanel><TextBlock Text="Pendientes" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PendingText" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="8" Margin="3"><StackPanel><TextBlock Text="Atención" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AttentionText" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid><WrapPanel><TextBox x:Name="SearchBox" Width="230" ToolTip="Buscar habitación o empleado" TextChanged="Filter_Changed"/><ComboBox x:Name="StateBox" Width="150" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos los estados" IsSelected="True"/><ComboBoxItem Content="Pendiente"/><ComboBoxItem Content="En progreso"/><ComboBoxItem Content="Completada"/><ComboBoxItem Content="Inspeccionada"/></ComboBox><ComboBox x:Name="FloorBox" Width="130" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos los pisos" IsSelected="True"/></ComboBox></WrapPanel></StackPanel>
  <TabControl Grid.Row="1" Margin="0,4,0,0"><TabItem Header="Tareas"><DataGrid x:Name="TaskGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Tarea" Binding="{Binding Tipo}" Width="*"/><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}" Width="90"/><DataGridTextColumn Header="Piso" Binding="{Binding Piso}" Width="55"/><DataGridTextColumn Header="Programada" Binding="{Binding Programada, StringFormat=dd/MM HH:mm}" Width="125"/><DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="140"/><DataGridTextColumn Header="Prioridad" Binding="{Binding Prioridad}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/><DataGridTextColumn Header="Revisión" Binding="{Binding Atencion}" Width="*"/><DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Carga de trabajo"><DataGrid x:Name="WorkloadGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Responsable (texto de muestra)" Binding="{Binding Responsable}" Width="*"/><DataGridTextColumn Header="Asignadas" Binding="{Binding Asignadas}" Width="100"/><DataGridTextColumn Header="Pendientes" Binding="{Binding Pendientes}" Width="100"/><DataGridTextColumn Header="En ejecución" Binding="{Binding EnCurso}" Width="110"/><DataGridTextColumn Header="Completadas" Binding="{Binding Completadas}" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Inspecciones"><DataGrid x:Name="InspectionGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}" Width="90"/><DataGridTextColumn Header="Tarea" Binding="{Binding TareaId}" Width="75"/><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}" Width="120"/><DataGridTextColumn Header="Observación" Binding="{Binding Observaciones}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Rendimiento"><ScrollViewer><StackPanel Margin="14"><TextBlock Text="Rendimiento histórico basado en tareas e inspecciones registradas" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PerformanceText" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="No se calcula duración ni productividad: el modelo local no conserva hora real de inicio/completado ni turnos de personal." Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,8"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>

