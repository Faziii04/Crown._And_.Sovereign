<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.Reportes.VistaPreviaReporteControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="White" Margin="0,0,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Padding="16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <StackPanel><TextBlock x:Name="TitleText" Text="Vista previa" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="MetaText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
  </Border>
  <ItemsControl x:Name="Kpis" Grid.Row="1" Margin="10,8">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><Border Margin="4" Padding="12" CornerRadius="7" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#F8FAFC"><StackPanel><TextBlock Text="{Binding Nombre}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Valor}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding Contexto}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TabControl Grid.Row="2" Margin="10,0,10,10">
   <TabItem Header="Resumen"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Distribución del reporte" FontSize="16" FontWeight="SemiBold"/><ItemsControl x:Name="ChartItems" Margin="0,10"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Etiqueta}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Height="16" Background="#E9EDF3" CornerRadius="4"><Border HorizontalAlignment="Left" Width="{Binding Ancho}" Background="{StaticResource Accent}" CornerRadius="4"/></Border><TextBlock Grid.Column="2" Text="{Binding Texto}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Comparación con periodo anterior" FontWeight="SemiBold" Margin="0,8,0,4"/><ItemsControl x:Name="CompareItems"/><TextBlock Text="Advertencias y límites" FontWeight="SemiBold" Margin="0,10,0,4"/><ItemsControl x:Name="WarningItems"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Detalle de datos"><DataGrid x:Name="DetailGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserSortColumns="True" EnableRowVirtualization="True"/></TabItem>
   <TabItem Header="Metodología"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock Text="Criterio de cálculo" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="MethodText" TextWrapping="Wrap" Margin="0,8,0,16"/><TextBlock Text="Filtros aplicados" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="FiltersText" TextWrapping="Wrap" Margin="0,8,0,16"/><TextBlock Text="Origen" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Los reportes son temporales y utilizan los datos disponibles al momento de generarlos. No modifican operaciones ni estados financieros." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>
