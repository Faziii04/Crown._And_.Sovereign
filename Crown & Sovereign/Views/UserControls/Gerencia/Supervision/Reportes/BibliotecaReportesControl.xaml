<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.Reportes.BibliotecaReportesControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{StaticResource Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
   <TextBox x:Name="SearchBox" Width="300" Margin="0,0,8,0" Padding="10,7" ToolTip="Buscar un reporte" TextChanged="Filter_Changed"/>
   <ComboBox x:Name="CategoryBox" Width="220" Padding="8,6" SelectionChanged="Filter_Changed"/>
   <TextBlock Text="Los resultados se calculan desde los registros disponibles." Margin="14,8,0,0" Foreground="{StaticResource Muted}"/>
  </WrapPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <ItemsControl x:Name="Cards">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Width="310" MinHeight="175" Margin="0,0,12,12" Padding="16" CornerRadius="9" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="{Binding Categoria}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Nombre}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Margin="0,9"><TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap"/><TextBlock Text="{Binding Alcance}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
       <Button Grid.Row="2" Content="Configurar reporte" HorizontalAlignment="Right" Padding="12,7" Click="Configure_Click"/>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </Grid>
</UserControl>
