<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.Reportes.ReportesRecientesControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock Text="Reportes generados durante esta sesión" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Disponibles mientras la aplicación siga abierta; no es un archivo histórico permanente." Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DataGrid x:Name="RecentGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Selection_Changed"><DataGrid.Columns><DataGridTextColumn Header="Reporte" Binding="{Binding Titulo}" Width="2*"/><DataGridTextColumn Header="Periodo" Binding="{Binding Periodo}" Width="*"/><DataGridTextColumn Header="Generado" Binding="{Binding Generado, StringFormat=dd/MM/yyyy HH:mm}" Width="170"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/></DataGrid.Columns></DataGrid>
   <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Consultar resultado" Padding="10,6" Margin="0,0,8,0" Click="Open_Click"/><Button Content="Reutilizar parámetros" Padding="10,6" Click="Reuse_Click"/></StackPanel>
  </Grid>
 </Grid>
</UserControl>
