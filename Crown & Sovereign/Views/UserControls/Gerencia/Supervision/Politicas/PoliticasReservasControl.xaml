<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.Politicas.PoliticasReservasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4">
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="Cancelación sin penalización" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FreeCancelValue" FontSize="25" FontWeight="SemiBold" Margin="0,6"/><TextBlock Text="El límite se calcula desde la hora estándar de check-in. En el límite exacto se considera dentro del plazo gratuito." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button Tag="reservation_cancel_hours" Content="Editar condición" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Edit_Click"/></StackPanel></Border>
  <UniformGrid Columns="2" Margin="0,12,0,0">
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Cancelación fuera del plazo" FontWeight="SemiBold"/><TextBlock x:Name="LateCancelValue" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="No hay penalización monetaria de alojamiento estructurada." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Button Tag="reservation_cancel_conditions" Content="Editar condición informativa" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Edit_Click"/></StackPanel></Border>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="No presentación" FontWeight="SemiBold"/><TextBlock x:Name="NoShowValue" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="Una llegada pasada no se toma automáticamente como inasistencia." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Button Tag="reservation_noshow" Content="Editar condición informativa" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Edit_Click"/></StackPanel></Border>
  </UniformGrid>
  <Button Content="Simular cancelación" HorizontalAlignment="Left" Padding="12,7" Margin="0,14,0,0" Click="Simulate_Click"/>
  <TextBlock Text="Las reservas no conservan una fotografía completa de la política aceptada. Evita aplicar cambios actuales retroactivamente sin revisión." TextWrapping="Wrap" Foreground="#B45309" Margin="0,12,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
