<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.Politicas.PoliticasPagosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4">
  <TextBlock Text="Pagos y garantías" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <UniformGrid Columns="2">
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,8"><StackPanel><TextBlock Text="Anticipos" FontWeight="SemiBold"/><TextBlock x:Name="AdvanceValue" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="Política informativa; no registra pagos ni calcula porcentaje obligatorio." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Button Tag="advance" Content="Editar condiciones informativas" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Edit_Click"/></StackPanel></Border>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,8"><StackPanel><TextBlock Text="Garantías de reserva" FontWeight="SemiBold"/><TextBlock x:Name="GuaranteeValue" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="No existe una regla estructurada con base y momento de cobro definidos." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Button Tag="guarantee" Content="Editar condiciones informativas" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Edit_Click"/></StackPanel></Border>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,8,0"><StackPanel><TextBlock Text="Liquidación de saldos" FontWeight="SemiBold"/><TextBlock x:Name="SettlementValue" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="El checkout valida el saldo usando FolioService." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Button Tag="settlement" Content="Editar información" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Edit_Click"/></StackPanel></Border>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,8,0,0"><StackPanel><TextBlock Text="Devoluciones y anulaciones" FontWeight="SemiBold"/><TextBlock Text="Requieren autorización de Gerencia y ejecución posterior mediante el flujo autorizado de caja." TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="Control financiero obligatorio · no editable" Foreground="{StaticResource Accent}"/><Button Content="Consultar autorizaciones" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Finance_Click"/></StackPanel></Border>
  </UniformGrid>
 </StackPanel></ScrollViewer>
</UserControl>
