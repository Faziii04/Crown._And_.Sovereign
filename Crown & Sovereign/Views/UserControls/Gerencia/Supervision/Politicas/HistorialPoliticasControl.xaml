<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.Politicas.HistorialPoliticasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Historial de cambios" FontSize="19" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,10"><TextBox x:Name="SearchBox" Width="210" Padding="8,6" ToolTip="Buscar política o valor" TextChanged="Filter_Changed"/><ComboBox x:Name="CategoryBox" Width="165" Margin="6,0" SelectionChanged="Filter_Changed"/><ComboBox x:Name="UserBox" Width="180" SelectionChanged="Filter_Changed"/><DatePicker x:Name="FromDate" Width="145" SelectedDateChanged="Filter_Changed"/><DatePicker x:Name="ToDate" Width="145" Margin="6,0,0,0" SelectedDateChanged="Filter_Changed"/></WrapPanel></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Selection_Changed"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="Política" Binding="{Binding Politica}" Width="*"/><DataGridTextColumn Header="Anterior" Binding="{Binding ValorAnterior}" Width="*"/><DataGridTextColumn Header="Nuevo" Binding="{Binding ValorNuevo}" Width="*"/><DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="*"/></DataGrid.Columns></DataGrid>
   <Border Grid.Column="2" Padding="14" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="Detalle del cambio" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="DetailText" Text="Selecciona un cambio para consultar sus valores." TextWrapping="Wrap" Margin="0,10"/><Button x:Name="RestoreButton" Content="Proponer restauración del valor anterior" HorizontalAlignment="Left" Padding="10,6" IsEnabled="False" Click="Restore_Click"/></StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>
