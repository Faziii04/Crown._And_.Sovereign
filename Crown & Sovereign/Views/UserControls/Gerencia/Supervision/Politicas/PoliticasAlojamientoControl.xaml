<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Supervision.Politicas.PoliticasAlojamientoControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4">
  <TextBlock Text="Horarios de alojamiento" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <UniformGrid Columns="2">
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,8"><StackPanel><TextBlock Text="Hora estándar de check-in" FontWeight="SemiBold"/><TextBlock x:Name="CheckInValue" FontSize="25" FontWeight="SemiBold" Margin="0,5"/><TextBlock Text="Referencia que muestra recepción. La preparación y disponibilidad se validan aparte." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button Tag="checkin" Content="Editar horario" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Edit_Click"/></StackPanel></Border>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,8"><StackPanel><TextBlock Text="Hora estándar de check-out" FontWeight="SemiBold"/><TextBlock x:Name="CheckOutValue" FontSize="25" FontWeight="SemiBold" Margin="0,5"/><TextBlock Text="Referencia de salida. Es independiente de la hora de check-in." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button Tag="checkout" Content="Editar horario" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Edit_Click"/></StackPanel></Border>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,8,0"><StackPanel><TextBlock Text="Ingreso anticipado" FontWeight="SemiBold"/><TextBlock x:Name="EarlyValue" TextWrapping="Wrap" Margin="0,5"/><TextBlock Text="Informativa · depende de disponibilidad y preparación." Foreground="{StaticResource Muted}"/><Button Tag="early" Content="Editar condición" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Edit_Click"/></StackPanel></Border>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,8,0,0"><StackPanel><TextBlock Text="Salida tardía" FontWeight="SemiBold"/><TextBlock x:Name="LateValue" TextWrapping="Wrap" Margin="0,5"/><TextBlock Text="Informativa · no garantiza disponibilidad ni define cargo." Foreground="{StaticResource Muted}"/><Button Tag="late" Content="Editar condición" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Edit_Click"/></StackPanel></Border>
  </UniformGrid>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Admisión de mascotas" FontWeight="SemiBold"/><TextBlock x:Name="PetsValue" TextWrapping="Wrap" Margin="0,5"/><TextBlock Text="Política informativa; no se asigna habitación adecuada automáticamente." Foreground="{StaticResource Muted}"/></StackPanel><Button Grid.Column="1" Tag="pets" Content="Editar política" VerticalAlignment="Center" Padding="12,7" Click="Edit_Click"/></Grid></Border>
 </StackPanel></ScrollViewer>
</UserControl>
