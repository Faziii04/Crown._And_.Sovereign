<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Dashboard.DashboardFinanzasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel><TextBlock Text="Ingresos por cargo registrado" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="TotalText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8"/><TextBlock Text="Importe por período" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/><ItemsControl x:Name="TrendList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Etiqueta}" VerticalAlignment="Center" FontSize="11"/><ProgressBar Grid.Column="1" Value="{Binding Ancho, Mode=OneWay}" Maximum="100" Height="10" VerticalAlignment="Center" Foreground="{StaticResource Primary}" Background="#E9EEF2"/><TextBlock Grid.Column="2" Text="{Binding Detalle}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Composición (suma igual al total)" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,3"/><ItemsControl x:Name="CategoryList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Monto, StringFormat=Bs {0:N2}}" HorizontalAlignment="Right" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding Porcentaje, StringFormat={}{0:N1}%}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="CashText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
</UserControl>
