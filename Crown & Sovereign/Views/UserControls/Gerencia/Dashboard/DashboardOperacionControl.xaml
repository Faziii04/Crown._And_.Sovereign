<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Dashboard.DashboardOperacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel><DockPanel><TextBlock Text="Operación de hoy" FontSize="16" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Supervisión" Style="{StaticResource SecondaryButton}" Padding="9,5" Click="Open_Click"/></DockPanel><TextBlock Text="Estado actual; independiente del período financiero. Selecciona un indicador para abrir su sección." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8"/><ItemsControl x:Name="MetricList"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Titulo}" Click="Metric_Click" Background="Transparent" BorderThickness="0" Padding="4,5" Margin="0,1" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Titulo}" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Valor}" FontWeight="SemiBold" Margin="6,0"/><TextBlock Grid.Column="2" Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Avisos para supervisión" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,4"/><ItemsControl x:Name="AlertList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F7F8FA" CornerRadius="4" Padding="8" Margin="0,3"><StackPanel><TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Detalle}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></UserControl>
