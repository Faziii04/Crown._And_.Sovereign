<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Dashboard.DashboardComercialControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel><TextBlock Text="Actividad comercial" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Volumen y vigencias; los costos de proveedor no representan pagos ni utilidad neta." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8"/><ItemsControl x:Name="MetricList"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Titulo}" Click="Metric_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Padding="6,5" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Titulo}" FontSize="12"/><TextBlock Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Valor}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Reservas registradas por canal" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,4"/><ItemsControl x:Name="ChannelList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Etiqueta}"/><TextBlock Grid.Column="1" Text="{Binding Valor}" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></UserControl>
