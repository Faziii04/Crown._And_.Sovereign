<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Dashboard.DashboardDecisionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel><DockPanel><TextBlock Text="Revisiones financieras pendientes" FontSize="16" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Abrir Finanzas" Style="{StaticResource SecondaryButton}" Padding="9,5" Click="Open_Click"/></DockPanel><TextBlock Text="Las solicitudes se revisan con sus detalles; aprobar no ejecuta el cobro o la devolución." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/><ItemsControl x:Name="DecisionList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Tipo}" FontWeight="SemiBold"/><TextBlock Text="{Binding Huesped}" FontSize="11"/><TextBlock Text="{Binding Motivo}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Monto, StringFormat='Bs {0:N2}'}" Foreground="{StaticResource Warning}" FontWeight="SemiBold" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="Revisar" VerticalAlignment="Center" Padding="8,5" Tag="{Binding}" Click="Review_Click" Style="{StaticResource SecondaryButton}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="EmptyText" Text="No hay solicitudes pendientes de revisión." Foreground="{StaticResource Muted}" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel></Border></UserControl>
