<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Dashboard.GerenciaDashboardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Panel ejecutivo" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Indicadores financieros y de operación · muestra del período actual." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
        <ItemsControl ItemsSource="{Binding Metricas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Valor}" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="Tendencia de ingresos" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Ingresos por mes · Bs" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,12"/><Canvas Height="235" ClipToBounds="True"><Rectangle Canvas.Left="42" Canvas.Top="20" Width="1" Height="175" Fill="{StaticResource Line}"/><Rectangle Canvas.Left="42" Canvas.Top="195" Width="500" Height="1" Fill="{StaticResource Line}"/><Rectangle Canvas.Left="42" Canvas.Top="65" Width="500" Height="1" Fill="#EEF2F6"/><Rectangle Canvas.Left="42" Canvas.Top="110" Width="500" Height="1" Fill="#EEF2F6"/><Rectangle Canvas.Left="42" Canvas.Top="155" Width="500" Height="1" Fill="#EEF2F6"/><Polyline Points="52,158 128,132 204,145 280,96 356,111 432,55 520,32" Stroke="#3E5974" StrokeThickness="3"/><TextBlock Canvas.Left="46" Canvas.Top="201" Text="May" Foreground="{StaticResource Muted}"/><TextBlock Canvas.Left="120" Canvas.Top="201" Text="Jun" Foreground="{StaticResource Muted}"/><TextBlock Canvas.Left="196" Canvas.Top="201" Text="Jul" Foreground="{StaticResource Muted}"/><TextBlock Canvas.Left="272" Canvas.Top="201" Text="Ago" Foreground="{StaticResource Muted}"/><TextBlock Canvas.Left="348" Canvas.Top="201" Text="Sep" Foreground="{StaticResource Muted}"/><TextBlock Canvas.Left="424" Canvas.Top="201" Text="Oct" Foreground="{StaticResource Muted}"/><TextBlock Canvas.Left="500" Canvas.Top="201" Text="Nov" Foreground="{StaticResource Muted}"/></Canvas></StackPanel></Border>
        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="Distribución de ingresos" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Por área · período actual" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,12"/><ItemsControl ItemsSource="{Binding Distribucion}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,7"><Grid><TextBlock Text="{Binding Nombre}"/><TextBlock Text="{Binding Monto}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid><ProgressBar Value="{Binding Porcentaje, Mode=OneWay}" Maximum="100" Height="8" Margin="0,5" Foreground="{StaticResource Primary}" Background="#E8EDF2"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Autorizaciones pendientes" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,8"/><ItemsControl ItemsSource="{Binding Autorizaciones}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Warning}" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid>
    </StackPanel></ScrollViewer>
</UserControl>
