<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Dashboard.GerenciaDashboardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dash="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,24">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Panel ejecutivo" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Seguimiento financiero, comercial y operativo" Foreground="{StaticResource Muted}" Margin="0,3,0,12"/></StackPanel><Button Grid.Column="1" Content="Ver reportes" Style="{StaticResource SecondaryButton}" Padding="16,8" VerticalAlignment="Top" Click="Reports_Click"/></Grid>
            <dash:DashboardPeriodoControl x:Name="PeriodFilter" PeriodChanged="PeriodFilter_PeriodChanged"/>
            <ItemsControl x:Name="MetricCards" Margin="-4,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="13" Margin="4"><StackPanel><TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Valor}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><dash:DashboardFinanzasControl x:Name="FinancialPanel" Margin="4"/><dash:DashboardDecisionesControl x:Name="DecisionPanel" Grid.Column="1" Margin="4" DecisionsRequested="DecisionPanel_DecisionsRequested"/></Grid>
            <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><dash:DashboardOperacionControl x:Name="OperationsPanel" Margin="4" ModuleRequested="OperationsPanel_ModuleRequested"/><dash:DashboardComercialControl x:Name="CommercialPanel" Grid.Column="1" Margin="4"/></Grid>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Contexto de los indicadores" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="NotesText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
