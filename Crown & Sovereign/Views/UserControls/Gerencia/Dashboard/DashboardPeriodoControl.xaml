<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Dashboard.DashboardPeriodoControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="4,0,4,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Período" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/><ComboBox x:Name="PeriodBox" Grid.Column="1" Height="30" SelectionChanged="PeriodBox_SelectionChanged"/><CheckBox x:Name="CompareBox" Grid.Column="2" Content="Comparar período anterior" IsChecked="True" VerticalAlignment="Center" Margin="12,0" Checked="CompareBox_Changed" Unchecked="CompareBox_Changed"/><DatePicker x:Name="FromPicker" Grid.Column="3" Width="125" Visibility="Collapsed" SelectedDateChanged="CustomDate_Changed"/><DatePicker x:Name="ToPicker" Grid.Column="4" Width="125" Margin="6,0,0,0" Visibility="Collapsed" SelectedDateChanged="CustomDate_Changed"/><TextBlock x:Name="RangeText" Grid.Column="5" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0"/><Button Grid.Column="6" Content="Actualizar" Style="{StaticResource SecondaryButton}" Padding="14,6" Click="Refresh_Click"/></Grid></Border>
</UserControl>
