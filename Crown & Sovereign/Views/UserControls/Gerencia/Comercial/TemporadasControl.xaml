<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.TemporadasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel><TextBlock Text="Periodos comerciales" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Las fechas usan intervalo [inicio, fin): la noche final pertenece al siguiente periodo." Foreground="{StaticResource Muted}"/></StackPanel><Button Content="＋ Crear temporada" DockPanel.Dock="Right" Click="New_Click"/></DockPanel><StackPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock Text="Cronología" FontWeight="SemiBold" Margin="2,0,0,5"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="Timeline"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Width="215" Height="90" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/><TextBlock Text="{Binding Estado}" Foreground="{StaticResource Primary}" FontSize="11"/><TextBlock Text="{Binding Desde, StringFormat=dd/MM/yyyy}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Hasta, StringFormat=dd/MM/yyyy}" Foreground="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel><DataGrid x:Name="SeasonsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Edit_Click"><DataGrid.Columns><DataGridTextColumn Header="Temporada" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Desde (incl.)" Binding="{Binding Desde, StringFormat=dd/MM/yyyy}" Width="150"/><DataGridTextColumn Header="Hasta (excl.)" Binding="{Binding Hasta, StringFormat=dd/MM/yyyy}" Width="150"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/><DataGridTextColumn Header="Configuraciones" Binding="{Binding Configuraciones}" Width="150"/><DataGridTemplateColumn Header="Acción" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Eliminar" Click="Delete_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></UserControl>
