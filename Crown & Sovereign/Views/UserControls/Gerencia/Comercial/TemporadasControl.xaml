<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.TemporadasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DataGrid x:Name="SeasonsGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Temporada" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Desde" Binding="{Binding Desde, StringFormat=dd/MM/yyyy}" Width="150"/><DataGridTextColumn Header="Hasta" Binding="{Binding Hasta, StringFormat=dd/MM/yyyy}" Width="150"/></DataGrid.Columns></DataGrid></UserControl>
