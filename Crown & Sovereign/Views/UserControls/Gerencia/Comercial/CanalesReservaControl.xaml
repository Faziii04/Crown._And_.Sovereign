<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.CanalesReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel><TextBlock Text="Canales de reserva" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="La comisión se presenta como estimación del canal y no modifica el importe cobrado al huésped." Foreground="{StaticResource Muted}"/></StackPanel><Button Content="＋ Agregar canal" DockPanel.Dock="Right" Click="Add_Click"/></DockPanel><DataGrid x:Name="ChannelsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Edit_Click"><DataGrid.Columns><DataGridTextColumn Header="Canal" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Comisión" Binding="{Binding Comision, StringFormat={}{0:N1}%}" Width="150"/><DataGridTextColumn Header="Precios específicos" Binding="{Binding Configuraciones}" Width="180"/></DataGrid.Columns></DataGrid></Grid></UserControl>
