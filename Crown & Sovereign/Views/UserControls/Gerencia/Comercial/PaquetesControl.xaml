<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DataGrid x:Name="PackagesGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Paquete" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*"/><DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=Bs {0:N2}}" Width="130"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="90"/></DataGrid.Columns></DataGrid></UserControl>
