<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromocionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:offer="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones" xmlns:package="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Paquetes" xmlns:sim="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Simulador">
 <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="24,16,24,10"><StackPanel><TextBlock Text="Paquetes y promociones" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="Configura ofertas adicionales, beneficios y descuentos del hotel." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="+ Nuevo paquete" Padding="14,8" Margin="0,0,8,0" Click="NewPackage_Click"/><Button Content="+ Nueva promoción" Padding="14,8" Margin="0,0,8,0" Click="NewPromotion_Click"/><Button Content="Simular oferta" Padding="14,8" Click="Simulate_Click"/></StackPanel></DockPanel>
  <offer:ResumenPaquetesPromocionesControl x:Name="Overview" Grid.Row="1" Margin="24,0,24,12"/>
  <TabControl x:Name="WorkspaceTabs" Grid.Row="2" Margin="24,0,24,20"><TabItem Header="Paquetes"><package:PaquetesControl x:Name="PackagesView"/></TabItem><TabItem Header="Promociones"><commercial:PromocionesControl xmlns:commercial="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Comercial" x:Name="PromotionsView"/></TabItem><TabItem Header="Simulador comercial"><sim:SimuladorComercialControl x:Name="SimulatorView"/></TabItem></TabControl>
 </Grid>
</UserControl>
