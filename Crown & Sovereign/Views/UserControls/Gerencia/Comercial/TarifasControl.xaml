<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.TarifasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><StackPanel><TextBlock Text="Matriz por habitación, temporada y canal" FontWeight="SemiBold"/><TextBlock Text="Las celdas indican precio configurado o tarifa base de respaldo." Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><ComboBox x:Name="ChannelFilter" Width="165" SelectionChanged="Filter_Changed"/><Button Content="Ajuste con vista previa" Style="{StaticResource SecondaryButton}" Click="Bulk_Click"/><Button Content="Copiar temporada" Style="{StaticResource SecondaryButton}" Click="Copy_Click"/></StackPanel></DockPanel><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White"><StackPanel MinWidth="720"><StackPanel Orientation="Horizontal" Background="#F1F5F9"><TextBlock Text="Tipo de habitación" Width="190" Padding="12,10" FontWeight="SemiBold"/><TextBlock Text="Tarifa base" Width="160" Padding="12,10" FontWeight="SemiBold"/><ItemsControl x:Name="SeasonHeaders"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="180" Margin="0,0,6,0"><TextBlock Text="{Binding Nombre}" Padding="10,4" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Desde, StringFormat=dd/MM/yyyy}" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><ItemsControl x:Name="MatrixRows"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Background="White"><Border Width="190" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12" VerticalAlignment="Stretch"><TextBlock Text="{Binding TipoHabitacion}" FontWeight="SemiBold" VerticalAlignment="Center"/></Border><Button Width="160" Margin="3" Style="{StaticResource SecondaryButton}" Click="EditBase_Click"><StackPanel><TextBlock Text="{Binding PrecioBase, StringFormat=Bs {0:N2}}" FontWeight="SemiBold"/><TextBlock Text="Base" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Button><ItemsControl ItemsSource="{Binding Temporadas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="180" Margin="3" Click="EditCell_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="#F1F5F9"/><Style.Triggers><DataTrigger Binding="{Binding EsConfigurado}" Value="True"><Setter Property="Background" Value="#E4F0EA"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="{Binding Precio, StringFormat=Bs {0:N2}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Estado}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer><TextBlock Grid.Row="2" Text="Selecciona un precio para configurarlo. Las noches sin temporada aplican la tarifa base." Foreground="{StaticResource Muted}" Margin="2,8,0,0"/></Grid></UserControl>
