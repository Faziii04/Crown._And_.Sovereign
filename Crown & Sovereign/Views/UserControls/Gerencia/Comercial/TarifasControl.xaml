<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.TarifasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Doble clic en una tarifa para actualizar el precio vigente." Foreground="{StaticResource Muted}" Margin="2,0,0,8"/><DataGrid x:Name="RatesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Edit_Click"><DataGrid.Columns><DataGridTextColumn Header="Tipo de habitación" Binding="{Binding TipoHabitacion}" Width="*"/><DataGridTextColumn Header="Temporada" Binding="{Binding Temporada}" Width="*"/><DataGridTextColumn Header="Tarifa por noche" Binding="{Binding Precio, StringFormat=Bs {0:N2}}" Width="160"/><DataGridTextColumn Header="Desde" Binding="{Binding Desde, StringFormat=dd/MM/yyyy}" Width="120"/><DataGridTextColumn Header="Hasta" Binding="{Binding Hasta, StringFormat=dd/MM/yyyy}" Width="120"/></DataGrid.Columns></DataGrid></Grid></UserControl>
