<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Simulador.ResumenEconomicoSimulacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Cotización simulada" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TotalText" Text="Bs 0,00" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Margin="0,3,0,12"/><TextBlock x:Name="WarningText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,0,0,8"/><Separator/><Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Alojamiento"/><TextBlock x:Name="LodgingText" Grid.Column="1"/><TextBlock Grid.Row="1" Text="Paquetes adicionales"/><TextBlock x:Name="PackagesText" Grid.Row="1" Grid.Column="1"/><TextBlock Grid.Row="2" Text="Recursos"/><TextBlock x:Name="ResourcesText" Grid.Row="2" Grid.Column="1"/><TextBlock Grid.Row="3" Text="Servicios adquiridos"/><TextBlock x:Name="ServicesText" Grid.Row="3" Grid.Column="1"/><TextBlock Grid.Row="4" Text="Descuento sobre alojamiento" Foreground="{StaticResource Success}"/><TextBlock x:Name="DiscountText" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource Success}"/><TextBlock Grid.Row="5" Text="Impuestos"/><TextBlock x:Name="TaxText" Grid.Row="5" Grid.Column="1"/></Grid><Separator/><TextBlock Text="Beneficios incluidos por el paquete" FontWeight="SemiBold" Margin="0,12,0,5"/><ItemsControl x:Name="IncludedBenefits"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Comparar sin paquete" HorizontalAlignment="Left" Padding="13,7" Margin="0,12,0,0" Click="Compare_Click"/><TextBlock x:Name="ComparisonText" TextWrapping="Wrap" Foreground="{StaticResource Information}" Margin="0,7,0,0"/><TextBlock Text="Esta simulación es orientativa. No registra huéspedes, pagos, reservas ni disponibilidad y no confirma la disponibilidad de proveedores externos." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></ScrollViewer></Border>
</UserControl>
