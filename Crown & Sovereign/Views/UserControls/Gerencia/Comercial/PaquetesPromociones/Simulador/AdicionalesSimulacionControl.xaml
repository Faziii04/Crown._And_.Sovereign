<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Simulador.AdicionalesSimulacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,10,0,0"><StackPanel><DockPanel><TextBlock Text="Compras adicionales" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Servicios cubiertos por paquete se excluyen" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="Servicios" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/><DataGrid x:Name="ServicesGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="155" Margin="0,5,0,0" CellEditEnding="Line_CellEditEnding"><DataGrid.Columns><DataGridCheckBoxColumn Header="Cotizar" Binding="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}" Width="58"/><DataGridTextColumn Header="Servicio" Binding="{Binding Nombre}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Bs" Binding="{Binding Precio, StringFormat=N2}" IsReadOnly="True" Width="75"/><DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="58"/></DataGrid.Columns></DataGrid><TextBlock Text="Recursos" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/><DataGrid x:Name="ResourcesGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="135" Margin="0,5,0,0" CellEditEnding="Line_CellEditEnding"><DataGrid.Columns><DataGridCheckBoxColumn Header="Cotizar" Binding="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}" Width="58"/><DataGridTextColumn Header="Recurso" Binding="{Binding Nombre}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Bs" Binding="{Binding Precio, StringFormat=N2}" IsReadOnly="True" Width="75"/><DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="58"/></DataGrid.Columns></DataGrid></StackPanel></Border>
</UserControl>
