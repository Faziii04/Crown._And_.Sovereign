<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Simulador.DatosSimulacionComercialControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13"><StackPanel><TextBlock Text="Fechas y alojamiento" FontWeight="SemiBold" FontSize="16"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,6,8"><TextBlock Text="Entrada" Foreground="{StaticResource Muted}"/><DatePicker x:Name="ArrivalPicker" SelectedDateChanged="Dates_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,8"><TextBlock Text="Salida" Foreground="{StaticResource Muted}"/><DatePicker x:Name="DeparturePicker" SelectedDateChanged="Dates_Changed"/></StackPanel><StackPanel Grid.Row="1" Margin="0,0,6,0"><TextBlock Text="Tipo de habitación" Foreground="{StaticResource Muted}"/><ComboBox x:Name="RoomTypePicker" SelectionChanged="RoomType_Changed"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Canal" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ChannelPicker" SelectionChanged="Channel_Changed"/></StackPanel></Grid><DockPanel Margin="0,10,0,5"><TextBlock Text="Habitaciones disponibles · selecciona las que deseas cotizar" FontWeight="SemiBold"/><TextBlock x:Name="RoomSelectionText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/></DockPanel><ListBox x:Name="AvailableRooms" Height="130" SelectionMode="Extended" SelectionChanged="Selection_Changed" BorderBrush="{StaticResource Line}"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2"><TextBlock Text="{Binding Numero}" FontWeight="SemiBold"/><TextBlock Text="{Binding Tipo}" Margin="10,0"/><TextBlock Text="{Binding Capacidad, StringFormat=Capacidad {0}}" Foreground="{StaticResource Muted}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,10,0,0"><StackPanel><TextBlock Text="Oferta comercial" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Paquete adicional" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/><DockPanel><ComboBox x:Name="PackagePicker" DisplayMemberPath="Nombre" SelectionChanged="Package_Changed"/><Button Content="Quitar" Click="ClearPackage_Click" Margin="6,0,0,0" Padding="8,4"/></DockPanel><DockPanel Margin="0,7,0,0"><TextBlock Text="Cantidad de paquetes (1–5)" VerticalAlignment="Center"/><ComboBox x:Name="PackageQuantity" Width="85" HorizontalAlignment="Right" SelectionChanged="Selection_Changed"/></DockPanel><TextBlock Text="Promoción para la llegada seleccionada" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><DockPanel><ComboBox x:Name="PromotionPicker" SelectionChanged="Selection_Changed"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Nombre}"/><TextBlock Text=" · "/><TextBlock Text="{Binding Valor, StringFormat=N0}"/><TextBlock Text=" · "/><TextBlock Text="{Binding TipoDescuento}"/><TextBlock Text=" · solo prototipo" Foreground="{StaticResource Warning}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TipoDescuento}" Value="Noches"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Quitar" Click="ClearPromotion_Click" Margin="6,0,0,0" Padding="8,4"/></DockPanel><TextBlock Text="Una promoción por reserva. El descuento se calcula sobre el alojamiento; no reduce paquete, servicios ni recursos." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
 </StackPanel>
</UserControl>
