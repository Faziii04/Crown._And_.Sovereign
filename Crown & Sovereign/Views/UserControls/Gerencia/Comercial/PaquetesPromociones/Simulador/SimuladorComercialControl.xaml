<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Simulador.SimuladorComercialControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sim="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Simulador">
 <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12"><TextBlock Text="Simulador comercial" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Cotiza alojamiento, paquetes, promociones y adicionales con la misma calculadora de reservas. No se crean reservas ni se bloquean habitaciones." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0"><StackPanel><sim:DatosSimulacionComercialControl x:Name="Datos"/><sim:AdicionalesSimulacionControl x:Name="Adicionales"/></StackPanel></ScrollViewer>
  <sim:ResumenEconomicoSimulacionControl x:Name="Resumen" Grid.Column="1" Grid.Row="1" Margin="12,0,0,0"/>
 </Grid>
</UserControl>
