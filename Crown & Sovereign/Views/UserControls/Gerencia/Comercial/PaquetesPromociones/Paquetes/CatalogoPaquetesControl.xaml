<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Paquetes.CatalogoPaquetesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBox x:Name="SearchBox" MinWidth="220" ToolTip="Buscar paquetes" TextChanged="Search_TextChanged"/><ComboBox x:Name="StatusPicker" Width="145" Margin="8,0,0,0" SelectionChanged="Search_TextChanged"><ComboBoxItem Content="Todos" IsSelected="True"/><ComboBoxItem Content="Disponibles"/><ComboBoxItem Content="En revisión"/></ComboBox></DockPanel>
  <ListBox x:Name="PackagesList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="Packages_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#EEF2F6" CornerRadius="7" Width="68" Height="62"><Grid><Image Source="{Binding ImagenUrl}" Stretch="UniformToFill"/><TextBlock Text="◇" FontSize="26" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Paquete.Nombre}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Paquete.Descripcion}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Beneficios}" Foreground="{StaticResource Success}" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding PrecioTexto}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Primary}" HorizontalAlignment="Right"/><TextBlock Text="Precio adicional" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="{Binding EstadoPersistencia}" Foreground="{StaticResource Warning}" FontSize="10" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="110"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
 </Grid>
</UserControl>
