<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Paquetes.DetallePaqueteControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Eliminar" Padding="12,7" Margin="0,0,6,0" Click="Delete_Click"/><Button Content="Editar paquete" Padding="16,7" Click="Edit_Click"/></StackPanel><TextBlock x:Name="Heading" Text="Detalle del paquete" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
  <TabControl Grid.Row="1"><TabItem Header="Información"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><Grid Height="160"><Image x:Name="PackageImage" Stretch="UniformToFill"/><Border x:Name="ImagePlaceholder" Background="#E9EEF3" CornerRadius="8"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◇" FontSize="38" Foreground="{StaticResource Primary}" HorizontalAlignment="Center"/><TextBlock Text="Sin imagen del paquete" Foreground="{StaticResource Muted}"/></StackPanel></Border></Grid><TextBlock x:Name="Description" TextWrapping="Wrap" FontSize="14" Margin="0,15,0,14"/><WrapPanel><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10"><StackPanel><TextBlock x:Name="Price" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/><TextBlock Text="Precio adicional al alojamiento" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10"><StackPanel><TextBlock x:Name="BenefitCount" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="beneficios configurados" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,10"><StackPanel><TextBlock x:Name="ReservationCount" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="reservas asociadas · sin ingreso recalculado" Foreground="{StaticResource Muted}"/></StackPanel></Border></WrapPanel><TextBlock x:Name="PrototypeNote" Text="Activo/inactivo y alcance compartido son reglas del prototipo; paquete y paquete_servicio no tienen columnas para esos campos en el esquema suministrado." TextWrapping="Wrap" Foreground="{StaticResource Warning}" Margin="0,8,0,0"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Beneficios"><ScrollViewer><ItemsControl x:Name="BenefitsList" Margin="12"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,8"><StackPanel><DockPanel><TextBlock Text="{Binding Servicio}" FontWeight="SemiBold" FontSize="15"/><TextBlock DockPanel.Dock="Right" Text="{Binding Cobertura}" Foreground="{StaticResource Success}"/></DockPanel><TextBlock Text="{Binding UsosTexto}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock Text="{Binding Productos}" Foreground="{StaticResource Information}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding Proveedor}" Foreground="{StaticResource Warning}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
   <TabItem Header="Imágenes"><StackPanel Margin="16"><TextBlock Text="Imágenes registradas" FontSize="17" FontWeight="SemiBold"/><ItemsControl x:Name="ImagesList" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Url}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Administra las URLs al editar el paquete. La tabla paquete_imagen permite varias imágenes y un orden principal." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></TabItem>
   <TabItem Header="Rendimiento"><StackPanel Margin="16"><TextBlock Text="Uso comercial" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PerformanceText" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="No se estima ingreso histórico multiplicando el precio actual: las compras conservan el precio acordado y este resumen solo cuenta asociaciones disponibles en el prototipo." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></TabItem>
  </TabControl>
 </Grid>
</UserControl>
