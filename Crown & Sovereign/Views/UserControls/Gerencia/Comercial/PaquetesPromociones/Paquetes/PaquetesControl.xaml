<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Paquetes.PaquetesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pkg="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.Paquetes">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="+ Nuevo paquete" Padding="16,8" Click="New_Click"/><StackPanel><TextBlock Text="Paquetes comerciales" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Servicios y experiencias adicionales al precio del alojamiento." Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><pkg:CatalogoPaquetesControl x:Name="Catalog" Margin="0,0,12,0"/><pkg:DetallePaqueteControl x:Name="Details" Grid.Column="1" Margin="12,0,0,0"/>
   <Border x:Name="EmptyState" Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="26" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◇" FontSize="34" Foreground="{StaticResource Primary}" HorizontalAlignment="Center"/><TextBlock Text="Todavía no existen paquetes comerciales" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Crea una oferta para vender servicios y beneficios adicionales durante la estancia." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" Margin="0,5,0,12"/><Button Content="Crear paquete" Padding="16,8" Click="New_Click" HorizontalAlignment="Center"/></StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>
