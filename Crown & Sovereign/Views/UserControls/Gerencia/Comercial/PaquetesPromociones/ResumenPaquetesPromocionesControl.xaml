<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PaquetesPromociones.ResumenPaquetesPromocionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UniformGrid Columns="4"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="Paquetes disponibles" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PackagesCount" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Estado de activación solo prototipo" Foreground="{StaticResource Warning}" FontSize="11"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="4,0"><StackPanel><TextBlock Text="Promociones vigentes" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PromotionsCount" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Activas y dentro de fechas" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="4,0"><StackPanel><TextBlock Text="Próximos vencimientos" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ExpiringCount" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="En los siguientes 30 días" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="8,0,0,0"><StackPanel><TextBlock Text="Requieren revisión" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ReviewCount" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Sin beneficios o regla no disponible" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border></UniformGrid>
</UserControl>
