<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.TarifasTemporadasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sales="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Comercial">
 <Grid Background="{StaticResource Canvas}" Margin="24,16,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel><StackPanel><TextBlock Text="Tarifas y temporadas" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Precios de alojamiento por habitación, periodo y canal de reserva" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top"><Button Content="＋ Nueva temporada" Click="NewSeason_Click"/><Button Content="Simular reserva" Style="{StaticResource SecondaryButton}" Click="OpenSimulator_Click"/></StackPanel></DockPanel>
  <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,4"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Temporada actual" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CurrentSeason" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Próxima temporada" Foreground="{StaticResource Muted}"/><TextBlock x:Name="NextSeason" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Precios configurados" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ConfiguredCount" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12"><StackPanel><TextBlock Text="Pendientes de revisión" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ReviewCount" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid>
  <TabControl x:Name="WorkspaceTabs" Grid.Row="2"><TabItem Header="Matriz de tarifas"><sales:TarifasControl x:Name="RatesView"/></TabItem><TabItem Header="Temporadas"><sales:TemporadasControl x:Name="SeasonsView"/></TabItem><TabItem Header="Canales"><sales:CanalesReservaControl x:Name="ChannelsView"/></TabItem><TabItem Header="Simulador"><sales:SimuladorTarifasControl/></TabItem></TabControl>
 </Grid>
</UserControl>
