<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.Convenios.RendimientoControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Rendimiento" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Los servicios adquiridos atribuyen su precio unitario sin repetir el cargo. Los beneficios de paquetes no reparten su precio entre servicios. Los costos no son pagos ni utilidad neta." Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><DatePicker x:Name="StartDate" Grid.Column="1" VerticalAlignment="Center" Margin="8,0" SelectedDateChanged="Period_Changed"/><DatePicker x:Name="EndDate" Grid.Column="2" VerticalAlignment="Center" Margin="8,0" SelectedDateChanged="Period_Changed"/><ComboBox x:Name="ProviderFilter" Grid.Column="3" Width="200" VerticalAlignment="Center" SelectionChanged="Provider_Changed"/></Grid>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,7,0"><StackPanel><TextBlock Text="Utilizaciones registradas" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UsageCount" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="7,0"><StackPanel><TextBlock Text="Ingreso atribuible por uso" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PriceTotal" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="7,0"><StackPanel><TextBlock Text="Costos asociados registrados" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CostTotal" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="7,0,0,0"><StackPanel><TextBlock Text="Contribución estimada registrada" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MarginTotal" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/></StackPanel></Border></UniformGrid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Solicitudes externas pendientes" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PendingText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="Costos asociados por cobertura completada" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CoverageCostText" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Grid></Border>
        <Grid Grid.Row="3"><DataGrid x:Name="UsageGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="115"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Cobertura}" Width="125"/><DataGridTextColumn Header="Ingreso atribuible" Binding="{Binding PrecioTexto}" Width="125"/><DataGridTextColumn Header="Costo proveedor" Binding="{Binding CostoTexto}" Width="125"/><DataGridTextColumn Header="Contribución" Binding="{Binding MargenTexto}" Width="125"/><DataGridTextColumn Header="Reserva" Binding="{Binding ReservaId}" Width="85"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyState" Text="Todavía no se han registrado utilizaciones mediante convenios en este periodo." Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="36" Visibility="Collapsed"/></Grid>
    </Grid>
</UserControl>
