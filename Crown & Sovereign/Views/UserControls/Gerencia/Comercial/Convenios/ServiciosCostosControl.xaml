<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.Convenios.ServiciosCostosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Servicios y costos" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Compara proveedores vigentes para un mismo servicio. El costo no cambia el precio oficial del huésped." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Elegibilidad para" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="DateFilter" SelectedDateChanged="Date_Changed"/></StackPanel></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.34*" MinWidth="240"/><ColumnDefinition Width="0.66*" MinWidth="420"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Catálogo del hotel" FontWeight="SemiBold" FontSize="16"/><TextBox x:Name="SearchBox" Margin="0,8,0,10" ToolTip="Buscar servicio o categoría" TextChanged="Search_Changed"/></StackPanel><ListBox x:Name="ServicesList" Grid.Row="1" BorderThickness="0" SelectionChanged="Service_Changed"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="9"><StackPanel><TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/><TextBlock Text="{Binding Categoria}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Precio, StringFormat=Precio oficial · Bs {0:N2}}" Foreground="{StaticResource Primary}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="SelectedServiceTitle" Text="Selecciona un servicio" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SelectedServiceDescription" Text="Elige un servicio para comparar sus proveedores asociados." Foreground="{StaticResource Muted}" Margin="0,3,0,10" TextWrapping="Wrap"/></StackPanel><Grid Grid.Row="1" Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ProvidersSummary" Foreground="{StaticResource Information}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Margen = precio aplicado − costo del proveedor" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid><Grid Grid.Row="2"><DataGrid x:Name="ProvidersGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Proveedor · convenio" Binding="{Binding EmpresaConvenio}" Width="*"/><DataGridTextColumn Header="Vigencia" Binding="{Binding Vigencia}" Width="145"/><DataGridTextColumn Header="Precio huésped" Binding="{Binding PrecioOficial, StringFormat=Bs {0:N2}}" Width="115"/><DataGridTextColumn Header="Costo proveedor" Binding="{Binding Relacion.CostoProveedor, StringFormat=Bs {0:N2}}" Width="115"/><DataGridTextColumn Header="Margen estimado" Binding="{Binding MargenEstimado, StringFormat=Bs {0:N2}}" Width="125"/><DataGridTextColumn Header="Margen %" Binding="{Binding PorcentajeMargen, StringFormat={}{0:N2}%}" Width="85"/><DataGridTextColumn Header="Condiciones" Binding="{Binding Relacion.Observaciones}" Width="*"/><DataGridTemplateColumn Header="Acciones" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Editar" Tag="{Binding Convenio.Id}" Click="EditAgreement_Click" Style="{StaticResource SecondaryButton}" Padding="7,3"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock x:Name="NoProviders" Text="No existen proveedores elegibles para este servicio en la fecha seleccionada." Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="36" Visibility="Collapsed"/></Grid></Grid></Border>
        </Grid>
    </Grid>
</UserControl>
