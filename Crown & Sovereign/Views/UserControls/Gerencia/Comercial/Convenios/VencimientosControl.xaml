<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.Convenios.VencimientosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Vencimientos y renovaciones" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Revisa los acuerdos próximos a vencer y sus servicios afectados antes de iniciar una renovación." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="Horizonte" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="HorizonBox" Width="110" SelectionChanged="Filter_Changed"/></StackPanel><ComboBox x:Name="StatusBox" Grid.Column="2" Width="150" VerticalAlignment="Center" SelectionChanged="Filter_Changed"/></Grid>
        <Grid Grid.Row="1"><DataGrid x:Name="AgreementsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Empresa" Binding="{Binding Convenio.Empresa}" Width="*"/><DataGridTextColumn Header="Convenio" Binding="{Binding Convenio.Nombre}" Width="*"/><DataGridTextColumn Header="Servicios" Binding="{Binding ServiciosActivos}" Width="80"/><DataGridTextColumn Header="Vigencia hasta" Binding="{Binding Convenio.VigenciaHasta, StringFormat=dd/MM/yyyy}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding EstadoVigencia}" Width="120"/><DataGridTextColumn Header="Solicitudes activas" Binding="{Binding SolicitudesPendientes}" Width="120"/><DataGridTextColumn Header="Atención" Binding="{Binding Advertencia}" Width="*"/><DataGridTemplateColumn Header="Acciones" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Ver" Tag="{Binding Convenio.Id}" Click="Detail_Click" Padding="8,4"/><Button Content="Renovar" Tag="{Binding Convenio.Id}" Click="Renew_Click" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyState" Text="No hay vencimientos que coincidan con el horizonte seleccionado." Foreground="{StaticResource Muted}" TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
    </Grid>
</UserControl>
