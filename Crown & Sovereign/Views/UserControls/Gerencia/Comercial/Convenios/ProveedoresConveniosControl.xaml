<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.Convenios.ProveedoresConveniosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cards="clr-namespace:Crown___Sovereign.Views.UserControls.Shared.Cards">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="Proveedores y convenios" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Busca los acuerdos externos, consulta su vigencia y administra los servicios asociados." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,8,7" ToolTip="Empresa, convenio, servicio o contacto" TextChanged="Filter_Changed"/>
            <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="0,0,8,7" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="StatusBox" Grid.Column="2" Margin="0,0,8,7" SelectionChanged="Filter_Changed"/>
            <StackPanel Grid.Column="3" Margin="4,0,12,7"><CheckBox x:Name="HasServices" Content="Con servicios" Checked="Filter_Changed" Unchecked="Filter_Changed"/><CheckBox x:Name="NeedsReview" Content="Requieren revisión" Margin="0,4,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/></StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Tarjetas" Style="{StaticResource SecondaryButton}" Padding="10,4" Click="Cards_Click"/><Button Content="Listado" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="4,0,0,0" Click="List_Click"/></StackPanel>
            <TextBlock x:Name="ResultsText" Grid.Row="1" Grid.ColumnSpan="3" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Todos" Tag="Todos" Style="{StaticResource SecondaryButton}" Padding="9,4" Click="QuickStatus_Click"/><Button Content="Vigentes" Tag="Vigente" Style="{StaticResource SecondaryButton}" Padding="9,4" Margin="4,0,0,0" Click="QuickStatus_Click"/><Button Content="Por vencer" Tag="Por vencer" Style="{StaticResource SecondaryButton}" Padding="9,4" Margin="4,0,0,0" Click="QuickStatus_Click"/><Button Content="Vencidos" Tag="Vencido" Style="{StaticResource SecondaryButton}" Padding="9,4" Margin="4,0,0,0" Click="QuickStatus_Click"/></StackPanel>
        </Grid>
        <Grid Grid.Row="2"><Grid x:Name="CardsPanel"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="AgreementCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><cards:ConvenioCardControl DataContext="{Binding}" DetailRequested="Card_DetailRequested" EditRequested="Card_EditRequested"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="CardsEmpty" Text="Todavía no existen convenios con proveedores externos. Registra un convenio para ampliar la oferta de servicios del hotel." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="36" Visibility="Collapsed"/></Grid>
            <Grid x:Name="TablePanel" Visibility="Collapsed"><DataGrid x:Name="AgreementGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Empresa" Binding="{Binding Convenio.Empresa}" Width="*"/><DataGridTextColumn Header="Convenio" Binding="{Binding Convenio.Nombre}" Width="*"/><DataGridTextColumn Header="Proveedor" Binding="{Binding Convenio.Categoria}" Width="125"/><DataGridTextColumn Header="Servicios" Binding="{Binding ServiciosActivos}" Width="85"/><DataGridTextColumn Header="Desde" Binding="{Binding Convenio.VigenciaDesde, StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="Hasta" Binding="{Binding Convenio.VigenciaHasta, StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding EstadoVigencia}" Width="105"/><DataGridTemplateColumn Header="Acciones" Width="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Ver" Tag="{Binding Convenio.Id}" Click="Grid_Detail_Click" Padding="7,3"/><Button Content="Editar" Tag="{Binding Convenio.Id}" Click="Grid_Edit_Click" Style="{StaticResource SecondaryButton}" Padding="7,3" Margin="4,0,0,0"/><Button Content="Renovar" Tag="{Binding Convenio.Id}" Click="Grid_Renew_Click" Style="{StaticResource SecondaryButton}" Padding="7,3" Margin="4,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock x:Name="TableEmpty" Text="No hay convenios para estos filtros." TextAlignment="Center" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
        </Grid>
    </Grid>
</UserControl>
