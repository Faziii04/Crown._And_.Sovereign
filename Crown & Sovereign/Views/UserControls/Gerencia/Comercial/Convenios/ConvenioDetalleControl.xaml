<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.Convenios.ConvenioDetalleControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><Button Content="← Volver a convenios" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="Back_Click"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Editar convenio" Padding="12,5" Click="Edit_Click"/><Button x:Name="RenewButton" Content="Renovar" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="6,0,0,0" Click="Renew_Click"/><Button x:Name="StateButton" Content="Desactivar" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="6,0,0,0" Click="State_Click"/></StackPanel></DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="58" Height="58" CornerRadius="9" Background="#EEF3F7"><TextBlock x:Name="Initials" FontSize="20" Foreground="{StaticResource Primary}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock x:Name="CompanyText" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="NameText" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CategoryText" Foreground="{StaticResource Information}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="2" CornerRadius="12" Padding="11,6" Background="#E8F3EE" VerticalAlignment="Top"><TextBlock x:Name="StatusText" FontWeight="SemiBold"/></Border></Grid>
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="Vigencia" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PeriodText" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="6,0"><StackPanel><TextBlock Text="Servicios asociados" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ServiceCount" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="6,0"><StackPanel><TextBlock Text="Utilizaciones" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UsageCount" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="6,0,0,0"><StackPanel><TextBlock Text="Costos de proveedor registrados" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CostTotal" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border></UniformGrid>
        <TabControl x:Name="DetailTabs" Grid.Row="3"><TabItem Header="Servicios asociados"><Grid Margin="12"><Grid><DataGrid x:Name="ServicesGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio.Nombre}" Width="*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Servicio.Categoria}" Width="130"/><DataGridTextColumn Header="Precio oficial huésped" Binding="{Binding PrecioOficial, StringFormat=Bs {0:N2}}" Width="150"/><DataGridTextColumn Header="Costo proveedor" Binding="{Binding Relacion.CostoProveedor, StringFormat=Bs {0:N2}}" Width="130"/><DataGridTextColumn Header="Margen estimado" Binding="{Binding MargenEstimado, StringFormat=Bs {0:N2}}" Width="135"/><DataGridTextColumn Header="Estado" Binding="{Binding EstadoMargen}" Width="130"/><DataGridTextColumn Header="Condiciones" Binding="{Binding Relacion.Observaciones}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="ServicesEmpty" Text="Este convenio todavía no tiene servicios asociados." Foreground="{StaticResource Muted}" TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Grid></TabItem>
            <TabItem Header="Información y contacto"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="18" MaxWidth="760" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Empresa" FontWeight="SemiBold"/><TextBlock x:Name="InfoCompany" Grid.Column="1"/><TextBlock Grid.Row="1" Text="Contacto" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="InfoContact" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Text="Teléfono" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="InfoPhone" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Text="Correo" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="InfoEmail" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"/><TextBlock Grid.Row="4" Text="Dirección" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="InfoAddress" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Grid.Row="5" Text="Descripción" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="InfoDescription" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Grid.Row="6" Text="Convenio" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="InfoName" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" TextWrapping="Wrap"/></Grid></ScrollViewer></TabItem>
            <TabItem Header="Condiciones comerciales"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="800" HorizontalAlignment="Left"><TextBlock Text="Condiciones generales" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="TermsText" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Las condiciones específicas y costos se consultan en Servicios asociados. Los cambios actuales no reconstruyen versiones históricas del convenio." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Historial operativo"><Grid Margin="12"><DataGrid x:Name="UsageGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Cobertura}" Width="130"/><DataGridTextColumn Header="Precio aplicado" Binding="{Binding PrecioTexto}" Width="125"/><DataGridTextColumn Header="Costo aplicado" Binding="{Binding CostoTexto}" Width="125"/><DataGridTextColumn Header="Contribución" Binding="{Binding MargenTexto}" Width="125"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="115"/></DataGrid.Columns></DataGrid><TextBlock x:Name="HistoryEmpty" Text="Todavía no se han registrado servicios mediante este convenio." Foreground="{StaticResource Muted}" TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></TabItem>
        </TabControl>
    </Grid>
</UserControl>
