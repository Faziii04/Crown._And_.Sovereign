<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PromocionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DataGrid x:Name="PromotionsGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Promoción" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding TipoDescuento}" Width="*"/><DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="100"/><DataGridTextColumn Header="Desde" Binding="{Binding Desde, StringFormat=dd/MM/yyyy}" Width="130"/><DataGridTextColumn Header="Hasta" Binding="{Binding Hasta, StringFormat=dd/MM/yyyy}" Width="130"/></DataGrid.Columns></DataGrid></UserControl>
