<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.PromocionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="+ Nueva promoción" Padding="16,8" Click="New_Click"/><StackPanel><TextBlock Text="Campañas promocionales" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Descuentos porcentuales aplicables al alojamiento según fecha de llegada." Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="SearchBox" Width="260" HorizontalAlignment="Left" ToolTip="Buscar promoción" TextChanged="Filter_Changed"/><ComboBox x:Name="StatusFilter" Width="150" Margin="8,0,0,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todas" IsSelected="True"/><ComboBoxItem Content="Vigentes"/><ComboBoxItem Content="Próximas"/><ComboBoxItem Content="Finalizadas"/><ComboBoxItem Content="Inactivas"/></ComboBox><ComboBox x:Name="TypeFilter" Width="175" Margin="8,0,0,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Todos los tipos" IsSelected="True"/><ComboBoxItem Content="Porcentaje"/><ComboBoxItem Content="Prototipo"/></ComboBox><TextBlock Text="Un descuento por reserva · no acumulable" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
  <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PromotionCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="380" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,12,12"><StackPanel><DockPanel><TextBlock Text="{Binding Promocion.Nombre}" FontSize="16" FontWeight="SemiBold"/><Border DockPanel.Dock="Right" Background="#EEF3F7" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding EstadoVista}" FontSize="11" Foreground="{StaticResource Primary}"/></Border></DockPanel><TextBlock Text="{Binding ImporteTexto}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Margin="0,10,0,0"/><TextBlock Text="{Binding Alcance}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Periodo}" Margin="0,10,0,0"/><Border Background="#FFF5E8" CornerRadius="5" Padding="8" Margin="0,8,0,0" Visibility="{Binding EsPrototipo, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Regla solo del prototipo · Noches no se almacena como tipo de descuento." Foreground="#8C632E" TextWrapping="Wrap" FontSize="12"/></Border><DockPanel Margin="0,13,0,0"><TextBlock Text="{Binding AccionEstado}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Editar" Tag="{Binding Promocion.Id}" Click="Edit_Click" IsEnabled="{Binding PuedeEditar}" Padding="10,5" Margin="0,0,6,0"/><Button Content="Cambiar estado" Tag="{Binding Promocion.Id}" Click="Toggle_Click" Padding="10,5" Margin="0,0,6,0"/><Button Content="Eliminar" Tag="{Binding Promocion.Id}" Click="Delete_Click" Padding="10,5"/></StackPanel></DockPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><Border x:Name="PromotionEmpty" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="26" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Todavía no hay promociones para este filtro." FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Crea una campaña porcentual o cambia el estado del filtro." Foreground="{StaticResource Muted}" Margin="0,5,0,12"/><Button Content="Crear promoción" Click="New_Click" Padding="14,7" HorizontalAlignment="Center"/></StackPanel></Border></Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0"><DockPanel><TextBlock Text="CALENDARIO DE CAMPAÑAS · PRÓXIMOS 4 MESES" FontWeight="SemiBold" Foreground="{StaticResource Ink}" DockPanel.Dock="Top" Margin="0,0,0,8"/><ItemsControl x:Name="Timeline"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="190" Background="#F7F9FB" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding Mes}" FontWeight="SemiBold"/><TextBlock Text="{Binding Resumen}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/><ProgressBar Value="{Binding Intensidad}" Maximum="100" Height="5" Margin="0,7,0,0" Foreground="{StaticResource Primary}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border>
 </Grid>
</UserControl>
