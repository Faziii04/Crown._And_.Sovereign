<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.SimuladorTarifasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Simular alojamiento" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="La simulación no crea una reserva ni consulta disponibilidad." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="Llegada"/><DatePicker x:Name="Arrival" SelectedDateChanged="Input_Changed"/><TextBlock Text="Salida (excluida del cobro)" Margin="0,8,0,0"/><DatePicker x:Name="Departure" SelectedDateChanged="Input_Changed"/><TextBlock Text="Tipos de habitación (una habitación de cada tipo)" Margin="0,8,0,0"/><ListBox x:Name="RoomTypes" SelectionMode="Multiple" Height="112" SelectionChanged="Input_Changed"/><TextBlock Text="Canal de reserva" Margin="0,8,0,0"/><ComboBox x:Name="Channel" DisplayMemberPath="Nombre" SelectionChanged="Input_Changed"/><Button Content="Calcular simulación" Margin="0,14,0,0" Click="Calculate_Click"/></StackPanel></Border><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="Desglose por noche y tipo de habitación" FontSize="17" FontWeight="SemiBold"/><DataGrid x:Name="Breakdown" Margin="0,8,0,0" Height="195" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Habitación" Binding="{Binding TipoHabitacion}" Width="*"/><DataGridTextColumn Header="Noche" Binding="{Binding Fecha, StringFormat=ddd dd/MM}" Width="*"/><DataGridTextColumn Header="Temporada" Binding="{Binding Temporada}" Width="*"/><DataGridTextColumn Header="Origen del precio" Binding="{Binding Origen}" Width="*"/><DataGridTextColumn Header="Importe" Binding="{Binding Precio, StringFormat=Bs {0:N2}}" Width="120"/></DataGrid.Columns></DataGrid></StackPanel></Border><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel><TextBlock Text="Comparación de canales" FontSize="17" FontWeight="SemiBold"/><DataGrid x:Name="Comparison" Margin="0,8,0,0" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Canal" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Alojamiento" Binding="{Binding Alojamiento, StringFormat=Bs {0:N2}}" Width="140"/><DataGridTextColumn Header="Comisión estimada" Binding="{Binding Comision, StringFormat=Bs {0:N2}}" Width="150"/><DataGridTextColumn Header="Después de comisión" Binding="{Binding Neto, StringFormat=Bs {0:N2}}" Width="150"/></DataGrid.Columns></DataGrid><TextBlock x:Name="Explanation" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><TextBlock x:Name="Total" Grid.Row="2" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,10,0,0"/></Grid></Grid></UserControl>
