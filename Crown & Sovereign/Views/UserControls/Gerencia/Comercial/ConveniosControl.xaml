<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.ConveniosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="24,18"><TextBlock Text="Convenios" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Acuerdos corporativos y de distribución" Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel><DataGrid x:Name="AgreementsGrid" Grid.Row="1" Margin="24,0,24,20" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" Width="*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*"/><DataGridTextColumn Header="Vigencia desde" Binding="{Binding VigenciaDesde, StringFormat=dd/MM/yyyy}" Width="150"/><DataGridTextColumn Header="Vigencia hasta" Binding="{Binding VigenciaHasta, StringFormat=dd/MM/yyyy}" Width="150"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="90"/></DataGrid.Columns></DataGrid></Grid></UserControl>
