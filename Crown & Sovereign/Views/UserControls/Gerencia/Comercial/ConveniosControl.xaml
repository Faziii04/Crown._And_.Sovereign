<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Comercial.ConveniosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:workspace="clr-namespace:Crown___Sovereign.Views.UserControls.Gerencia.Comercial.Convenios">
    <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Convenios y proveedores" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Gestiona acuerdos comerciales con proveedores externos de servicios." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="＋ Nuevo convenio" VerticalAlignment="Center" Padding="15,8" Click="New_Click"/></Grid></Border>
        <UniformGrid Grid.Row="1" Columns="4" Margin="22,12,22,8">
            <Button Tag="vigentes" Click="Metric_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="Convenios vigentes" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ActiveCount" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Activos y dentro de vigencia" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Button>
            <Button Tag="servicios" Click="Metric_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Padding="12" Margin="6,0"><StackPanel><TextBlock Text="Servicios externos" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ExternalServicesCount" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Servicios distintos con proveedor vigente" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Button>
            <Button Tag="vencimientos" Click="Metric_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Padding="12" Margin="6,0"><StackPanel><TextBlock Text="Próximos vencimientos" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ExpiringCount" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Dentro de los próximos 90 días" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Button>
            <Button Tag="revision" Click="Metric_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Padding="12" Margin="6,0,0,0"><StackPanel><TextBlock Text="Requieren revisión" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ReviewCount" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Condiciones comerciales por revisar" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Button>
        </UniformGrid>
        <Grid Grid.Row="2" Margin="22,0,22,16"><TabControl x:Name="WorkspaceTabs"><TabItem Header="Proveedores y convenios"><workspace:ProveedoresConveniosControl x:Name="ProvidersView" DetailRequested="DetailRequested" EditRequested="EditRequested" RenewRequested="RenewRequested" CatalogChanged="CatalogChanged"/></TabItem><TabItem Header="Servicios y costos"><workspace:ServiciosCostosControl x:Name="CostsView" EditAgreementRequested="EditRequested"/></TabItem><TabItem Header="Vencimientos"><workspace:VencimientosControl x:Name="ExpirationsView" DetailRequested="DetailRequested" RenewRequested="RenewRequested"/></TabItem><TabItem Header="Rendimiento"><workspace:RendimientoControl x:Name="PerformanceView"/></TabItem></TabControl><ContentControl x:Name="DetailHost" Visibility="Collapsed"/></Grid>
    </Grid>
</UserControl>
