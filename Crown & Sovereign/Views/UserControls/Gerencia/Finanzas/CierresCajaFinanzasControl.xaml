<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Finanzas.CierresCajaFinanzasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8"><StackPanel><TextBlock Text="Turnos y cierres de caja" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Consulta por turno: el efectivo esperado incluye fondo inicial, cobros en efectivo y devoluciones ejecutadas en efectivo." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel><WrapPanel DockPanel.Dock="Right"><TextBox x:Name="SearchBox" Width="175" Margin="4" ToolTip="Buscar turno o cajero" TextChanged="Filter_Changed"/><ComboBox x:Name="StateBox" Width="125" Margin="4" SelectionChanged="Filter_Changed"/></WrapPanel></DockPanel>
        <DataGrid x:Name="ShiftGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Shift_SelectionChanged">
            <DataGrid.Columns><DataGridTextColumn Header="Turno" Binding="{Binding Shift.Id, StringFormat=#{0}}" Width="65"/><DataGridTextColumn Header="Cajero" Binding="{Binding Cashier}" Width="145"/><DataGridTextColumn Header="Apertura" Binding="{Binding Opened, StringFormat=dd/MM/yy HH:mm}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="85"/><DataGridTextColumn Header="Efectivo esperado" Binding="{Binding CashExpected, StringFormat='Bs {0:N2}'}" Width="135"/><DataGridTextColumn Header="No efectivo" Binding="{Binding NonCashCollections, StringFormat='Bs {0:N2}'}" Width="110"/><DataGridTextColumn Header="Contado" Binding="{Binding Counted, StringFormat='Bs {0:N2}'}" Width="110"/><DataGridTextColumn Header="Diferencia" Binding="{Binding Variance, StringFormat='Bs {0:N2}'}" Width="110"/><DataGridTextColumn Header="Revisión" Binding="{Binding ClosureState}" Width="105"/></DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,8,0,0" Height="168">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><DockPanel><TextBlock x:Name="SelectedTitle" Text="Selecciona un turno para consultar el detalle." FontWeight="SemiBold" TextWrapping="Wrap"/><Button x:Name="ReviewButton" DockPanel.Dock="Right" Content="Revisar cierre" Style="{StaticResource PrimaryButton}" Padding="9,5" IsEnabled="False" Click="Review_Click"/></DockPanel><TextBlock x:Name="SelectedDetails" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"/></StackPanel>
                <DataGrid x:Name="CashMovementsGrid" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Hora" Binding="{Binding Fecha, StringFormat=dd/MM HH:mm}" Width="90"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="80"/><DataGridTextColumn Header="Medio" Binding="{Binding Metodo}" Width="85"/><DataGridTextColumn Header="Importe" Binding="{Binding Monto, StringFormat='Bs {0:N2}'}" Width="90"/><DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*" MinWidth="90"/></DataGrid.Columns></DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
