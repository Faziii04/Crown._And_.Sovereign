<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Finanzas.FacturacionFinancieraControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DataGrid x:Name="InvoicesGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="150"/><DataGridTextColumn Header="Folio" Binding="{Binding FolioId}" Width="100"/><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="140"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=Bs {0:N2}}" Width="140"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/></DataGrid.Columns></DataGrid></UserControl>
