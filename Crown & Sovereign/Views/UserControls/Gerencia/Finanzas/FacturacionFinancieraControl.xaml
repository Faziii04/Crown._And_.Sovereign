<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Finanzas.FacturacionFinancieraControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10,8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8"><StackPanel><TextBlock Text="Facturas y notas de crédito" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="La factura documenta cargos; no representa por sí sola un cobro." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel><TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="210" Margin="4" ToolTip="Buscar número, folio o cliente" TextChanged="Search_Changed"/></DockPanel>
        <DataGrid x:Name="InvoiceGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Invoice_SelectionChanged">
            <DataGrid.Columns><DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="135"/><DataGridTextColumn Header="Cliente histórico" Binding="{Binding Guest}" Width="*" MinWidth="145"/><DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="80"/><DataGridTextColumn Header="Contexto" Binding="{Binding Context}" Width="125"/><DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yy}" Width="95"/><DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='Bs {0:N2}'}" Width="105"/><DataGridTextColumn Header="Impuesto" Binding="{Binding Tax, StringFormat='Bs {0:N2}'}" Width="100"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='Bs {0:N2}'}" Width="105"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="85"/></DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,4,0"><StackPanel><TextBlock Text="Detalle histórico de factura" FontWeight="SemiBold"/><TextBlock x:Name="InvoiceDetail" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5"/><ItemsControl x:Name="InvoiceLines"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Concepto, StringFormat='• {0}'}" FontSize="11"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="4,0,0,0"><StackPanel><DockPanel><TextBlock Text="Notas de crédito asociadas" FontWeight="SemiBold"/><TextBlock x:Name="CreditNetText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/></DockPanel><DataGrid x:Name="CreditGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,4,0,0"><DataGrid.Columns><DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="95"/><DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yy}" Width="85"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat='Bs {0:N2}'}" Width="105"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
