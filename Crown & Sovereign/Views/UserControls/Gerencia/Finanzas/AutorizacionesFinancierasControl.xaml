<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Finanzas.AutorizacionesFinancierasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8"><StackPanel><TextBlock Text="Autorizaciones financieras" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="La aprobación o el rechazo queda separado de la ejecución de caja." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel><ComboBox x:Name="StateBox" DockPanel.Dock="Right" Width="160" SelectionChanged="State_Changed"/></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="260"/><ColumnDefinition Width="1.15*" MinWidth="310"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,5,0"><ListBox x:Name="RequestsList" BorderThickness="0" SelectionChanged="Request_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Tipo}" FontWeight="SemiBold"/><TextBlock Text="{Binding Huesped}" FontSize="11"/><TextBlock Text="{Binding Motivo}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Fecha, StringFormat=Solicitada dd/MM/yyyy HH:mm}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Estado}" HorizontalAlignment="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding Monto, StringFormat='Bs {0:N2}'}" Foreground="{StaticResource Warning}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="5,0,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock x:Name="EmptyText" Text="Selecciona una solicitud para revisar el huésped, pago, folio, motivo y efecto financiero." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,3,0,12"/>
                            <UniformGrid Columns="2"><StackPanel Margin="0,3"><TextBlock Text="Huésped" Foreground="{StaticResource Muted}"/><TextBlock x:Name="GuestText" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="0,3"><TextBlock Text="Pago original" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PaymentText" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="0,3"><TextBlock Text="Folio" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FolioText" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="0,3"><TextBlock Text="Solicitó" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RequesterText" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="0,3"><TextBlock Text="Autorizó" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ApproverText" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="0,3"><TextBlock Text="Fecha de solicitud" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DateText" FontWeight="SemiBold"/></StackPanel></UniformGrid>
                            <Border Background="#F4F6F8" CornerRadius="4" Padding="10" Margin="0,10,0,8"><StackPanel><TextBlock Text="Motivo informado" FontWeight="SemiBold"/><TextBlock x:Name="ReasonText" TextWrapping="Wrap" Margin="0,3"/><TextBlock x:Name="DescriptionText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
                            <TextBlock Text="Impacto previsto" FontWeight="SemiBold"/><TextBlock x:Name="ImpactText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,3,0,8"/>
                            <TextBlock x:Name="LifecycleText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel></ScrollViewer>
                    <DockPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock x:Name="ActionStatus" Foreground="{StaticResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="RejectButton" Content="Rechazar" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,0" Click="Reject_Click" IsEnabled="False"/><Button x:Name="ApproveButton" Content="Aprobar" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="Approve_Click" IsEnabled="False"/></StackPanel></DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
