<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Finanzas.SaldosPendientesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10,8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8" LastChildFill="False">
            <StackPanel><TextBlock Text="Saldos por folio" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Condición financiera actual, incluidos anticipos de reservas sin check-in." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
            <WrapPanel DockPanel.Dock="Right"><TextBox x:Name="SearchBox" Width="210" Margin="4" ToolTip="Buscar huésped, folio o reserva" TextChanged="Filter_Changed"/><ComboBox x:Name="StateBox" Width="145" Margin="4" SelectionChanged="Filter_Changed"/></WrapPanel>
        </DockPanel>
        <DataGrid x:Name="BalanceGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Balance_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Folio" Binding="{Binding FolioId, StringFormat=#{0}}" Width="75"/>
                <DataGridTextColumn Header="Huésped" Binding="{Binding Guest}" Width="170"/>
                <DataGridTextColumn Header="Contexto" Binding="{Binding Context}" Width="140"/>
                <DataGridTextColumn Header="Cargos" Binding="{Binding Charges, StringFormat='Bs {0:N2}'}" Width="120"/>
                <DataGridTextColumn Header="Cobros" Binding="{Binding Collections, StringFormat='Bs {0:N2}'}" Width="120"/>
                <DataGridTextColumn Header="Devoluciones" Binding="{Binding Refunds, StringFormat='Bs {0:N2}'}" Width="120"/>
                <DataGridTextColumn Header="Saldo actual" Binding="{Binding Balance, StringFormat='Bs {0:N2}'}" Width="130"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,8,0,0">
            <DockPanel><Button x:Name="MovementsButton" DockPanel.Dock="Right" Content="Ver movimientos del folio" Style="{StaticResource SecondaryButton}" Padding="10,6" IsEnabled="False" Click="OpenMovements_Click"/><StackPanel Orientation="Horizontal"><TextBlock Text="Detalle seleccionado · " FontWeight="SemiBold"/><TextBlock x:Name="SelectionText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></DockPanel>
        </Border>
    </Grid>
</UserControl>
