<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Finanzas.MovimientosFinancierosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10,8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left"><TextBlock Text="Movimientos financieros" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Cargos, cobros y correcciones ejecutadas, cada uno en su fecha real." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="210" Margin="4" ToolTip="Buscar huésped, folio, concepto o referencia" TextChanged="Filter_Changed"/>
                <ComboBox x:Name="KindBox" Width="145" Margin="4" SelectionChanged="Filter_Changed"/>
            </WrapPanel>
        </DockPanel>
        <DataGrid x:Name="MovementGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yy HH:mm}" Width="112"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="95"/>
                <DataGridTextColumn Header="Huésped" Binding="{Binding Guest}" Width="155"/>
                <DataGridTextColumn Header="Folio" Binding="{Binding FolioId, StringFormat=#{0}}" Width="75"/>
                <DataGridTextColumn Header="Concepto" Binding="{Binding Concept}" Width="*" MinWidth="140"/>
                <DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat='Bs {0:N2}'}" Width="120"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="112"/>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate><DataTemplate><Border Background="#F4F6F8" Padding="10"><WrapPanel><TextBlock Text="Medio: " FontWeight="SemiBold"/><TextBlock Text="{Binding Method}" Margin="0,0,18,0"/><TextBlock Text="Referencia: " FontWeight="SemiBold"/><TextBlock Text="{Binding SourceId, StringFormat=#{0}}" Margin="0,0,18,0"/><TextBlock Text="Contexto: " FontWeight="SemiBold"/><TextBlock Text="{Binding Context}"/></WrapPanel></Border></DataTemplate></DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</UserControl>
