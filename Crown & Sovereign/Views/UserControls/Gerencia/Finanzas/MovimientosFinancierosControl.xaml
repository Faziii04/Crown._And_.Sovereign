<UserControl x:Class="Crown___Sovereign.Views.UserControls.Gerencia.Finanzas.MovimientosFinancierosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DataGrid x:Name="LedgerGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/><DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="2*"/><DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=Bs {0:N2}}" Width="130"/><DataGridTextColumn Header="Medio" Binding="{Binding Medio}" Width="140"/></DataGrid.Columns></DataGrid></UserControl>
