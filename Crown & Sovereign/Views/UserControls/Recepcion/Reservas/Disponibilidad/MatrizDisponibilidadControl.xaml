<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Disponibilidad.MatrizDisponibilidadControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel><TextBlock Text="Disponibilidad por noche" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Las cantidades son por noche; la búsqueda superior valida habitaciones libres durante toda la estancia." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><DatePicker x:Name="StartDatePicker" SelectedDateChanged="Date_Changed"/><Button Content="‹" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="Previous_Click"/><Button Content="Hoy" Style="{StaticResource SecondaryButton}" Click="Today_Click"/><Button Content="›" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="Next_Click"/><ComboBox x:Name="HorizonBox" Width="95" SelectionChanged="Horizon_Changed"/></StackPanel></DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel><Grid Background="#F1F5F9"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Tipo de habitación" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="9"/><ItemsControl Grid.Column="1" ItemsSource="{Binding Fechas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="76" Padding="7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><TextBlock Text="{Binding Label}" TextAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid><ItemsControl ItemsSource="{Binding Lineas}"><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RoomType}" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold"/><ItemsControl Grid.Column="1" ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="76" MinHeight="40" Margin="1" Padding="3" CornerRadius="3" Cursor="Hand" Tag="{Binding DataContext.RoomType, RelativeSource={RelativeSource AncestorType=Grid}}" MouseLeftButtonDown="Cell_Click" ToolTip="Doble clic para iniciar una reserva con esta fecha y tipo"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E3EEE8"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="Limitada"><Setter Property="Background" Value="#F4E9D6"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="Sin disponibilidad"><Setter Property="Background" Value="#F3DDDD"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Available}" TextAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="{Binding Total, StringFormat='de {0}'}" TextAlignment="Center" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border>
        <DockPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock x:Name="SelectionText" Text="Selecciona una fecha para consultar habitaciones." VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"/><Button x:Name="ReserveCellButton" DockPanel.Dock="Right" Content="Reservar esta fecha" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="ReserveCell_Click"/></DockPanel>
    </Grid>
</UserControl>
