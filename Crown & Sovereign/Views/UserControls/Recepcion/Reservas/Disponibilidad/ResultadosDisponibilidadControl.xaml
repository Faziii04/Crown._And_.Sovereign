<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Disponibilidad.ResultadosDisponibilidadControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Resultados de disponibilidad" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SearchSummary" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="‹ Volver a matriz" Style="{StaticResource SecondaryButton}" Click="Back_Click"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid><ItemsControl x:Name="ResultsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Tipo}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Comodidades, StringFormat='Comodidades: {0}'}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding Comodidades}"/><TextBlock Text="{Binding Coincidentes, StringFormat={}{0} habitaciones disponibles durante toda la estancia}" Foreground="{StaticResource Success}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="8,0"><TextBlock Text="{Binding TarifaDesde, StringFormat='Desde Bs {0:N2} / noche'}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding TotalEstimado, StringFormat='Bs {0:N2} total estimado'}" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/></StackPanel><Button Grid.Column="2" Content="Ver habitaciones" VerticalAlignment="Center" Tag="{Binding}" Click="SelectRooms_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="EmptyText" Text="No encontramos habitaciones que cubran toda la estancia. Cambia las fechas, tipo o comodidades y vuelve a buscar." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="Collapsed"/></Grid></ScrollViewer></Grid>
</UserControl>
