<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Listado.ListadoReservasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><StackPanel><TextBlock Text="Listado de reservas" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Una bandeja operativa para llegadas, salidas y reservas en curso." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="＋ Nueva reserva" Click="NewReservation_Click"/></DockPanel>
  <Grid Grid.Row="1" Margin="0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><UniformGrid x:Name="QuickFilters" Columns="6"><Button Content="Todas" Tag="Todas" Click="QuickFilter_Click" Margin="0,0,4,0"/><Button Content="Llegadas de hoy" Tag="Llegadas de hoy" Click="QuickFilter_Click" Margin="0,0,4,0"/><Button Content="Salidas de hoy" Tag="Salidas de hoy" Click="QuickFilter_Click" Margin="0,0,4,0"/><Button Content="Pendientes" Tag="Pendientes" Click="QuickFilter_Click" Margin="0,0,4,0"/><Button Content="En estancia" Tag="En estancia" Click="QuickFilter_Click" Margin="0,0,4,0"/><Button Content="Próximas" Tag="Próximas" Click="QuickFilter_Click"/></UniformGrid><WrapPanel Grid.Row="1" Margin="0,10,0,0"><TextBox x:Name="SearchBox" Width="260" ToolTip="Huésped, reserva o canal" TextChanged="Filter_Changed"/><ComboBox x:Name="StatusFilter" Width="165" Margin="8,0" SelectionChanged="Status_Changed"/><ComboBox x:Name="ChannelFilter" Width="145" SelectionChanged="Status_Changed"/><ComboBox x:Name="TypeFilter" Width="150" SelectionChanged="Status_Changed"/><CheckBox x:Name="GroupsOnly" Content="Solo grupos" VerticalAlignment="Center" Margin="10,0" Checked="Check_Changed" Unchecked="Check_Changed"/></WrapPanel><Expander Grid.Row="2" Header="Filtros por fechas y piso" Margin="0,8,0,0"><WrapPanel Margin="0,8"><StackPanel Margin="0,0,10,0"><TextBlock Text="Llegada desde" FontSize="10"/><DatePicker x:Name="ArrivalFrom" SelectedDateChanged="Status_Changed"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="Llegada hasta" FontSize="10"/><DatePicker x:Name="ArrivalTo" SelectedDateChanged="Status_Changed"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="Salida desde" FontSize="10"/><DatePicker x:Name="DepartureFrom" SelectedDateChanged="Status_Changed"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="Salida hasta" FontSize="10"/><DatePicker x:Name="DepartureTo" SelectedDateChanged="Status_Changed"/></StackPanel><StackPanel><TextBlock Text="Piso" FontSize="10"/><ComboBox x:Name="FloorFilter" Width="140" SelectionChanged="Status_Changed"/></StackPanel></WrapPanel></Expander></Grid>
  <DataGrid x:Name="ReservationGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Reservation_DoubleClick"><DataGrid.Columns>
   <DataGridTextColumn Header="Reserva" Binding="{Binding Id, StringFormat=\# {0}}" Width="80"/><DataGridTextColumn Header="Huésped" Binding="{Binding Guest}" Width="2*"/><DataGridTextColumn Header="Habitación" Binding="{Binding Room}" Width="130"/><DataGridTextColumn Header="Llegada" Binding="{Binding Arrival, StringFormat=dd/MM/yyyy}" Width="105"/><DataGridTextColumn Header="Salida" Binding="{Binding Departure, StringFormat=dd/MM/yyyy}" Width="105"/><DataGridTextColumn Header="Huéspedes" Binding="{Binding Guests}" Width="85"/><DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100"/>
   <DataGridTemplateColumn Header="Importe" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EstimatedTotal, StringFormat=Bs {0:N2}}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="Acción" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding PrimaryAction}" Tag="{Binding}" Click="PrimaryAction_Click" Padding="8,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid>
  <DockPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock x:Name="CountLabel" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PreviousPage" Content="‹ Anterior" Style="{StaticResource SecondaryButton}" Click="Previous_Click"/><TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="NextPage" Content="Siguiente ›" Style="{StaticResource SecondaryButton}" Click="Next_Click"/></StackPanel></DockPanel>
 </Grid>
</UserControl>
