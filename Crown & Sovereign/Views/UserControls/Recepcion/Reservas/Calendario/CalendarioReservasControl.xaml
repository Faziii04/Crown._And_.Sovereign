<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Calendario.CalendarioReservasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><StackPanel><TextBlock Text="Calendario por habitación" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="La barra continua muestra la duración de cada reserva." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/><TextBlock x:Name="QuickPreviewText" Foreground="{StaticResource Information}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/></StackPanel><Button DockPanel.Dock="Right" Content="＋ Nueva reserva" Click="NewReservation_Click"/></DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,12,0,8" VerticalAlignment="Center">
            <DatePicker x:Name="StartDatePicker" SelectedDateChanged="Filter_Changed" Margin="0,0,6,5"/>
            <ComboBox x:Name="FloorFilter" SelectionChanged="Filter_Changed" MinWidth="120" Margin="0,0,6,5"/>
            <ComboBox x:Name="TypeFilter" SelectionChanged="Filter_Changed" MinWidth="145" Margin="0,0,6,5"/>
            <ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed" MinWidth="150" Margin="0,0,6,5"/>
            <TextBox x:Name="RoomSearchBox" Width="155" ToolTip="Buscar habitación" TextChanged="Search_Changed" Margin="0,0,8,5"/>
            <CheckBox x:Name="OnlyAvailableBox" Content="Disponible toda la estancia" VerticalAlignment="Center" Checked="Availability_Changed" Unchecked="Availability_Changed" Margin="0,0,8,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><Button Content="7 días" Tag="7" Style="{StaticResource SecondaryButton}" Click="Horizon_Click"/><Button Content="14 días" Tag="14" Style="{StaticResource SecondaryButton}" Click="Horizon_Click"/><Button Content="30 días" Tag="30" Style="{StaticResource SecondaryButton}" Click="Horizon_Click"/></StackPanel>
        </WrapPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel>
                <StackPanel Orientation="Horizontal" Background="#F1F5F9"><Border Width="146" Padding="8"><TextBlock Text="Habitación · tipo" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/></Border><ItemsControl ItemsSource="{Binding Fechas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="82" Padding="4,7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><TextBlock Text="{Binding Label}" TextAlignment="Center" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                <ItemsControl ItemsSource="{Binding Habitaciones}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Height="54"><Border Width="146" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" Padding="8,6"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding RoomNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding RoomType}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding FloorLabel}" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel></Border><Grid Width="{Binding CalendarWidth}" Height="54"><ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="82" Height="54" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" Background="White" ToolTip="{Binding Detail}" Tag="{Binding}" MouseLeftButtonDown="EmptyCell_Click"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding Bars}" IsHitTestVisible="True"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="5"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Border Width="{Binding Width}" Height="42" CornerRadius="5" Padding="7,4" ToolTip="{Binding Tooltip}" Tag="{Binding}" Cursor="Hand" MouseLeftButtonDown="ReservationBar_Click"><Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"><MenuItem Header="Abrir acciones de la reserva" Tag="{Binding}" Click="ContextOpen_Click"/></ContextMenu></Border.ContextMenu><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#CBD5E1"/><Style.Triggers><DataTrigger Binding="{Binding Estado}" Value="Confirmada"><Setter Property="Background" Value="#D8E7F2"/></DataTrigger><DataTrigger Binding="{Binding Estado}" Value="En estancia"><Setter Property="Background" Value="#D8EBDD"/></DataTrigger><DataTrigger Binding="{Binding Estado}" Value="Pendiente"><Setter Property="Background" Value="#F2E7CF"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Huesped}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</UserControl>
