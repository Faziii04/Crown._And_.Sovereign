<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Grupos.GruposReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Reservas de grupo" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Consulta las habitaciones, huéspedes y llegadas asociadas a cada grupo." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,12"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Margin="0,0,12,0"><DockPanel><TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="10" ToolTip="Buscar grupo" TextChanged="Search_Changed"/><ListBox x:Name="GroupList" BorderThickness="0" SelectionChanged="Group_Changed"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12"><StackPanel><TextBlock Text="{Binding Grupo.Nombre}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Llegada, StringFormat=Desde {0:dd MMM yyyy}}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Estado}" Foreground="{StaticResource Information}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock x:Name="SelectedName" Text="Selecciona un grupo" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SelectedSummary" Foreground="{StaticResource Muted}" Margin="0,3,0,10"/></StackPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="AssignRoomButton" Content="Añadir habitación" Style="{StaticResource SecondaryButton}" Click="AssignRoom_Click" IsEnabled="False" Margin="0,0,7,0"/><Button x:Name="CreateReservationButton" Content="Nueva reserva del grupo" Click="CreateReservation_Click" IsEnabled="False"/><Button x:Name="AssignGuestButton" Content="Asignar huésped" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Click="AssignGuest_Click" IsEnabled="False"/></WrapPanel></DockPanel><UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12"><Border Background="White" Padding="10" Margin="2"><StackPanel><TextBlock Text="Huéspedes" Foreground="{StaticResource Muted}"/><TextBlock x:Name="GuestsCount" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="10" Margin="2"><StackPanel><TextBlock Text="Habitaciones" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RoomsCount" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="10" Margin="2"><StackPanel><TextBlock Text="Reservas" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ReservationsCount" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="10" Margin="2"><StackPanel><TextBlock Text="Llegadas registradas" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ArrivalsCount" FontSize="19" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid><DataGrid x:Name="GuestsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding Nombre}" Width="2*"/><DataGridTextColumn Header="Documento" Binding="{Binding Documento}" Width="*"/><DataGridTextColumn Header="Reserva" Binding="{Binding ReservaId}" Width="90"/><DataGridTextColumn Header="Habitación asignada" Binding="{Binding Habitacion}" Width="*"/><DataGridTemplateColumn Header="Acción" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Cambiar habitación" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Padding="6,4" Click="AssignGuest_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid>
  </Grid>
 </Grid>
</UserControl>
