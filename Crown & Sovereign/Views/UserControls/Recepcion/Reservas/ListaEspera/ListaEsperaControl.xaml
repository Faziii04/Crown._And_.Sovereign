<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.ListaEspera.ListaEsperaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="Lista de espera" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Oportunidades verificadas contra habitaciones disponibles durante toda la estancia." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="＋ Agregar solicitud" Click="AddRequest_Click"/></DockPanel>
  <DataGrid x:Name="WaitlistGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="2*"/><DataGridTextColumn Header="Llegada" Binding="{Binding Solicitud.Llegada, StringFormat=dd/MM/yyyy}" Width="110"/><DataGridTextColumn Header="Salida" Binding="{Binding Solicitud.Salida, StringFormat=dd/MM/yyyy}" Width="110"/><DataGridTextColumn Header="Tipo solicitado" Binding="{Binding Solicitud.TipoHabitacion}" Width="150"/><DataGridTextColumn Header="Disponibles" Binding="{Binding HabitacionesCoincidentes}" Width="95"/><DataGridTextColumn Header="Estado" Binding="{Binding Solicitud.Estado}" Width="120"/><DataGridTemplateColumn Header="Acciones" Width="320"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Registrar contacto" Tag="{Binding}" Click="Contact_Click" Padding="7,4"/><Button Content="Crear reserva" Tag="{Binding}" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="Convert_Click" Padding="7,4"/><Button Content="Cerrar" Tag="{Binding}" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="Close_Click" Padding="7,4"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
