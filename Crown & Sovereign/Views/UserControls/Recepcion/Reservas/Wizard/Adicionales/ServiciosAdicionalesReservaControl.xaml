<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Wizard.Adicionales.ServiciosAdicionalesReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Servicios adicionales adquiridos" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Compra sesiones antes del check-in. Las citas se programan durante la estancia; comprar no confirma un horario." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,9"/><WrapPanel><TextBox x:Name="SearchBox" Width="240" ToolTip="Buscar servicio" TextChanged="Filter_Changed"/><ComboBox x:Name="CategoryBox" Width="150" Margin="7,0,0,0" SelectionChanged="Filter_Changed"/><ComboBox x:Name="CoverageBox" Width="145" Margin="7,0,0,0" SelectionChanged="Filter_Changed"/></WrapPanel></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10"><Grid><ItemsControl x:Name="ServiceList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="4"><StackPanel>
    <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Categoria}" Foreground="{StaticResource Primary}" FontSize="11" Margin="0,2"/><TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" MinHeight="34"/><TextBlock Text="{Binding CoberturaTexto}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding CitaTexto}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding DuracionMinutos, StringFormat='Duración: {0} min'}" Foreground="{StaticResource Muted}" FontSize="11"/>
    <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="Destinatario (opcional)" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox Width="180" ItemsSource="{Binding Destinatarios}" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectedValue="{Binding HuespedId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Recipient_Changed"/></StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0"><TextBlock Text="Comprar sesiones adicionales" VerticalAlignment="Center" Margin="0,0,7,0"/><Button Content="−" Tag="{Binding}" Click="Decrease_Click" Style="{StaticResource SecondaryButton}" Padding="10,3"/><TextBlock Text="{Binding Cantidad}" MinWidth="30" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/><Button Content="+" Tag="{Binding}" Click="Increase_Click" Style="{StaticResource SecondaryButton}" Padding="10,3"/></StackPanel>
    <TextBlock Text="{Binding SubtotalTexto}" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" LostFocus="Observation_LostFocus" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36" MaxHeight="54" VerticalScrollBarVisibility="Auto" ToolTip="Preferencias para programar las sesiones"/>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="EmptyText" Text="No hay servicios que coincidan con estos filtros." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="4,0"><TextBlock x:Name="SelectedText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><DockPanel><TextBlock Text="Las citas se confirman por separado durante la estancia." Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="TotalText" DockPanel.Dock="Right" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel></StackPanel>
 </Grid>
</UserControl>
