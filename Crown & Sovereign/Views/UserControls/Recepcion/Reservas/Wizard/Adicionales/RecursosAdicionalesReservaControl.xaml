<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Wizard.Adicionales.RecursosAdicionalesReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Recursos adicionales" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Equipo y artículos reutilizables para toda la reserva. La cama adicional no cambia la capacidad autorizada." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,9"/><WrapPanel><TextBox x:Name="SearchBox" Width="250" ToolTip="Buscar recurso" TextChanged="Filter_Changed"/><ComboBox x:Name="CategoryBox" Width="170" Margin="8,0,0,0" SelectionChanged="Filter_Changed"/></WrapPanel></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10"><Grid><ItemsControl x:Name="ResourceList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="4"><StackPanel>
    <Border Height="46" Background="#F4F6F8" CornerRadius="4" Margin="0,0,0,6"><Grid><Image Source="{Binding Imagen}" Stretch="UniformToFill"/><TextBlock Text="Sin imagen de catálogo" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding TieneImagen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
    <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Tipo}" Foreground="{StaticResource Primary}" FontSize="11" Margin="0,2"/><TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" MinHeight="34"/>
    <TextBlock Text="{Binding DisponibilidadTexto}" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="{Binding DisponibilidadDetalle}" Foreground="{StaticResource Muted}" FontSize="11"/>
    <TextBlock Text="{Binding PrecioTexto}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Margin="0,7,0,0"/><TextBlock Text="Requiere preparación" Foreground="{StaticResource Muted}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RequierePreparacion}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,7,0,0"><TextBlock Text="Cantidad" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="−" Tag="{Binding}" Click="Decrease_Click" Style="{StaticResource SecondaryButton}" Padding="10,3"/><TextBlock Text="{Binding Cantidad}" MinWidth="30" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/><Button Content="+" Tag="{Binding}" Click="Increase_Click" Style="{StaticResource SecondaryButton}" Padding="10,3"/></StackPanel>
    <TextBlock Text="{Binding SubtotalTexto}" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" LostFocus="Observation_LostFocus" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="58" VerticalScrollBarVisibility="Auto" ToolTip="Indicaciones de preparación o entrega"/>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="EmptyText" Text="No se encontraron recursos. Ajusta la búsqueda o los filtros." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="4,0"><TextBlock x:Name="SelectedText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><DockPanel><TextBlock Text="Los recursos seleccionados se guardan asociados a la reserva." Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="TotalText" DockPanel.Dock="Right" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel></StackPanel>
 </Grid>
</UserControl>
