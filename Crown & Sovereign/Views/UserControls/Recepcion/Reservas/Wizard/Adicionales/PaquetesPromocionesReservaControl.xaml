<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Wizard.Adicionales.PaquetesPromocionesReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="Paquetes y promociones" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Selecciona las condiciones comerciales adquiridas para esta reserva. Los servicios incluidos no se cobran nuevamente." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16"/><TextBlock Text="Paquete" FontWeight="SemiBold"/><ComboBox x:Name="PackagePicker" SelectionChanged="Package_Changed"/><TextBlock x:Name="PackageDescription" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,8"/><TextBlock Text="Cantidad de paquetes" FontWeight="SemiBold"/><ComboBox x:Name="PackageQuantity" Width="110" HorizontalAlignment="Left" SelectionChanged="Package_Changed"/><TextBlock x:Name="PackagePrice" Foreground="{StaticResource Primary}" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="Promoción" FontWeight="SemiBold" Margin="0,22,0,0"/><ComboBox x:Name="PromotionPicker" DisplayMemberPath="Nombre" SelectionChanged="Package_Changed"/><TextBlock Text="Las promociones actuales solo se aplican a los conceptos que define la regla comercial (por ahora: alojamiento)." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7"/></StackPanel></ScrollViewer>
</UserControl>
