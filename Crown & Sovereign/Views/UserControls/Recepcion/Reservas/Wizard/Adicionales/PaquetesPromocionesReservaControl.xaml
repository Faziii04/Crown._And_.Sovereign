<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Wizard.Adicionales.PaquetesPromocionesReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="Paquetes y promociones" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Selecciona las condiciones comerciales adquiridas para esta reserva. El paquete se suma al alojamiento; sus beneficios no se cobran otra vez." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,16"/><TextBlock Text="Paquete" FontWeight="SemiBold"/><ComboBox x:Name="PackagePicker" SelectionChanged="Package_Changed"/><TextBlock x:Name="PackageDescription" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,8"/><TextBlock Text="Cantidad de paquetes" FontWeight="SemiBold"/><ComboBox x:Name="PackageQuantity" Width="110" HorizontalAlignment="Left" SelectionChanged="Package_Changed"/><TextBlock x:Name="PackagePrice" Foreground="{StaticResource Primary}" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="Promoción · una por reserva" FontWeight="SemiBold" Margin="0,22,0,0"/><ComboBox x:Name="PromotionPicker" SelectionChanged="Package_Changed"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Nombre}"/><TextBlock Text=" · "/><TextBlock Text="{Binding Valor, StringFormat=N0}"/><TextBlock Text=" · "/><TextBlock Text="{Binding TipoDescuento}"/><TextBlock Text=" · solo prototipo" Foreground="{StaticResource Warning}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TipoDescuento}" Value="Noches"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Los descuentos se aplican al alojamiento. La regla porcentual es compatible con el esquema; la promoción por noches está disponible solo en el prototipo." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7"/></StackPanel></ScrollViewer>
</UserControl>
