<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Wizard.Adicionales.SolicitudesEspecialesReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Solicitudes especiales" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Indicaciones informativas para el hotel. No generan cargos; selecciona recursos o servicios del catálogo para adquirir un extra." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel><TextBox x:Name="SpecialRequest" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MinHeight="140"/><TextBlock Grid.Row="2" Text="Ejemplo: preparar la habitación antes de las 14:00 o preferencia por una zona tranquila." Foreground="{StaticResource Muted}" Margin="0,8"/></Grid></UserControl>
