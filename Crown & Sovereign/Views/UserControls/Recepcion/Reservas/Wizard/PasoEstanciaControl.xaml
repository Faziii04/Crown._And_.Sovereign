<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Wizard.PasoEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel>
   <TextBlock Text="Llegada" FontWeight="SemiBold"/><DatePicker x:Name="ArrivalPicker"/>
   <TextBlock Text="Salida" FontWeight="SemiBold" Margin="0,14,0,0"/><DatePicker x:Name="DeparturePicker"/>
   <TextBlock Text="Personas que se alojarán" FontWeight="SemiBold" Margin="0,14,0,0"/>
   <TextBox x:Name="GuestCountBox" Text="1" Width="100" HorizontalAlignment="Left" Margin="0,5,0,0" ToolTip="Incluye a todos los huéspedes de la reserva"/>
   <TextBlock Text="Indica el total ahora. En el siguiente paso podrás añadir habitaciones si la capacidad no alcanza." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
   <TextBlock Text="Canal de reserva" FontWeight="SemiBold" Margin="0,14,0,0"/><ComboBox x:Name="ChannelPicker"/>
  </StackPanel>
  <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="Detalles de la solicitud" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Verifica las fechas y el canal. Las habitaciones se comprobarán para toda la estancia." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/><TextBlock x:Name="StayDuration" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="La salida no ocupa una noche." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</UserControl>
