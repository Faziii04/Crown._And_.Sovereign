<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Wizard.PasoHuespedesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="Busca por nombre, documento, correo o teléfono" FontWeight="SemiBold"/>
  <TextBox x:Name="GuestSearchBox" Grid.Row="1" MinWidth="320" HorizontalAlignment="Left" Margin="0,6,0,14" ToolTip="Escribe nombre, documento, correo o teléfono" TextChanged="GuestSearchChanged"/>
  <StackPanel Grid.Row="2"><TextBlock Text="Huésped principal" FontWeight="SemiBold"/><ComboBox x:Name="GuestPicker" DisplayMemberPath="Nombre" MinWidth="320" HorizontalAlignment="Left"/><TextBlock Text="Acompañantes registrados" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock Text="Filtra la lista con el mismo campo y marca a quienes ya están registrados." Foreground="{StaticResource Muted}" Margin="0,4,0,8"/></StackPanel>
  <ListBox x:Name="CompanionsList" Grid.Row="3" DisplayMemberPath="Nombre" SelectionMode="Multiple"/>
 </Grid>
</UserControl>
