<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Wizard.PasoHabitacionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="CapacityNotice" Padding="11" CornerRadius="6" Background="#FFF4E5" BorderBrush="#E9BD78" BorderThickness="1" Margin="0,0,0,10"><TextBlock x:Name="CapacityMessage" TextWrapping="Wrap" FontWeight="SemiBold"/></Border>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
   <StackPanel>
    <WrapPanel>
     <TextBox x:Name="SearchBox" Width="170" Margin="2" ToolTip="Buscar por número, tipo o comodidad" TextChanged="SearchChanged"/>
     <ComboBox x:Name="FloorBox" Width="125" Margin="2" SelectionChanged="FilterSelectionChanged"/>
     <ComboBox x:Name="TypeBox" Width="140" Margin="2" SelectionChanged="FilterSelectionChanged"/>
     <ComboBox x:Name="CapacityBox" Width="135" Margin="2" SelectionChanged="FilterSelectionChanged"/>
     <ComboBox x:Name="AmenityBox" Width="145" Margin="2" SelectionChanged="FilterSelectionChanged"/>
    </WrapPanel>
    <CheckBox x:Name="SameFloorBox" Content="Mostrar habitaciones del mismo piso que la primera seleccionada" Margin="4,5" Checked="PreferenceChanged" Unchecked="PreferenceChanged"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="RoomList"><ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding Numero, StringFormat='Habitación {0}'}" FontWeight="SemiBold"/><TextBlock Text="{Binding RoomDetails}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
     <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat='Bs {0:N2}'}" VerticalAlignment="Center" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
    </Grid></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
   <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Selección" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="SelectionSummary" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,10"/><TextBlock Text="Capacidad seleccionada" FontWeight="SemiBold"/><TextBlock x:Name="CapacitySummary" Margin="0,4"/><TextBlock Text="Asignación de huéspedes" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock x:Name="AssignmentSummary" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="La capacidad debe cubrir a todas las personas. Añade habitaciones con las casillas si hace falta; puedes priorizar habitaciones del mismo piso." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0"/></StackPanel>
  </Grid>
 </Grid>
</UserControl>
