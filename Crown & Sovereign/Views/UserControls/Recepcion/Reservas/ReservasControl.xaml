<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.ReservasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="24,17,24,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="HeaderTitle" Text="Reservas" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="HeaderSubtitle" Text="Consulta disponibilidad y gestiona las reservas del hotel." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0"/></StackPanel><Button x:Name="NewReservationButton" Grid.Column="1" Content="＋ Nueva reserva" Width="158" Height="40" VerticalAlignment="Center" Click="NewReservation_Click"/></Grid>
        <reservas:ResumenReservasControl x:Name="SummaryView" Grid.Row="1" Margin="24,0,12,0" xmlns:reservas="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Shared"/>
        <Border x:Name="NavigationBar" Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="24,0" Margin="0,0,0,0"><Grid Height="46"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="AvailabilityTab" Content="Disponibilidad" Tag="Disponibilidad" Click="Navigation_Click" MinWidth="124" Padding="13,0" Margin="0,0,8,0"/><Button x:Name="CalendarTab" Content="Calendario" Tag="Calendario" Click="Navigation_Click" MinWidth="112" Padding="13,0" Margin="0,0,8,0"/><Button x:Name="ListTab" Content="Listado" Tag="Listado" Click="Navigation_Click" MinWidth="94" Padding="13,0"/></StackPanel><Border Grid.Column="1"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="GroupsTab" Content="Grupos" Tag="Grupos" Click="Navigation_Click" MinWidth="88" Padding="13,0" Margin="0,0,8,0"/><Button x:Name="WaitlistTab" Content="Lista de espera" Tag="Lista de espera" Click="Navigation_Click" MinWidth="138" Padding="13,0"/></StackPanel></Grid></Border>
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Margin="24,12,24,20"><ContentControl x:Name="WorkspaceHost"/></Border>
    </Grid>
</UserControl>
