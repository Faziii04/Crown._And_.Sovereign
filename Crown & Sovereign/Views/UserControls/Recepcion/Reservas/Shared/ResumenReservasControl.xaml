<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Shared.ResumenReservasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="MetricsList" Margin="0,0,0,10"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Clave}" Click="Shortcut_Click" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,7" Margin="0,0,10,0" HorizontalContentAlignment="Stretch" Cursor="Hand"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F8FAFC"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Primary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Information}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Valor}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Margin="0,0,0,1"/><TextBlock Text="{Binding Contexto}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="›" FontSize="22" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</UserControl>
