<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Detalle.DetalleReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:detalle="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Detalle"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Button Content="‹ Volver a reservas" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="Back_Click"/><TextBlock x:Name="TitleText" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="ConfirmButton" Content="Confirmar" Style="{StaticResource SecondaryButton}" Click="Confirm_Click"/><Button x:Name="CheckInButton" Content="Check-in" Margin="7,0,0,0" Click="CheckIn_Click"/><Button x:Name="CheckOutButton" Content="Check-out" Margin="7,0,0,0" Click="CheckOut_Click"/><Button x:Name="EditButton" Content="Editar" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Click="Edit_Click"/><Button x:Name="CancelButton" Content="Cancelar reserva" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Click="Cancel_Click"/></WrapPanel></Grid><TabControl Grid.Row="1"><TabItem Header="Resumen"><detalle:ResumenReservaControl x:Name="SummarySection"/></TabItem><TabItem Header="Habitaciones"><detalle:HabitacionesReservaControl x:Name="RoomsSection"/></TabItem><TabItem Header="Huéspedes"><detalle:HuespedesReservaControl x:Name="GuestsSection"/></TabItem></TabControl></Grid></UserControl>
