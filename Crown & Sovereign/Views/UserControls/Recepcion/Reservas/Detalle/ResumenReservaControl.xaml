<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Detalle.ResumenReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="Resumen de la reserva" FontSize="19" FontWeight="SemiBold"/><UniformGrid Columns="3" Margin="0,12"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="3"><StackPanel><TextBlock Text="Huésped principal" Foreground="{StaticResource Muted}"/><TextBlock x:Name="GuestText" FontSize="15" FontWeight="SemiBold" Margin="0,4"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="3"><StackPanel><TextBlock Text="Estancia" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DatesText" FontSize="14" FontWeight="SemiBold" Margin="0,4"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="3"><StackPanel><TextBlock Text="Estado" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold" Margin="0,4"/></StackPanel></Border></UniformGrid><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="16"><StackPanel><TextBlock Text="Estimación de la estancia" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="PriceBreakdown" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/><Separator Margin="0,14"/><DockPanel><TextBlock Text="Total estimado" FontWeight="SemiBold"/><TextBlock x:Name="TotalText" DockPanel.Dock="Right" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/></DockPanel></StackPanel></Border><TextBlock x:Name="SpecialRequestText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,12"/></StackPanel></ScrollViewer></UserControl>
