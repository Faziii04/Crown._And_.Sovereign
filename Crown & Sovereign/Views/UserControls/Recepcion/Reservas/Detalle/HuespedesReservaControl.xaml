<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Detalle.HuespedesReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,12"><TextBlock Text="Huéspedes de la reserva" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Huésped principal y acompañantes asociados a las habitaciones." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><DataGrid x:Name="GuestsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped.Nombre}" Width="2*"/><DataGridTextColumn Header="Documento" Binding="{Binding Huesped.Documento}" Width="*"/><DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" Width="*"/><DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="120"/><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion}" Width="140"/></DataGrid.Columns></DataGrid></Grid></UserControl>
