<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Detalle.HabitacionesReservaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,12"><TextBlock Text="Habitaciones asignadas" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Estado operativo, preparación y huéspedes distribuidos por habitación." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><DataGrid x:Name="RoomsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Habitación" Binding="{Binding Numero}" Width="100"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*"/><DataGridTextColumn Header="Piso" Binding="{Binding Piso}" Width="75"/><DataGridTextColumn Header="Limpieza" Binding="{Binding Limpieza}" Width="150"/><DataGridTextColumn Header="Bloqueo" Binding="{Binding Bloqueo}" Width="110"/><DataGridTextColumn Header="Huéspedes asignados" Binding="{Binding Huespedes}" Width="2*"/></DataGrid.Columns></DataGrid></Grid></UserControl>
