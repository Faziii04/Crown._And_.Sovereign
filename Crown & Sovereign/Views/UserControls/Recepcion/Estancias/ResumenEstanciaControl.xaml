<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.ResumenEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock Text="Resumen de estancia" FontSize="18" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Metricas}" Margin="0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="4"><StackPanel><TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Valor}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Huéspedes" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="GuestInfo" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Alojamiento" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="RoomInfo" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Resumen financiero" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="FinanceInfo" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Servicios y recursos" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ServicesResourcesInfo" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4"><StackPanel><TextBlock Text="Próximos pasos y avisos" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="AlertsInfo" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
</UserControl>
