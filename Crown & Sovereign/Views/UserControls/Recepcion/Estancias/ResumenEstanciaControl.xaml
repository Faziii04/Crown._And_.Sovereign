<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.ResumenEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="Resumen de estancia" FontSize="18" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Metricas}" Margin="0,10"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="4"><StackPanel><TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Valor}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="4"><StackPanel><TextBlock Text="Huésped" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="GuestInfo" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="4"><StackPanel><TextBlock Text="Habitación" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="RoomInfo" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></Grid></StackPanel></ScrollViewer>
</UserControl>
