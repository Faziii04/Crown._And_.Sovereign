<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.EstanciasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:stays="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Estancias">
    <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,16"><StackPanel><TextBlock Text="Estancias" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Gestiona el alojamiento, los folios y las salidas de los huéspedes." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Margin="20,10"><TabItem Header="Directorio de estancias"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ItemsControl x:Name="Metrics" Margin="0,0,0,10"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Grid.Row="1" VerticalAlignment="Center"><TextBox x:Name="SearchBox" Width="230" ToolTip="Huésped, documento, habitación, reserva, estancia, grupo o paquete" TextChanged="Filter_Changed"/><ComboBox x:Name="FloorFilter" Width="118" Margin="6,0,0,0" SelectionChanged="Filter_SelectionChanged"/><ComboBox x:Name="TypeFilter" Width="130" Margin="6,0,0,0" SelectionChanged="Filter_SelectionChanged"/><ComboBox x:Name="StatusFilter" Width="125" Margin="6,0,0,0" SelectionChanged="Filter_SelectionChanged"/><ComboBox x:Name="DepartureFilter" Width="150" Margin="6,0,0,0" SelectionChanged="Filter_SelectionChanged"/></WrapPanel><TextBlock Grid.Row="2" Text="Busca también acompañantes y filtra por fecha, piso, tipo, saldo o atención requerida." Foreground="{StaticResource Muted}" FontSize="11" Margin="8,6"/><DataGrid x:Name="StayGrid" Grid.Row="3" ItemsSource="{Binding}" AutoGenerateColumns="False" MouseDoubleClick="Stay_DoubleClick" Margin="0,4,0,0" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="Estancia" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Huésped principal" Binding="{Binding Guest}" Width="2*" CanUserSort="True"/><DataGridTextColumn Header="Habitación(es)" Binding="{Binding Room}" Width="1.4*"/><DataGridTextColumn Header="Piso(s)" Binding="{Binding Floors}" Width="65"/><DataGridTextColumn Header="Paquete" Binding="{Binding Package}" Width="1.1*"/><DataGridTextColumn Header="Check-in" Binding="{Binding CheckIn, StringFormat=dd/MM HH:mm}" Width="100"/><DataGridTextColumn Header="Salida prevista" Binding="{Binding CheckOut, StringFormat=dd/MM HH:mm}" Width="130"/><DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat='Bs {0:N2}'}" Width="95"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="85"/><DataGridTemplateColumn Header="Acción" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Abrir estancia" Style="{StaticResource SecondaryButton}" Padding="6,4" Click="OpenStay_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Espacio de trabajo"><stays:DetalleEstanciaControl x:Name="StayDetail"/></TabItem></TabControl>
    </Grid>
</UserControl>
