<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.EstanciasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:stays="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Estancias">
    <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,18"><StackPanel><TextBlock Text="Estancias activas" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Huéspedes alojados, fechas de salida y folios del hotel." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Margin="24,12"><TabItem Header="Estancias"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="SearchBox" Width="300" ToolTip="Huésped, habitación o número de estancia" TextChanged="Filter_Changed"/><ComboBox x:Name="FloorFilter" Width="150" SelectionChanged="Floor_Changed"/><ComboBox x:Name="StatusFilter" Width="165" SelectionChanged="Status_Changed"/></StackPanel><DataGrid x:Name="StayGrid" Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False" MouseDoubleClick="Stay_DoubleClick" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Estancia" Binding="{Binding Id}" Width="85"/><DataGridTextColumn Header="Huésped" Binding="{Binding Guest}" Width="2*"/><DataGridTextColumn Header="Habitación" Binding="{Binding Room}" Width="100"/><DataGridTextColumn Header="Piso" Binding="{Binding Floor}" Width="70"/><DataGridTextColumn Header="Paquete" Binding="{Binding Package}" Width="150"/><DataGridTextColumn Header="Check-in" Binding="{Binding CheckIn, StringFormat=dd/MM/yyyy}" Width="120"/><DataGridTextColumn Header="Check-out previsto" Binding="{Binding CheckOut, StringFormat=dd/MM/yyyy}" Width="135"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100"/><DataGridTemplateColumn Header="Acción" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Abrir estancia" Style="{StaticResource SecondaryButton}" Padding="8,5" Click="OpenStay_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Espacio de trabajo"><stays:DetalleEstanciaControl x:Name="StayDetail"/></TabItem></TabControl>
    </Grid>
</UserControl>
