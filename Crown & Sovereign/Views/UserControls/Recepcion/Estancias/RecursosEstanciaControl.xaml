<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.RecursosEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel><StackPanel><TextBlock Text="Recursos adicionales" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Equipamiento solicitado para esta reserva. La entrega y devolución se confirman en Operaciones." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><Button x:Name="RequestButton" DockPanel.Dock="Right" Content="＋ Solicitar recurso" Click="Request_Click"/></DockPanel>
  <ItemsControl x:Name="Metrics" Grid.Row="1" Margin="0,10"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Grid Grid.Row="2"><DataGrid x:Name="ResourceGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Resource_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Recurso" Binding="{Binding Nombre}" Width="2*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/><DataGridTextColumn Header="Modalidad" Binding="{Binding Modalidad}" Width="125"/><DataGridTextColumn Header="Importe acordado" Binding="{Binding Importe, StringFormat='Bs {0:N2}'}" Width="135"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="160"/><DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="2*"/></DataGrid.Columns></DataGrid><Border x:Name="EmptyState" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><StackPanel><TextBlock Text="No se han solicitado recursos adicionales." FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Los recursos elegibles pueden solicitarse durante la estancia." Foreground="{StaticResource Muted}" Margin="0,5,0,10" TextAlignment="Center"/><Button Content="Solicitar recurso" Click="Request_Click" HorizontalAlignment="Center"/></StackPanel></Border></Grid>
 </Grid>
</UserControl>
