<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.FolioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <StackPanel>
                <TextBlock Text="Folio de la estancia" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="FolioLabel" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button x:Name="PaymentButton" DockPanel.Dock="Right" Content="＋ Registrar pago" Click="Payment_Click"/>
        </DockPanel>
        <TextBlock x:Name="LegacyNotice" Grid.Row="1" TextWrapping="Wrap" Foreground="#8A5B18" Background="#FFF4DB" Padding="9,6" Margin="4,7,4,7" Visibility="Collapsed"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel Margin="4">
                    <ComboBox x:Name="MovementFilter" Width="135" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Todos"/><ComboBoxItem Content="Cargos"/><ComboBoxItem Content="Pagos"/><ComboBoxItem Content="Correcciones"/>
                    </ComboBox>
                    <TextBox x:Name="MovementSearch" Width="220" Margin="7,0,0,0" ToolTip="Buscar movimiento" TextChanged="Filter_Changed"/>
                </WrapPanel>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="FolioGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM HH:mm}" Width="105"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="75"/>
                            <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="2*"/>
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat='Bs {0:N2}'}" Width="105"/>
                            <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText" Text="No existen movimientos registrados en este folio." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Grid>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="8,4,4,4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Resumen financiero" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FolioStateText" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,6,0,0">
                        <Border Background="{StaticResource Canvas}" CornerRadius="5" Padding="6" Margin="0,0,4,0"><StackPanel><TextBlock Text="Cargos" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="ChargesText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                        <Border Background="{StaticResource Canvas}" CornerRadius="5" Padding="6" Margin="2,0"><StackPanel><TextBlock Text="Pagado" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="PaidText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                        <Border Background="{StaticResource Canvas}" CornerRadius="5" Padding="6" Margin="4,0,0,0"><StackPanel><TextBlock Text="Saldo" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="BalanceText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Primary}" TextWrapping="Wrap"/></StackPanel></Border>
                    </UniformGrid>
                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                        <TextBlock Text="Alojamiento futuro estimado (aún no cargado)" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock x:Name="FutureLodgingText" Text="No calculado" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
