<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.FolioControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Movimientos del folio" FontSize="18" FontWeight="SemiBold" Margin="4"/><TextBlock x:Name="LegacyNotice" Grid.Row="1" TextWrapping="Wrap" Foreground="#8A5B18" Background="#FFF4DB" Padding="9,6" Margin="4,0,4,6" Visibility="Collapsed"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid x:Name="FolioGrid" ItemsSource="{Binding Movimientos}" AutoGenerateColumns="False" Margin="4"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM HH:mm}" Width="130"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="80"/><DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/><DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat='Bs {0:N2}'}" Width="125"/></DataGrid.Columns></DataGrid><Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="17" Margin="8,4,4,4"><StackPanel><TextBlock Text="Resumen financiero" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Total cargos" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/><TextBlock x:Name="ChargesText" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Total pagado" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock x:Name="PaidText" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Saldo pendiente" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock x:Name="BalanceText" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/><Button x:Name="PaymentButton" Content="Registrar pago" Margin="0,18,0,3" Click="Payment_Click"/><Button x:Name="ChargeButton" Content="Agregar cargo" Style="{StaticResource SecondaryButton}" Click="Charge_Click"/></StackPanel></Border></Grid></Grid>
</UserControl>
