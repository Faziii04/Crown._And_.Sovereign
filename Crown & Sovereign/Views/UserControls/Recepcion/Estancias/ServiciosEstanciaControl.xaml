<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.ServiciosEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><StackPanel><TextBlock Text="Servicios de la estancia" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Beneficios, servicios adquiridos, solicitudes y uso de esta visita." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,10"/></StackPanel><Button x:Name="RequestButton" DockPanel.Dock="Right" Content="＋ Solicitar servicio" Click="Request_Click"/></DockPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Beneficios"><DataGrid x:Name="BenefitsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Área" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Coverage}" Width="160"/><DataGridTextColumn Header="Incluidos" Binding="{Binding Allowance}" Width="85"/><DataGridTextColumn Header="Utilizados" Binding="{Binding Consumed}" Width="85"/><DataGridTextColumn Header="Restantes" Binding="{Binding RemainingText}" Width="120"/><DataGridTextColumn Header="Cargo adicional" Binding="{Binding Price, StringFormat='Bs {0:N2}'}" Width="125"/><DataGridCheckBoxColumn Header="Requiere cita" Binding="{Binding RequiresAppointment, Mode=OneWay}" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Servicios adquiridos"><DataGrid x:Name="AcquiredGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Destinatario" Binding="{Binding Recipient}" Width="150"/><DataGridTextColumn Header="Adquiridos" Binding="{Binding Purchased}" Width="90"/><DataGridTextColumn Header="Utilizados" Binding="{Binding Used}" Width="85"/><DataGridTextColumn Header="Restantes" Binding="{Binding Remaining}" Width="85"/><DataGridTextColumn Header="Precio unitario acordado" Binding="{Binding Price, StringFormat='Bs {0:N2}'}" Width="145"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="Cargo" Binding="{Binding Charge}" Width="90"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Solicitudes y citas"><DataGrid x:Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Detalle / responsable" Binding="{Binding Detalle}" Width="220"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Uso confirmado"><DataGrid x:Name="UsageGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Servicio" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Cobertura}" Width="150"/><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo, StringFormat='Bs {0:N2}'}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
        </TabControl>
    </Grid>
</UserControl>
