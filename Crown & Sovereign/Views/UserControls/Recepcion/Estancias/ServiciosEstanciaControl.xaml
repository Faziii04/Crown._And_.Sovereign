<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.ServiciosEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Servicios de la estancia" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Beneficios, solicitudes y uso confirmado para esta visita." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,10"/></StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Beneficios"><DataGrid x:Name="BenefitsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Área" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Coverage}" Width="140"/><DataGridTextColumn Header="Usos restantes" Binding="{Binding Remaining}" Width="130"/><DataGridTextColumn Header="Precio" Binding="{Binding Price}" Width="110"/><DataGridCheckBoxColumn Header="Requiere cita" Binding="{Binding RequiresAppointment}" Width="110"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Solicitudes y citas"><DataGrid x:Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Detalle / responsable" Binding="{Binding Detalle}" Width="220"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="Uso confirmado"><DataGrid x:Name="UsageGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Servicio" Binding="{Binding Nombre}" Width="*"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Cobertura}" Width="150"/><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo, StringFormat='Bs {0:N2}'}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
        </TabControl>
    </Grid>
</UserControl>
