<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.ActividadEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Actividad de la estancia" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Reservas, pagos, cargos, consumos y servicios en orden cronológico." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,10"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110"/><DataGridTextColumn Header="Actividad" Binding="{Binding Descripcion}" Width="*"/><DataGridTextColumn Header="Origen" Binding="{Binding Usuario}" Width="150"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
