<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.DetalleEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:stays="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Estancias">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Button x:Name="BackButton" Content="← Volver a estancias" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="7,3" Click="Back_Click"/><TextBlock x:Name="GuestTitle" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="StaySubtitle" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/><TextBlock x:Name="StayDates" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="StayIdText" Grid.Column="1" Text="Estancia" FontWeight="SemiBold" VerticalAlignment="Top" HorizontalAlignment="Right"/><StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="ExtendButton" Content="Extender estancia" Style="{StaticResource SecondaryButton}" Click="Extend_Click"/><Button x:Name="MoveButton" Content="Cambiar habitación" Style="{StaticResource SecondaryButton}" Click="Move_Click"/><Button x:Name="CheckOutButton" Content="Preparar salida" Click="CheckOut_Click"/></StackPanel></Grid></Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Margin="0,8,0,0"><TabItem Header="Resumen"><stays:ResumenEstanciaControl x:Name="SummaryView"/></TabItem><TabItem Header="Folio"><stays:FolioControl x:Name="FolioView"/></TabItem><TabItem Header="Servicios"><stays:ServiciosEstanciaControl x:Name="ServicesView"/></TabItem><TabItem Header="Consumos"><stays:ConsumosEstanciaControl x:Name="ConsumptionView"/></TabItem><TabItem Header="Recursos"><stays:RecursosEstanciaControl x:Name="ResourcesView"/></TabItem><TabItem Header="Llaves"><stays:LlavesEstanciaControl x:Name="KeysView"/></TabItem><TabItem Header="Actividad"><stays:ActividadEstanciaControl x:Name="ActivityView"/></TabItem></TabControl>
    </Grid>
</UserControl>
