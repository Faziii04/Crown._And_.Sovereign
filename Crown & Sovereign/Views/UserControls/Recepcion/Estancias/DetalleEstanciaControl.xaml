<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.DetalleEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:stays="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Estancias">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="GuestTitle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="StaySubtitle" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/><TextBlock x:Name="StayDates" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button x:Name="CheckOutButton" Grid.Column="1" Content="Check-out" VerticalAlignment="Center" Click="CheckOut_Click"/></Grid></Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Margin="0,10,0,0"><TabItem Header="Resumen"><stays:ResumenEstanciaControl x:Name="SummaryView"/></TabItem><TabItem Header="Folio"><stays:FolioControl x:Name="FolioView"/></TabItem><TabItem Header="Servicios"><stays:ServiciosEstanciaControl x:Name="ServicesView"/></TabItem><TabItem Header="Consumos"><stays:ConsumosEstanciaControl x:Name="ConsumptionView"/></TabItem><TabItem Header="Llaves"><stays:LlavesEstanciaControl x:Name="KeysView"/></TabItem><TabItem Header="Actividad"><stays:ActividadEstanciaControl x:Name="ActivityView"/></TabItem></TabControl>
    </Grid>
</UserControl>
