<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.LlavesEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Llaves de la estancia" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Emisión y revocación en la sesión de demostración." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="IssueButton" Content="＋ Emitir llave" Click="Issue_Click"/><Button x:Name="RevokeButton" Content="Revocar seleccionada" Style="{StaticResource SecondaryButton}" Click="Revoke_Click"/></StackPanel></DockPanel><DataGrid x:Name="KeysGrid" Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="180"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="140"/><DataGridTextColumn Header="Estancia" Binding="{Binding EstanciaId}" Width="120"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
