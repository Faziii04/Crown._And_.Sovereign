<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.ConsumosEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Consumos de la estancia" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Productos cargados al folio y existencias afectadas." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,10"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Consumo.Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Consumo.Cantidad}" Width="110"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Consumo.Incluido, StringFormat=Incluido: {0}}" Width="140"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
