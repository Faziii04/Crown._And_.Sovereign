<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Estancias.ConsumosEstanciaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Consumos de la estancia" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Consulta de productos y cargos registrados para esta visita." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,8"/></StackPanel><ItemsControl x:Name="Metrics" Grid.Row="1" Margin="0,0,0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid Grid.Row="2"><DataGrid x:Name="ConsumptionGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="135"/><DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/><DataGridTextColumn Header="Huésped" Binding="{Binding Guest}" Width="150"/><DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="120"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Coverage}" Width="125"/><DataGridTextColumn Header="Precio aplicado" Binding="{Binding UnitPrice}" Width="125"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount}" Width="115"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyText" Text="No se han registrado consumos para esta estancia." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Grid>
</UserControl>
