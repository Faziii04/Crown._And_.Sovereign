<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Servicios.CitasPendientesRecepcionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,10"><TextBlock Text="Solicitudes de cita pendientes de coordinación" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="La fecha y hora solicitadas son preferidas hasta que Operaciones confirme una asignación." Foreground="{StaticResource Muted}" Margin="0,3"/></StackPanel><DataGrid x:Name="RequestsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding Guest}" Width="*"/><DataGridTextColumn Header="Hab." Binding="{Binding Room}" Width="70"/><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Horario solicitado" Binding="{Binding DesiredDate, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="130"/><DataGridTextColumn Header="Nota" Binding="{Binding Description}" Width="2*"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
