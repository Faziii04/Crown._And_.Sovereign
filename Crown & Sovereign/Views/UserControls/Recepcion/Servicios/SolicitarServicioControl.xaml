<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Servicios.SolicitarServicioControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:selectors="clr-namespace:Crown___Sovereign.Views.UserControls.Shared.Selectors" xmlns:cards="clr-namespace:Crown___Sovereign.Views.UserControls.Shared.Cards">
    <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><selectors:SelectorHuespedActivoControl x:Name="GuestSelector" Margin="0,0,12,0"/><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Catálogo de servicios" FontSize="19" FontWeight="SemiBold"/><DockPanel Margin="0,3,0,10"><TextBlock x:Name="SelectedGuestText" Text="Selecciona un huésped activo para consultar su cobertura." Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button x:Name="BenefitsButton" Content="Ver beneficios" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="8,0,0,0" Click="Benefits_Click" IsEnabled="False"/></DockPanel><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="ServiceSearch" Width="230" HorizontalAlignment="Left" ToolTip="Buscar servicio" TextChanged="Search_Changed"/><ComboBox x:Name="CoverageFilter" Grid.Column="1" Margin="6,0,0,0" SelectionChanged="Filter_Changed"/><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Los horarios se confirman en Operaciones." Foreground="{StaticResource Muted}" FontSize="11" Margin="2,5,0,0" TextWrapping="Wrap"/></Grid></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="CategoryList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="4,0"/><ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="3,4"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,2"/><ItemsControl ItemsSource="{Binding Services}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><cards:ServicioCardControl Loaded="ServiceCard_Loaded"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Grid>
</UserControl>
