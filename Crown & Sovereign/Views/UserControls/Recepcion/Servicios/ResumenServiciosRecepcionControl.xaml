<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Servicios.ResumenServiciosRecepcionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="MetricsList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Key}" Click="Metric_Click" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,9" Margin="0,0,10,0" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Count}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</UserControl>
