<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Servicios.AgendaHoyRecepcionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Agenda del día" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><DatePicker x:Name="DateBox" Margin="12,0" SelectedDateChanged="Date_Changed"/><TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel><DataGrid x:Name="AgendaGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Hora" Binding="{Binding Start, StringFormat=HH:mm}" Width="75"/><DataGridTextColumn Header="Huésped" Binding="{Binding Guest}" Width="*"/><DataGridTextColumn Header="Hab." Binding="{Binding Room}" Width="70"/><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Responsable" Binding="{Binding Employee}" Width="150"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
