<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Servicios.SolicitudesHuespedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Servicios">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="185"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Seguimiento de solicitudes" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ScopeText" Text="Alcance: Todas las solicitudes" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10"><ComboBox x:Name="ScopeBox" Width="190" SelectionChanged="Status_Changed"/><ComboBox x:Name="StatusBox" Width="170" SelectionChanged="Status_Changed"/><TextBox x:Name="SearchBox" Width="270" ToolTip="Huésped, habitación o servicio" TextChanged="Search_Changed"/></StackPanel>
        <DataGrid x:Name="RequestsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Request_Selected"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding Guest}" Width="*"/><DataGridTextColumn Header="Hab." Binding="{Binding Room}" Width="75"/><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="Solicitada" Binding="{Binding RequestedAt, StringFormat=dd/MM HH:mm}" Width="130"/><DataGridTextColumn Header="Horario deseado" Binding="{Binding DesiredDate, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/><DataGridTextColumn Header="Tipo" Binding="{Binding RequiresAppointment}" Width="70"/><DataGridTextColumn Header="Asignado" Binding="{Binding Responsible}" Width="130"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid>
        <services:DetalleSolicitudServicioControl x:Name="DetailView" Grid.Row="3"/>
    </Grid>
</UserControl>
