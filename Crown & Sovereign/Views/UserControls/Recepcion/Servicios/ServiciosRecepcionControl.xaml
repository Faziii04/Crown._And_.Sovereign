<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Servicios.ServiciosRecepcionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Servicios">
    <Grid Background="{StaticResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,15"><StackPanel><TextBlock Text="Servicios para huéspedes" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Consulta beneficios y coordina solicitudes con Operaciones." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></Border>
        <services:ResumenServiciosRecepcionControl x:Name="SummaryView" Grid.Row="1" Margin="24,12,24,4"/>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="2" Margin="24,0,24,16"><TabItem Header="Catálogo y solicitudes"><services:SolicitarServicioControl x:Name="RequestView"/></TabItem><TabItem Header="Seguimiento de solicitudes"><services:SolicitudesHuespedControl x:Name="RequestsView"/></TabItem><TabItem Header="Agenda de servicios"><services:AgendaServiciosRecepcionControl x:Name="AgendaView"/></TabItem></TabControl>
    </Grid>
</UserControl>
