<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Servicios.ProgresoSolicitudServicioControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="StepsList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{StaticResource Primary}" VerticalAlignment="Top" Margin="0,4,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Date, StringFormat=dd/MM HH:mm}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Top" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</UserControl>
