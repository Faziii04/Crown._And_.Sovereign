<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Huespedes.PerfilHuespedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:guests="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Huespedes">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="18,16,18,10"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="#E8EEF4" CornerRadius="22"><TextBlock x:Name="InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#3E5974"/></Border><StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center"><TextBlock x:Name="GuestName" FontSize="22" FontWeight="SemiBold" Foreground="#243041"/><TextBlock x:Name="ProfileContext" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/></StackPanel><WrapPanel Grid.Column="2" VerticalAlignment="Top"><Button x:Name="ExpandButton" Content="‹ Directorio" Click="Expand_Click" Margin="0,0,6,0"/><Button Content="Ver estancia" Click="Stay_Click" Margin="0,0,6,0"/><Button x:Name="FolioButton" Content="Consultar folio" Click="Folio_Click" Margin="0,0,6,0"/><Button x:Name="RoomButton" Content="Ver habitación" Click="Room_Click" Margin="0,0,6,0"/><Button x:Name="ReservationButton" Content="Ver reserva" Click="OpenReservation_Click" Margin="0,0,6,0"/><Button Content="Editar perfil" Click="Edit_Click" Margin="0,0,6,0"/><Button x:Name="NewReservationButton" Content="Nueva reserva" Click="Reservation_Click"/></WrapPanel></Grid>
  <TabControl x:Name="ProfileTabs" Grid.Row="1" Margin="14,0,14,14"><TabItem Header="Resumen"><guests:ResumenPerfilHuespedControl x:Name="OverviewView"/></TabItem><TabItem Header="Información"><ScrollViewer VerticalScrollBarVisibility="Auto"><guests:InformacionHuespedControl x:Name="InformationView"/></ScrollViewer></TabItem><TabItem Header="Historial"><guests:HistorialHuespedControl x:Name="HistoryView"/></TabItem><TabItem Header="Estancia actual"><guests:EstanciaActualHuespedControl x:Name="CurrentStayView"/></TabItem><TabItem Header="Solicitudes"><guests:SolicitudesHuespedControl x:Name="RequestsView"/></TabItem><TabItem Header="Consentimientos"><ScrollViewer VerticalScrollBarVisibility="Auto"><guests:ConsentimientosHuespedControl x:Name="ConsentView"/></ScrollViewer></TabItem></TabControl>
 </Grid>
</UserControl>
