<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Huespedes.PerfilHuespedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:guests="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Huespedes">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="14,12,14,6"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="#E8EEF4" CornerRadius="22"><TextBlock x:Name="InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#3E5974"/></Border><StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center"><TextBlock x:Name="GuestName" FontSize="21" FontWeight="SemiBold" Foreground="#243041" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ProfileContext" Foreground="#64748B" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
  <WrapPanel Grid.Row="1" Margin="14,0,14,8"><Button x:Name="ExpandButton" Content="‹ Directorio" Click="Expand_Click" Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,4"/><Button Content="Ver estancia" Click="Stay_Click" Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,4"/><Button x:Name="FolioButton" Content="Folio" Click="Folio_Click" Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,4"/><Button x:Name="RoomButton" Content="Habitación" Click="Room_Click" Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,4"/><Button x:Name="ReservationButton" Content="Reserva" Click="OpenReservation_Click" Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,4"/><Button Content="Editar perfil" Click="Edit_Click" Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,4"/><Button x:Name="NewReservationButton" Content="Nueva reserva" Click="Reservation_Click" Style="{StaticResource SecondaryButton}" Padding="7,4" Margin="0,0,5,4"/></WrapPanel>
  <TabControl x:Name="ProfileTabs" Grid.Row="2" Margin="10,0,10,12"><TabItem Header="Resumen"><guests:ResumenPerfilHuespedControl x:Name="OverviewView"/></TabItem><TabItem Header="Información"><ScrollViewer VerticalScrollBarVisibility="Auto"><guests:InformacionHuespedControl x:Name="InformationView"/></ScrollViewer></TabItem><TabItem Header="Historial"><guests:HistorialHuespedControl x:Name="HistoryView"/></TabItem><TabItem Header="Estancia actual"><guests:EstanciaActualHuespedControl x:Name="CurrentStayView"/></TabItem><TabItem Header="Solicitudes"><guests:SolicitudesHuespedControl x:Name="RequestsView"/></TabItem><TabItem Header="Consentimientos"><ScrollViewer VerticalScrollBarVisibility="Auto"><guests:ConsentimientosHuespedControl x:Name="ConsentView"/></ScrollViewer></TabItem></TabControl>
 </Grid>
</UserControl>
