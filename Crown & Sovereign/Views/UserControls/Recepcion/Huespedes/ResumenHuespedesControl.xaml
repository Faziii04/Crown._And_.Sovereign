<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Huespedes.ResumenHuespedesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UniformGrid Columns="4"><Button Click="Registered_Click" Margin="0,0,10,0" Padding="14,10" Background="White" BorderBrush="#DCE2E8"><StackPanel><TextBlock Text="Registrados" Foreground="#64748B"/><TextBlock x:Name="RegisteredCount" FontSize="24" FontWeight="SemiBold" Foreground="#243041"/><TextBlock Text="Total de huéspedes" FontSize="11" Foreground="#64748B"/></StackPanel></Button><Button Click="Active_Click" Margin="0,0,10,0" Padding="14,10" Background="White" BorderBrush="#DCE2E8"><StackPanel><TextBlock Text="En el hotel" Foreground="#64748B"/><TextBlock x:Name="ActiveCount" FontSize="24" FontWeight="SemiBold" Foreground="#39816A"/><TextBlock Text="Huéspedes con estancia activa" FontSize="11" Foreground="#64748B"/></StackPanel></Button><Button Click="Upcoming_Click" Margin="0,0,10,0" Padding="14,10" Background="White" BorderBrush="#DCE2E8"><StackPanel><TextBlock Text="Próximas reservas" Foreground="#64748B"/><TextBlock x:Name="UpcomingCount" FontSize="24" FontWeight="SemiBold" Foreground="#507BA5"/><TextBlock Text="Llegada en los próximos 7 días" FontSize="11" Foreground="#64748B"/></StackPanel></Button><Button Click="Repeat_Click" Padding="14,10" Background="White" BorderBrush="#DCE2E8"><StackPanel><TextBlock Text="Recurrentes" Foreground="#64748B"/><TextBlock x:Name="RepeatCount" FontSize="24" FontWeight="SemiBold" Foreground="#AD7B34"/><TextBlock Text="Dos o más estancias finalizadas" FontSize="11" Foreground="#64748B"/></StackPanel></Button></UniformGrid>
</UserControl>
