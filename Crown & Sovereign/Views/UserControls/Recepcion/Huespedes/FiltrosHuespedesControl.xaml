<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Huespedes.FiltrosHuespedesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel><TextBox x:Name="SearchBox" Height="34" Padding="9,6" ToolTip="Nombre, documento, correo, teléfono, habitación o reserva" TextChanged="Changed"/><WrapPanel Margin="0,8,0,4"><Button Content="Todos" Click="All_Click" Margin="0,0,4,4"/><Button Content="En hotel" Click="Active_Click" Margin="0,0,4,4"/><Button Content="Próximos" Click="Upcoming_Click" Margin="0,0,4,4"/><Button Content="Recurrentes" Click="Repeat_Click" Margin="0,0,4,4"/></WrapPanel><Expander Header="Más filtros" Margin="0,2,0,8"><StackPanel><TextBlock Text="Estancias" Foreground="#64748B"/><ComboBox x:Name="StayFilter" SelectionChanged="Changed" Margin="0,2,0,6"/><CheckBox x:Name="PendingCheck" Content="Con solicitudes pendientes" Checked="Changed" Unchecked="Changed" Margin="0,2"/><CheckBox x:Name="ContactCheck" Content="Contacto incompleto" Checked="Changed" Unchecked="Changed" Margin="0,2"/><CheckBox x:Name="ConsentCheck" Content="Consentimiento por revisar" Checked="Changed" Unchecked="Changed" Margin="0,2"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Piso" VerticalAlignment="Center"/><ComboBox x:Name="FloorFilter" Width="80" Margin="6,0,10,0" SelectionChanged="Changed"/><TextBlock Text="Habitación" VerticalAlignment="Center"/><TextBox x:Name="RoomFilter" Width="95" Margin="6,0,0,0" TextChanged="Changed"/></StackPanel><Button Content="Limpiar filtros" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Clear_Click"/></StackPanel></Expander><ComboBox x:Name="SortBox" SelectionChanged="Changed"/></StackPanel>
</UserControl>
