<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Huespedes.HistorialHuespedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock Text="Historial de alojamiento" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="HistoryNote" Foreground="#64748B" Margin="0,4,0,8"/><ComboBox x:Name="ReservationFilter" Width="180" HorizontalAlignment="Left" SelectionChanged="Filter_Changed" Margin="0,0,0,8"/><DataGrid x:Name="ReservationGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="280"><DataGrid.Columns><DataGridTextColumn Header="Reserva" Binding="{Binding ReservaId}" Width="90"/><DataGridTextColumn Header="Llegada" Binding="{Binding Llegada, StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="Salida" Binding="{Binding Salida, StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="Noches" Binding="{Binding Noches}" Width="65"/><DataGridTextColumn Header="Habitación" Binding="{Binding Habitaciones}" Width="100"/><DataGridTextColumn Header="Relación" Binding="{Binding Relacion}" Width="95"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/><DataGridTemplateColumn Header="" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Ver reserva" Padding="4,3" Click="OpenReservation_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Text="Utilización de servicios" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6"/><DataGrid x:Name="ServiceGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Cobertura}" Width="110"/><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo, StringFormat='Bs {0:N2}'}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer></UserControl>
