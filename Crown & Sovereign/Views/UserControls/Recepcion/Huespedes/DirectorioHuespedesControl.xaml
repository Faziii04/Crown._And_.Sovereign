<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Huespedes.DirectorioHuespedesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:guests="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Huespedes">
 <Border Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Directorio" FontSize="17" FontWeight="SemiBold" Foreground="#243041"/><guests:FiltrosHuespedesControl x:Name="Filters" Margin="0,10,0,0"/></StackPanel><TextBlock x:Name="CountText" Grid.Row="1" Margin="0,10,0,6" Foreground="#64748B" FontSize="12"/><Grid Grid.Row="2"><ListBox x:Name="GuestList" BorderThickness="0" SelectionChanged="Guest_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Border Padding="8,7" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="#E8EEF4" CornerRadius="16" VerticalAlignment="Top"><TextBlock Text="{Binding Iniciales}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3E5974" FontWeight="SemiBold"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Documento, StringFormat=Doc. {0}}" FontSize="11" Foreground="#64748B"/><TextBlock Text="{Binding Contexto}" FontSize="11" Foreground="{Binding Color}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="No se encontraron huéspedes" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Ningún huésped coincide con la búsqueda actual." Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,10"/><Button Content="Limpiar filtros" Click="Clear_Click"/></StackPanel></Grid></Grid></Border>
</UserControl>
