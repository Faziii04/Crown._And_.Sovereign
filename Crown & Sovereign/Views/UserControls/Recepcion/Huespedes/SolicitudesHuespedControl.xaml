<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Huespedes.SolicitudesHuespedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="12,10"><Button Content="＋ Solicitud especial" Click="SpecialRequest_Click" Margin="0,0,8,0"/><Button Content="＋ Solicitar servicio" Click="ServiceRequest_Click"/></WrapPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,0"><TextBlock Text="Solicitudes especiales asociadas a reservas" FontWeight="SemiBold"/><ItemsControl x:Name="SpecialRequests" Margin="0,5,0,12"/><TextBlock Text="Solicitudes de servicio y citas" FontWeight="SemiBold"/><ItemsControl x:Name="ServiceRequests" Margin="0,5,0,12"/><TextBlock Text="Utilización registrada" FontWeight="SemiBold"/><DataGrid x:Name="ServiceHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="190"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/><DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding Cobertura}" Width="95"/><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo, StringFormat='Bs {0:N2}'}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer></Grid></UserControl>
