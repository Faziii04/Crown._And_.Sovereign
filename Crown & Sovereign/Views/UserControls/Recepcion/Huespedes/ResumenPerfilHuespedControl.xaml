<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Huespedes.ResumenPerfilHuespedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Resumen de la relación" FontSize="17" FontWeight="SemiBold"/><UniformGrid Columns="4" Margin="0,10,0,12"><Border Background="#F4F6F8" Padding="10" Margin="0,0,5,0"><StackPanel><TextBlock Text="Estancias"/><TextBlock x:Name="CompletedCount" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#F4F6F8" Padding="10" Margin="0,0,5,0"><StackPanel><TextBlock Text="Noches"/><TextBlock x:Name="NightsCount" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#F4F6F8" Padding="10" Margin="0,0,5,0"><StackPanel><TextBlock Text="Reservas"/><TextBlock x:Name="ReservationsCount" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#F4F6F8" Padding="10"><StackPanel><TextBlock Text="Última visita"/><TextBlock x:Name="LastVisit" FontSize="15" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid><TextBlock Text="Situación actual" FontWeight="SemiBold"/><TextBlock x:Name="SituationText" TextWrapping="Wrap" Margin="0,5,0,10"/><TextBlock Text="Atención requerida" FontWeight="SemiBold"/><ItemsControl x:Name="AttentionList" Margin="0,4,0,10"/><TextBlock Text="Actividad reciente" FontWeight="SemiBold"/><ListBox x:Name="ActivityList" BorderThickness="0" MaxHeight="280"><ListBox.ItemTemplate><DataTemplate><Border Padding="7" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Tipo}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detalle}" Foreground="#64748B"/><TextBlock Text="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" FontSize="11" Foreground="#64748B"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></ScrollViewer>
</UserControl>
