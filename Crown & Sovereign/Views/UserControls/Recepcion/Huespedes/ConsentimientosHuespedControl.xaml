<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Huespedes.ConsentimientosHuespedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Margin="14"><TextBlock Text="Privacidad y comunicaciones" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ConsentStatus" Margin="0,9,0,6"/><TextBlock Text="El estado no constituye evidencia de cumplimiento legal. Los cambios se guardan al confirmar." Foreground="#64748B" TextWrapping="Wrap"/><Button Content="Actualizar consentimiento" HorizontalAlignment="Left" Margin="0,12" Click="Consent_Click"/><TextBlock Text="Cambios registrados durante esta sesión de muestra" FontWeight="SemiBold"/><ListBox x:Name="ConsentHistory" Margin="0,5" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Padding="8" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" FontWeight="SemiBold"/><TextBlock Text="{Binding Usuario}" FontSize="11" Foreground="#64748B"/><TextBlock Text="{Binding Observaciones}" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="ConsentEmpty" Text="No hay registro histórico anterior; se muestra el estado vigente." Foreground="#64748B" TextWrapping="Wrap"/></StackPanel></UserControl>
