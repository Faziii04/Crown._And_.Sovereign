<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Dashboard.RecepcionDashboardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
        <TextBlock Text="Resumen de recepción" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="Llegadas, salidas y estado operativo del hotel." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
        <ItemsControl ItemsSource="{Binding Metricas}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Valor}" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Contexto}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="Llegadas y salidas de hoy" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Acciones contextuales para el equipo de recepción." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10"/><ItemsControl ItemsSource="{Binding Movimientos}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Hora}" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding Huesped}" FontWeight="SemiBold"/><TextBlock Text="{Binding Tipo}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Habitacion, StringFormat='Hab. {0}'}" VerticalAlignment="Center"/><Button Grid.Column="3" Content="{Binding Accion}" Tag="{Binding}" Click="ArrivalAction_Click" Style="{StaticResource SecondaryButton}" Padding="8,5"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <StackPanel Grid.Column="1"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="Accesos rápidos" FontSize="17" FontWeight="SemiBold"/><Button Content="＋  Nueva reserva" Click="NewReservation_Click" HorizontalContentAlignment="Left"/><Button Content="＋  Registrar huésped" Click="NewGuest_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"/><Button Content="▦  Consultar habitaciones" Click="Rooms_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="5"><StackPanel><TextBlock Text="Condición de habitaciones" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding EstadoHabitaciones}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock Text="{Binding Alertas}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
        </Grid>
    </StackPanel></ScrollViewer>
</UserControl>
