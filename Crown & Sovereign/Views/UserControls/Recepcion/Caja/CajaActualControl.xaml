<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Caja.CajaActualControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cash="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Caja">
    <Grid Margin="16">
        <ScrollViewer x:Name="OpenScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="OpenPanel">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel LastChildFill="False"><StackPanel><TextBlock Text="Caja actual" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ShiftLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><Button Content="Cerrar turno" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="CloseShift_Click"/></DockPanel>
            <Grid Grid.Row="1" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <cash:EfectivoEsperadoControl x:Name="ExpectedCashView" Margin="0,0,8,0"/>
                <cash:ResumenMediosPagoControl x:Name="PaymentMethodsView" Grid.Column="1" Margin="8,0,0,0"/>
            </Grid>
            <cash:MovimientosTurnoControl x:Name="ShiftMovementsView" Grid.Row="2"/>
        </Grid>
        </ScrollViewer>
        <Border x:Name="ClosedPanel" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="28">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center" Margin="0,12,0,20"><TextBlock Text="Caja cerrada" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Abre un turno para registrar pagos. Las consultas históricas siguen disponibles." Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0"/><Button Content="Abrir turno" Margin="0,14,0,0" HorizontalAlignment="Center" Click="OpenShift_Click"/></StackPanel>
                <TextBlock Grid.Row="1" Text="Último turno · resumen histórico" FontSize="16" FontWeight="SemiBold"/>
                <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Turno" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LastShiftText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Esperado" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LastExpectedText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Contado" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LastCountedText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Diferencia" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LastDifferenceText" FontWeight="SemiBold"/></StackPanel></Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
