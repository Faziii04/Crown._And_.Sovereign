<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Caja.CorreccionesFinancierasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel LastChildFill="False"><StackPanel><TextBlock Text="Devoluciones y anulaciones" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Solicita una corrección, revisa su autorización y registra su ejecución en tu turno." Foreground="{StaticResource Muted}" Margin="0,3,0,10"/></StackPanel><ComboBox x:Name="StateBox" DockPanel.Dock="Right" Width="180" SelectionChanged="Filter_Changed"/></DockPanel>
        <DataGrid x:Name="CorrectionsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" LoadingRow="CorrectionRow_Loading" RowDetailsVisibilityMode="VisibleWhenSelected"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM HH:mm}" Width="90"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="85"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="130"/><DataGridTextColumn Header="Pago" Binding="{Binding PagoId, StringFormat=#{0}}" Width="75"/><DataGridTextColumn Header="Importe" Binding="{Binding Monto, StringFormat='Bs {0:N2}'}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="95"/><DataGridTemplateColumn Header="Acción" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Aprobar" Tag="{Binding}" Click="Approve_Click" Style="{StaticResource SecondaryButton}" Padding="4,4" Margin="1"/><Button Content="Rechazar" Tag="{Binding}" Click="Reject_Click" Style="{StaticResource SecondaryButton}" Padding="4,4" Margin="1"/><Button Content="Ejecutar" Tag="{Binding}" Click="Execute_Click" Padding="4,4" Margin="1"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><Border Background="#F5F7F9" Padding="8,6"><StackPanel><TextBlock Text="{Binding Motivo, StringFormat=Motivo: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Responsables, StringFormat=Solicitó · autorizó: {0}}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid>
    </Grid>
</UserControl>
