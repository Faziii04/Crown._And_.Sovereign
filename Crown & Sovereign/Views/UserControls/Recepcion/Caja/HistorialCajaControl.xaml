<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Caja.HistorialCajaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Historial de caja" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Turnos de caja, cierres y conciliaciones vinculados al usuario." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,10"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"><TextBox x:Name="SearchBox" Width="300" ToolTip="Buscar por usuario o turno" TextChanged="Filter_Changed"/><ComboBox x:Name="StateBox" Width="170" SelectionChanged="Filter_Changed"/><TextBlock Text="Selecciona un turno para ver sus movimientos y cierre." Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/></StackPanel><DataGrid x:Name="ClosuresGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Shift_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="75"/><DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="*"/><DataGridTextColumn Header="Apertura" Binding="{Binding Apertura, StringFormat=dd/MM HH:mm}" Width="120"/><DataGridTextColumn Header="Cierre" Binding="{Binding Cierre}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="85"/><DataGridTextColumn Header="Esperado" Binding="{Binding Esperado}" Width="105"/><DataGridTextColumn Header="Contado" Binding="{Binding Contado}" Width="105"/><DataGridTextColumn Header="Diferencia" Binding="{Binding Diferencia}" Width="105"/></DataGrid.Columns></DataGrid></Grid>
</UserControl>
