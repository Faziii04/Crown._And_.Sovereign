<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Caja.ResumenMediosPagoControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Resumen del turno" FontSize="16" FontWeight="SemiBold"/>
            <ItemsControl x:Name="MethodsList" Grid.Row="1" Margin="0,9,0,4"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Metodo}" FontSize="13"/><TextBlock Grid.Column="1" Text="{Binding Importe, StringFormat='Bs {0:N2}'}" FontSize="13" FontWeight="SemiBold"/><ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="6" Margin="0,5,0,0" Maximum="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.Maximo, Mode=OneWay}" Value="{Binding Importe, Mode=OneWay}" Foreground="{StaticResource Primary}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Separator Grid.Row="2" Margin="0,8"/>
            <Grid Grid.Row="3"><TextBlock Text="Pagos recibidos" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TotalText" HorizontalAlignment="Right" FontSize="19" FontWeight="SemiBold"/></Grid>
        </Grid>
    </Border>
</UserControl>
