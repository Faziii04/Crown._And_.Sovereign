<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Caja.CajaControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cash="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Caja">
    <Grid Background="{StaticResource Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Background="White" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Margin="24,16"><TextBlock Text="Caja y facturación" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Cobros, turnos, movimientos y facturación." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
            <Button DockPanel.Dock="Right" Content="＋ Registrar pago" Margin="8,21,24,0" Padding="16,9" Click="RegisterPayment_Click"/>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="24,0,24,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="ShiftDot" Width="10" Height="10" Fill="#39816A" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="10,0"><TextBlock x:Name="ShiftTitle" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="ShiftSubtitle" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/></StackPanel>
                <Button x:Name="ShiftActionButton" Grid.Column="2" Content="Cerrar turno" Style="{StaticResource SecondaryButton}" Click="ShiftAction_Click"/>
            </Grid>
        </Border>
        <TabControl x:Name="CashTabs" Grid.Row="2" Margin="24,0,24,18">
            <TabItem Header="Caja actual"><cash:CajaActualControl x:Name="CurrentCashView"/></TabItem>
            <TabItem Header="Pagos"><cash:PagosControl x:Name="PaymentsView"/></TabItem>
            <TabItem Header="Facturas"><cash:FacturasControl x:Name="InvoicesView"/></TabItem>
            <TabItem Header="Devoluciones y anulaciones"><cash:CorreccionesFinancierasControl x:Name="CorrectionsView"/></TabItem>
            <TabItem Header="Historial"><cash:HistorialCajaControl x:Name="ClosuresView"/></TabItem>
        </TabControl>
    </Grid>
</UserControl>
