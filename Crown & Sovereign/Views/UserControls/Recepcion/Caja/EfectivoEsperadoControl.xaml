<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Caja.EfectivoEsperadoControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="EFECTIVO ESPERADO" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="ExpectedText" Grid.Row="1" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Margin="0,5,0,0"/>
            <StackPanel Grid.Row="2" Margin="0,10,0,10"><TextBlock x:Name="OpeningText" Margin="0,2"/><TextBlock x:Name="CashInText" Margin="0,2"/><TextBlock x:Name="CashOutText" Margin="0,2"/><TextBlock x:Name="CashCancellationText" Margin="0,2"/><Separator Margin="0,8"/><TextBlock x:Name="FormulaText" FontWeight="SemiBold"/></StackPanel>
            <Button Grid.Row="3" Content="Consultar cálculo y movimientos" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="Details_Click"/>
        </Grid>
    </Border>
</UserControl>
