<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Caja.FacturasControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel LastChildFill="False"><StackPanel><TextBlock Text="Facturas" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Documentos vinculados a cargos reales del folio · impresión desde Windows." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,10"/></StackPanel><Button DockPanel.Dock="Right" Content="＋ Emitir factura" Click="NewInvoice_Click"/></DockPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6"><TextBox x:Name="SearchBox" Width="360" ToolTip="Número, cliente, documento, folio o reserva" TextChanged="Filter_Changed"/><ComboBox x:Name="StateBox" Width="170" SelectionChanged="Filter_Changed"/></StackPanel>
  <TextBlock Grid.Row="2" Text="Los registros heredados sin folio verificado se muestran como no atribuidos." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <DataGrid x:Name="InvoicesGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="Invoice_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="125"/><DataGridTextColumn Header="Cliente" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="85"/><DataGridTextColumn Header="Contexto" Binding="{Binding Contexto}" Width="150"/><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yy}" Width="95"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='Bs {0:N2}'}" Width="110"/><DataGridTemplateColumn Header="Ver" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Abrir" Style="{StaticResource SecondaryButton}" Padding="5,4" Click="Preview_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
