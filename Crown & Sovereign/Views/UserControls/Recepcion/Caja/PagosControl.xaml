<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Caja.PagosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel LastChildFill="False"><StackPanel><TextBlock Text="Pagos" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Consulta pagos y abre el detalle de su folio y turno." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="＋ Registrar pago" Click="NewPayment_Click"/></DockPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="-4,10"><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4"><StackPanel><TextBlock x:Name="PaymentCountTitle" Text="Pagos · turno actual" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="PaymentCountText" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4"><StackPanel><TextBlock Text="Total recibido · alcance seleccionado" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="PaymentTotalText" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4"><StackPanel><TextBlock Text="Folios con saldo pendiente" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="OutstandingText" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,10"><ComboBox x:Name="ScopeBox" Width="170" SelectionChanged="Filter_Changed"/><TextBox x:Name="SearchBox" Width="300" ToolTip="Buscar pago, huésped, documento, folio o reserva" TextChanged="Search_Changed"/><ComboBox x:Name="MethodBox" Width="160" SelectionChanged="Filter_Changed"/><ComboBox x:Name="StateBox" Width="190" SelectionChanged="Filter_Changed"/></StackPanel>
        <DataGrid x:Name="PaymentsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" MouseDoubleClick="Payment_DoubleClick"><DataGrid.Columns>
            <DataGridTextColumn Header="Pago" Binding="{Binding Id, StringFormat=#0000}" Width="70"/><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM HH:mm}" Width="105"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="65"/><DataGridTextColumn Header="Método" Binding="{Binding Metodo}" Width="95"/><DataGridTextColumn Header="Importe" Binding="{Binding Monto, StringFormat='Bs {0:N2}'}" Width="110"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/><DataGridTemplateColumn Header="Detalle" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Ver" Style="{StaticResource SecondaryButton}" Padding="6,4" Click="Details_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns></DataGrid>
    </Grid>
</UserControl>
