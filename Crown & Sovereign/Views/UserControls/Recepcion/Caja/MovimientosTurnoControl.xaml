<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Caja.MovimientosTurnoControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel><StackPanel><TextBlock Text="Movimientos del turno" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Actualizar" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/></DockPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,8"><ComboBox x:Name="TypeBox" Width="160" SelectionChanged="Filter_Changed"/><ComboBox x:Name="MethodBox" Width="165" SelectionChanged="Filter_Changed"/><TextBox x:Name="SearchBox" Width="260" ToolTip="Buscar movimiento, huésped, pago o folio" TextChanged="Search_Changed"/></StackPanel>
            <DataGrid x:Name="MovementsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True">
                <DataGrid.Columns><DataGridTextColumn Header="Fecha y hora" Binding="{Binding Fecha, StringFormat=dd/MM HH:mm}" Width="145"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="105"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Folio" Binding="{Binding FolioId}" Width="80"/><DataGridTextColumn Header="Método" Binding="{Binding Metodo}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="125"/><DataGridTextColumn Header="Importe" Binding="{Binding Monto, StringFormat='Bs {0:N2}'}" Width="130"/></DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
