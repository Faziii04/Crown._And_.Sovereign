<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Filtros.FiltrosHabitacionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:filters="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Filtros">
 <StackPanel>
  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="Buscar habitación, huésped, reserva o comodidad" TextChanged="SearchChanged"/><ComboBox x:Name="TypeBox" Grid.Column="1" Margin="8,0" SelectionChanged="FilterChanged"/><Expander x:Name="AdvancedExpander" Grid.Column="2" VerticalAlignment="Center" Header="Más filtros" Margin="4,0"><filters:FiltrosAvanzadosHabitacionesControl x:Name="AdvancedFilters" FiltrosCambiados="Advanced_Changed"/></Expander><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Orden" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="8,0,4,0"/><ComboBox x:Name="SortBox" Width="155" SelectionChanged="FilterChanged"/></StackPanel></Grid>
  <WrapPanel x:Name="QuickFilters" Margin="0,7,0,0"><Button Content="Todas" Tag="Todas" Click="Quick_Click" Margin="0,0,6,0"/><Button Content="Llegadas hoy" Tag="Llegadas hoy" Click="Quick_Click" Margin="0,0,6,0"/><Button Content="Salidas hoy" Tag="Salidas hoy" Click="Quick_Click" Margin="0,0,6,0"/><Button Content="Por limpiar" Tag="Por limpiar" Click="Quick_Click" Margin="0,0,6,0"/><Button Content="Con incidencias" Tag="Con incidencias" Click="Quick_Click" Margin="0,0,6,0"/><Button Content="Bloqueadas" Tag="Bloqueadas" Click="Quick_Click" Margin="0,0,6,0"/><Button Content="Inspección" Tag="Pendientes de inspección" Click="Quick_Click" Margin="0,0,6,0"/><Button Content="Llegadas en riesgo" Tag="Llegadas en riesgo" Click="Quick_Click" Margin="0,0,6,0"/><Button Content="Salidas pendientes" Tag="Salidas pendientes" Click="Quick_Click" Margin="0,0,6,0"/></WrapPanel>
  <TextBlock x:Name="ResultText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
 </StackPanel>
</UserControl>
