<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Filtros.FiltrosAvanzadosHabitacionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel Margin="4"><TextBlock Text="Ocupación"/><ComboBox x:Name="OccupancyBox" SelectionChanged="FilterChanged"/></StackPanel>
  <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="Limpieza"/><ComboBox x:Name="CleaningBox" SelectionChanged="FilterChanged"/></StackPanel>
  <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="Mantenimiento"/><ComboBox x:Name="MaintenanceBox" SelectionChanged="FilterChanged"/></StackPanel>
  <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="Capacidad mínima"/><ComboBox x:Name="CapacityBox" SelectionChanged="FilterChanged"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="4"><TextBlock Text="Piso"/><ComboBox x:Name="FloorBox" SelectionChanged="FilterChanged"/></StackPanel>
  <StackPanel Grid.Row="1" Grid.Column="1" Margin="4"><TextBlock Text="Llegada"/><ComboBox x:Name="ArrivalBox" SelectionChanged="FilterChanged"/></StackPanel>
  <StackPanel Grid.Row="1" Grid.Column="2" Margin="4"><TextBlock Text="Salida"/><ComboBox x:Name="DepartureBox" SelectionChanged="FilterChanged"/></StackPanel>
  <StackPanel Grid.Row="1" Grid.Column="3" Margin="4"><TextBlock Text="Ordenar por"/><ComboBox x:Name="SortBox" SelectionChanged="FilterChanged"/></StackPanel>
  <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="4,8,4,0"><TextBlock Text="Comodidades requeridas · se aplican todas" FontWeight="SemiBold"/><WrapPanel><CheckBox x:Name="WifiBox" Content="Wi-Fi" Checked="FilterChecked" Unchecked="FilterChecked" Margin="0,5,14,0"/><CheckBox x:Name="MinibarBox" Content="Minibar" Checked="FilterChecked" Unchecked="FilterChecked" Margin="0,5,14,0"/><CheckBox x:Name="JacuzziBox" Content="Jacuzzi" Checked="FilterChecked" Unchecked="FilterChecked" Margin="0,5,14,0"/><CheckBox x:Name="BalconyBox" Content="Balcón" Checked="FilterChecked" Unchecked="FilterChecked" Margin="0,5,14,0"/><CheckBox x:Name="TvBox" Content="Televisor" Checked="FilterChecked" Unchecked="FilterChecked" Margin="0,5,14,0"/><CheckBox x:Name="AirBox" Content="Aire acondicionado" Checked="FilterChecked" Unchecked="FilterChecked" Margin="0,5,14,0"/><Button Content="Limpiar filtros" Style="{StaticResource SecondaryButton}" Click="Clear_Click" Margin="12,0,0,0" Padding="8,4"/></WrapPanel><TextBlock x:Name="ActiveCountText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
 </Grid></Border>
</UserControl>
