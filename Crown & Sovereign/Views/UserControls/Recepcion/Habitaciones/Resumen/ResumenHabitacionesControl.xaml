<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Resumen.ResumenHabitacionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border x:Name="ReadyCard" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Margin="0,0,6,0"><Button Tag="Listas para ingreso" Click="Metric_Click" Background="Transparent" BorderThickness="0" Padding="14" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="Listas para ingreso" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ReadyValue" FontSize="26" FontWeight="SemiBold" Margin="0,2"/><TextBlock x:Name="ReadyNote" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Button></Border>
  <Border x:Name="OccupiedCard" Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Margin="6,0"><Button Tag="Ocupadas" Click="Metric_Click" Background="Transparent" BorderThickness="0" Padding="14" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="Ocupadas" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OccupiedValue" FontSize="26" FontWeight="SemiBold" Margin="0,2"/><TextBlock x:Name="OccupiedNote" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Button></Border>
  <Border x:Name="PrepCard" Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Margin="6,0"><Button Tag="Por preparar" Click="Metric_Click" Background="Transparent" BorderThickness="0" Padding="14" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="Por preparar" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PrepValue" FontSize="26" FontWeight="SemiBold" Margin="0,2"/><TextBlock x:Name="PrepNote" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Button></Border>
  <Border x:Name="BlockedCard" Grid.Column="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Margin="6,0,0,0"><Button Tag="Bloqueadas" Click="Metric_Click" Background="Transparent" BorderThickness="0" Padding="14" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="Bloqueadas" Foreground="{StaticResource Muted}"/><TextBlock x:Name="BlockedValue" FontSize="26" FontWeight="SemiBold" Margin="0,2"/><TextBlock x:Name="BlockedNote" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Button></Border>
 </Grid>
</UserControl>
