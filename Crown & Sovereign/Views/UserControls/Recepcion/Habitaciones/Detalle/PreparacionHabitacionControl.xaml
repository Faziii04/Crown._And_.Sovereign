<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Detalle.PreparacionHabitacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/><Border Background="#FFFFF7ED" BorderBrush="#E9BD78" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,9"><TextBlock x:Name="StateText" FontWeight="SemiBold"/></Border>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12"><StackPanel><TextBlock Text="Progreso de preparación" FontSize="16" FontWeight="SemiBold"/><ItemsControl x:Name="ProgressList" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="{Binding Marca}" Width="24" FontWeight="SemiBold" Foreground="{Binding Color}"/><TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/><TextBlock Text="{Binding Nota}" Foreground="{StaticResource Muted}" Margin="7,0,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,10"><StackPanel><TextBlock Text="Tarea actual" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="TaskText" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock Text="Observaciones" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock x:Name="TaskNotesText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/><Button Content="Solicitar limpieza" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Request_Click"/></StackPanel></Border>
  <TextBlock Text="Historial reciente" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,6"/><ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,2"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></ScrollViewer>
</UserControl>
