<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Detalle.EstadosHabitacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock Text="Ocupación" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OccupancyText" FontSize="16" FontWeight="SemiBold" Margin="0,3"/><TextBlock x:Name="GuestText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="Limpieza" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CleaningText" FontSize="16" FontWeight="SemiBold" Margin="0,3"/><TextBlock x:Name="InspectionText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock Text="Mantenimiento" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MaintenanceText" FontSize="16" FontWeight="SemiBold" Margin="0,3"/><TextBlock x:Name="IncidentText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
 </Grid>
</UserControl>
