<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Detalle.CaracteristicasHabitacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><Border Background="#FFEFF2F4" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Height="180"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="▦" FontSize="48" Foreground="#94A3B8" HorizontalAlignment="Center"/><TextBlock Text="Imagen no disponible" Foreground="{StaticResource Muted}"/></StackPanel></Border><StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="Información general" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="GeneralText" TextWrapping="Wrap" Margin="0,8"/></StackPanel></Grid><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12"><StackPanel><TextBlock Text="Comodidades disponibles" FontSize="16" FontWeight="SemiBold"/><ItemsControl x:Name="AmenitiesList" Margin="0,6"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='✓  {0}'}" Margin="0,4,18,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Descripción" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="DescriptionText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer>
</UserControl>
