<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Detalle.ResumenHabitacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:detail="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Detalle">
 <Grid Margin="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border x:Name="TurnoverAlert" Background="#FFFFF7ED" BorderBrush="#E9BD78" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,9" Visibility="Collapsed"><StackPanel><TextBlock Text="Preparación necesaria para próxima llegada" FontWeight="SemiBold"/><TextBlock Text="Salida prevista: hoy · próxima llegada: hoy. La habitación debe limpiarse e inspeccionarse antes del siguiente check-in." TextWrapping="Wrap" Margin="0,3"/><Button Content="Consultar preparación" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="Preparation_Click"/></StackPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><detail:EstanciaActualHabitacionControl x:Name="CurrentStay" Margin="0,0,6,0"/><detail:ProximaReservaHabitacionControl x:Name="NextReservation" Grid.Column="1" Margin="6,0,0,0"/></Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,9,0,0"><StackPanel><TextBlock Text="Acciones rápidas" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,0"><Button Content="Crear reserva" Tag="Crear reserva" Click="Action_Click"/><Button Content="Consultar disponibilidad" Tag="Disponibilidad" Style="{StaticResource SecondaryButton}" Click="Action_Click" Margin="6,0,0,0"/><Button Content="Solicitar limpieza" Tag="Solicitar limpieza" Style="{StaticResource SecondaryButton}" Click="Action_Click" Margin="6,0,0,0"/><Button Content="Reportar incidencia" Tag="Reportar incidencia" Style="{StaticResource SecondaryButton}" Click="Action_Click" Margin="6,0,0,0"/><Button x:Name="MoveButton" Content="Cambiar habitación" Tag="Cambiar habitación" Style="{StaticResource SecondaryButton}" Click="Action_Click" Margin="6,0,0,0"/></WrapPanel></StackPanel></Border>
 </Grid>
</UserControl>
