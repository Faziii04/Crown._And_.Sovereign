<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Detalle.EncabezadoHabitacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BreadcrumbText" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,1"/><TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatusText" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Volver al tablero" Style="{StaticResource SecondaryButton}" Click="Back_Click"/><Button x:Name="PrimaryButton" Margin="7,0,0,0" Click="Primary_Click"/><Button x:Name="ActionsButton" Content="Más acciones ▾" Margin="7,0,0,0" Click="Actions_Click"/></WrapPanel></Grid></Border>
</UserControl>
