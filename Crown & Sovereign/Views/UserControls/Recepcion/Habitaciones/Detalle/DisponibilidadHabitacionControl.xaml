<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Detalle.DisponibilidadHabitacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Style="{StaticResource SecondaryButton}" Click="Previous_Click"/><Button Content="Hoy" Style="{StaticResource SecondaryButton}" Margin="5,0" Click="Today_Click"/><Button Content="›" Style="{StaticResource SecondaryButton}" Click="Next_Click"/><ComboBox x:Name="HorizonBox" Width="100" Margin="8,0,0,0" SelectionChanged="Horizon_Changed"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Desde"/><DatePicker x:Name="StartPicker" SelectedDateChanged="Period_Changed"/><TextBlock Text="Hasta · salida exclusiva" Margin="0,7,0,0"/><DatePicker x:Name="EndPicker" SelectedDateChanged="Period_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="Selecciona una fecha libre y ajusta el período" FontWeight="SemiBold"/><TextBlock x:Name="SelectionText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/><Button Content="Crear reserva para este período" HorizontalAlignment="Left" Margin="0,9,0,0" Click="CreateReservation_Click"/></StackPanel></Grid></Border>
  <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel MinWidth="720"><DockPanel Margin="0,2,0,4"><TextBlock Text="Fechas" Width="110" FontWeight="SemiBold"/><ItemsControl x:Name="DateHeader"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="82" Padding="4" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1"><TextBlock Text="{Binding DayLabel}" TextAlignment="Center" FontSize="11"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Reservas" Width="110" VerticalAlignment="Center"/><Grid x:Name="TimelineGrid" Height="58"><ItemsControl x:Name="DayCells"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="82" Height="58" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" Background="#FFF7F8FA" Tag="{Binding}" MouseLeftButtonDown="Day_Click" ToolTip="{Binding Detail}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl x:Name="ReservationBars" IsHitTestVisible="True"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="7"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Border Width="{Binding Width}" Height="42" Background="#FFD8E7F2" BorderBrush="#507BA5" BorderThickness="1" CornerRadius="4" Padding="5,3" Tag="{Binding}" Cursor="Hand" MouseLeftButtonDown="Reservation_Click"><TextBlock Text="{Binding Huesped}" TextTrimming="CharacterEllipsis" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Bloqueos" Width="110" VerticalAlignment="Center"/><Border x:Name="BlockBar" Height="27" Background="#FFF7E7E7" BorderBrush="#B65757" BorderThickness="1" CornerRadius="4" Visibility="Collapsed" Padding="6"><TextBlock x:Name="BlockText" Foreground="#8F3D3D" FontSize="11"/></Border><TextBlock x:Name="NoBlockText" Text="Sin bloqueos en el período" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></StackPanel></ScrollViewer>
  <Button Grid.Row="3" Content="Ver calendario general de Reservas" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="GeneralCalendar_Click"/>
 </Grid>
</UserControl>
