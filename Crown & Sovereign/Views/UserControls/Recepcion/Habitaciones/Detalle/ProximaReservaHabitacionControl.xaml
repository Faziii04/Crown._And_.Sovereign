<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Detalle.ProximaReservaHabitacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel><TextBlock Text="Próxima reserva" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="GuestText" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock x:Name="ReservationText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="ReadinessText" TextWrapping="Wrap" Margin="0,8,0,0"/><Button x:Name="OpenButton" Content="Ver reserva" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Open_Click"/></StackPanel></Border>
