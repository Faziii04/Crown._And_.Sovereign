<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Detalle.IncidenciasHabitacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/><Button Content="＋ Reportar incidencia" DockPanel.Dock="Right" Click="Report_Click"/></DockPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8"><TextBlock x:Name="OperationalText" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" Margin="10,0"/></StackPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="IncidentList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><DockPanel><TextBlock Text="{Binding Incidencia.Descripcion}" FontWeight="SemiBold"/><TextBlock Text="{Binding Incidencia.Prioridad}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/></DockPanel><TextBlock Text="{Binding Detalle}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="{Binding Impacto}" Foreground="#9A4545" FontSize="11"/></StackPanel><Button Grid.Column="1" Content="Ver detalles" Tag="{Binding Incidencia}" Style="{StaticResource SecondaryButton}" Click="Details_Click" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <TextBlock x:Name="EmptyText" Grid.Row="2" Text="No hay incidencias registradas para esta habitación." Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
  <TextBlock Grid.Row="3" Text="Una incidencia abierta no bloquea automáticamente la habitación. El equipo de Mantenimiento determina el impacto operativo." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
 </Grid>
</UserControl>
