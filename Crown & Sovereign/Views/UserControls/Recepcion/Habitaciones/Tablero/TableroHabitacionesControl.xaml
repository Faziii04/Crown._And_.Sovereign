<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Tablero.TableroHabitacionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:board="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Tablero">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,2,0,5"><TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Vista" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,7,0"/><ToggleButton x:Name="CompactButton" Content="Compacta" IsChecked="True" Click="Compact_Click" Padding="9,5"/><ToggleButton x:Name="DetailedButton" Content="Detallada" Click="Detailed_Click" Padding="9,5" Margin="5,0,0,0"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><ScrollViewer x:Name="BoardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="FloorList"><ItemsControl.ItemTemplate><DataTemplate><board:SeccionPisoControl Loaded="FloorSection_Loaded"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"><TextBlock Text="No se encontraron habitaciones" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Ninguna habitación cumple los filtros seleccionados." Foreground="{StaticResource Muted}" Margin="0,5,0,12" HorizontalAlignment="Center"/><Button Content="Limpiar filtros" Click="ClearFilters_Click" HorizontalAlignment="Center"/></StackPanel></Grid>
 </Grid>
</UserControl>
