<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Tablero.VistaRapidaHabitacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="320">
 <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="15"><StackPanel><TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" Margin="0,3,0,12"/><TextBlock x:Name="ClassificationText" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="GuestText" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DatesText" Foreground="{StaticResource Muted}" Margin="0,3,0,10"/><TextBlock x:Name="ConditionsText" TextWrapping="Wrap"/><TextBlock x:Name="NextText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="ActionButton" Content="Abrir" Click="Action_Click"/><Button Content="Ver detalles" Style="{StaticResource SecondaryButton}" Click="Details_Click" Margin="7,0,0,0"/></StackPanel></StackPanel></Border>
