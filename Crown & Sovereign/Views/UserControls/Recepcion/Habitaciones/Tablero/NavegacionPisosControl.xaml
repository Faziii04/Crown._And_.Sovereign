<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Tablero.NavegacionPisosControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ItemsControl x:Name="FloorOptions"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Piso}" Click="Floor_Click" Background="White" BorderBrush="{StaticResource Line}" Padding="10,7" Margin="0,0,7,0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Style.Triggers><DataTrigger Binding="{Binding Seleccionado}" Value="True"><Setter Property="BorderBrush" Value="#3E5974"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Background" Value="#F2F6F9"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/><TextBlock Text="{Binding Total, StringFormat=' · {0} hab.'}" Foreground="{StaticResource Muted}" Margin="4,0,0,0"/><TextBlock Text="{Binding Listas, StringFormat=' · {0} listas'}" Foreground="#39816A" Margin="4,0,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</UserControl>
