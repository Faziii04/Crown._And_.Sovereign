<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.FiltrosHabitacionesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,12,0,10"><StackPanel>
        <StackPanel Orientation="Horizontal"><TextBox x:Name="SearchBox" Width="230" ToolTip="Buscar número, huésped o comodidad" TextChanged="SearchChanged"/><ComboBox x:Name="FloorBox" Width="130" SelectionChanged="SelectionChanged"/><ComboBox x:Name="TypeBox" Width="155" SelectionChanged="SelectionChanged"/><ComboBox x:Name="OccupancyBox" Width="150" SelectionChanged="SelectionChanged"/><ComboBox x:Name="CleaningBox" Width="165" SelectionChanged="SelectionChanged"/><Button Content="Limpiar filtros" Style="{StaticResource SecondaryButton}" Click="Clear_Click"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><ComboBox x:Name="CapacityBox" Width="165" SelectionChanged="SelectionChanged"/><ComboBox x:Name="AmenityBox" Width="190" SelectionChanged="SelectionChanged"/><CheckBox x:Name="BlockedBox" Content="Solo habitaciones bloqueadas" VerticalAlignment="Center" Margin="12,0" Checked="CheckChanged" Unchecked="CheckChanged"/></StackPanel>
    </StackPanel></Border>
</UserControl>
