<UserControl x:Class="Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.DetalleHabitacionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock x:Name="RoomTitle" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="RoomSubtitle" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Button x:Name="EditButton" DockPanel.Dock="Right" Content="Editar habitación" Style="{StaticResource SecondaryButton}" Click="Edit_Click"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="4"><StackPanel><TextBlock Text="Ocupación" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OccupancyText" FontSize="17" FontWeight="SemiBold" Margin="0,4"/><TextBlock x:Name="GuestText" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="4"><StackPanel><TextBlock Text="Limpieza" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CleaningText" FontSize="17" FontWeight="SemiBold" Margin="0,4"/></StackPanel></Border><Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="4"><StackPanel><TextBlock Text="Mantenimiento" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MaintenanceText" FontSize="17" FontWeight="SemiBold" Margin="0,4"/><TextBlock x:Name="IncidentText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border></Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18" Margin="4,14"><StackPanel><TextBlock Text="Características de la habitación" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CapacityText" Margin="0,10,0,4"/><TextBlock Text="Comodidades" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock x:Name="AmenitiesText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Separator Margin="0,18"/><StackPanel Orientation="Horizontal"><Button x:Name="ReservationButton" Content="Crear reserva" Click="Reservation_Click"/><Button Content="Enviar solicitud de limpieza" Style="{StaticResource SecondaryButton}" Click="CleaningRequest_Click"/><Button Content="Reportar incidencia" Style="{StaticResource SecondaryButton}" Click="Incident_Click"/></StackPanel></StackPanel></Border>
    </Grid></ScrollViewer>
</UserControl>
