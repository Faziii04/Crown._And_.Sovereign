<UserControl x:Class="Crown___Sovereign.Views.UserControls.Shared.Navigation.TopBarControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinHeight="60">
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,9">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TodayLabel" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="8"/>
                <Button Content="♧  Notificaciones" Style="{StaticResource SecondaryButton}" Click="Notifications_Click"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Breadcrumb" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
