<UserControl x:Class="Crown___Sovereign.Views.UserControls.Shared.Cards.ConvenioCardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="280" MaxWidth="360" MinHeight="250">
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,10,10">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8" Background="#EEF3F7"><TextBlock Text="{Binding Iniciales}" Foreground="{StaticResource Primary}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center"><TextBlock Text="{Binding Convenio.Empresa}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Convenio.Nombre}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Border Grid.Column="2" Background="#E8F3EE" CornerRadius="10" Padding="8,4" VerticalAlignment="Top"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#E8F3EE"/><Style.Triggers><DataTrigger Binding="{Binding EstadoVigencia}" Value="Inactivo"><Setter Property="Background" Value="#EEF1F4"/></DataTrigger><DataTrigger Binding="{Binding EstadoVigencia}" Value="Por iniciar"><Setter Property="Background" Value="#EAF1F8"/></DataTrigger><DataTrigger Binding="{Binding EstadoVigencia}" Value="Por vencer"><Setter Property="Background" Value="#FFF3DF"/></DataTrigger><DataTrigger Binding="{Binding EstadoVigencia}" Value="Vencido"><Setter Property="Background" Value="#F9EAEA"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding EstadoVigencia}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/></Border>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Convenio.Categoria}" Foreground="{StaticResource Information}" FontSize="12" Margin="52,4,0,8"/>
            <StackPanel Grid.Row="2" Margin="0,0,0,10"><TextBlock Text="{Binding ServiciosActivos, StringFormat='Servicios asociados: {0}'}" FontWeight="SemiBold"/><TextBlock Text="{Binding ServiciosResumen}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/><TextBlock Text="Sin servicios asociados" Foreground="{StaticResource Muted}" FontStyle="Italic" FontSize="12" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ServiciosActivos}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Utilizaciones, StringFormat='Utilizaciones registradas: {0}'}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding CostoTexto}" Foreground="{StaticResource Information}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
            <StackPanel Grid.Row="3" Margin="0,0,0,10"><TextBlock Text="{Binding MensajeVigencia}" Foreground="{StaticResource Warning}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Periodo}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
            <TextBlock Grid.Row="4" Text="{Binding Advertencia}" Foreground="{StaticResource Warning}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Advertencia}" Margin="0,0,0,7"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Advertencia}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ver" Tag="{Binding Convenio.Id}" Click="Detail_Click" Padding="9,4"/><Button Content="Editar" Tag="{Binding Convenio.Id}" Click="Edit_Click" Style="{StaticResource SecondaryButton}" Padding="9,4" Margin="5,0,0,0"/></StackPanel>
        </Grid>
    </Border>
</UserControl>
