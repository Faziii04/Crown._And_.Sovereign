<UserControl x:Class="Crown___Sovereign.Views.UserControls.Shared.Cards.HabitacionCompactaCardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:rooms="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Habitaciones.Tablero" Width="172" Height="143">
 <Grid><Border x:Name="CardBorder" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4" MouseLeftButtonDown="Card_MouseLeftButtonDown" ToolTip="{Binding Tooltip}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><TextBlock Text="{Binding Habitacion.Numero}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Habitacion.Tipo}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
  <TextBlock x:Name="StatusText" Grid.Row="1" FontWeight="SemiBold" Margin="0,3"/>
  <StackPanel Grid.Row="2"><TextBlock x:Name="GuestText" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}"/><TextBlock x:Name="ContextText" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="WarningText" Foreground="#9A4545" FontWeight="SemiBold" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="PrimaryAction" Click="Action_Click" Padding="4" Margin="0,2,3,0"/><Button Grid.Column="1" Content="Detalles" Style="{StaticResource SecondaryButton}" Click="Details_Click" Padding="5" Margin="3,2,0,0"/></Grid>
 </Grid></Border><Popup x:Name="PreviewPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=CardBorder}" StaysOpen="False" AllowsTransparency="True"><rooms:VistaRapidaHabitacionControl x:Name="QuickPreview"/></Popup></Grid>
</UserControl>
