<UserControl x:Class="Crown___Sovereign.Views.UserControls.Shared.Cards.ServicioCardControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="225">
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="13" Margin="5"><StackPanel><TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nombre}"/><TextBlock Text="{Binding Descripcion}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" MaxHeight="34" Margin="0,3,0,0"/><TextBlock x:Name="CoverageText" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock x:Name="DetailText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/><TextBlock x:Name="AppointmentText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/><TextBlock x:Name="PriceText" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"/><Button x:Name="RequestButton" Content="Solicitar" Margin="0,10,0,0" Click="Request_Click"/></StackPanel></Border>
</UserControl>
