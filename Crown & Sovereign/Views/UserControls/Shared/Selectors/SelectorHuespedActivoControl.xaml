<UserControl x:Class="Crown___Sovereign.Views.UserControls.Shared.Selectors.SelectorHuespedActivoControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Seleccionar huésped activo" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Solo huéspedes alojados · búsqueda por nombre, documento, reserva o habitación." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,7"/></StackPanel><TextBox x:Name="SearchBox" Grid.Row="1" ToolTip="Nombre, documento, reserva o habitación" TextChanged="Search_Changed"/><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><ComboBox x:Name="FloorBox" Width="125" SelectionChanged="Floor_Changed"/><ComboBox x:Name="RoomBox" Width="135" SelectionChanged="Filter_Changed"/></StackPanel><ListBox x:Name="GuestList" Grid.Row="1" BorderThickness="0" SelectionChanged="Guest_Changed" Margin="0,7,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Room, StringFormat='Hab. {0}'}" FontWeight="SemiBold"/><TextBlock Text="{Binding Floor, StringFormat='Piso {0}'}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Package}" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Role}" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Reservation, StringFormat='Reserva {0}'}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Grid></Border>
</UserControl>

