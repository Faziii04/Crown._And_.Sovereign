<Window x:Class="Crown___Sovereign.Views.Dialogs.Administracion.HabitacionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Habitación" Width="560" Height="560" MinHeight="500" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="DialogTitle" Text="Nueva habitación" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Configura el número, tipo, capacidad y comodidades." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><StackPanel><TextBlock Text="Número de habitación"/><TextBox x:Name="NumberBox"/><TextBlock Text="Piso" Margin="3,8,0,0"/><ComboBox x:Name="FloorBox"/><TextBlock Text="Tipo de habitación" Margin="3,8,0,0"/><ComboBox x:Name="TypeBox"/><TextBlock Text="Capacidad" Margin="3,8,0,0"/><ComboBox x:Name="CapacityBox"/><TextBlock Text="Comodidades" Margin="3,8,0,0"/><TextBox x:Name="AmenitiesBox"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="3,8,0,0"/></StackPanel></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Guardar habitación" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
