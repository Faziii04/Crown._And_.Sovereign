<Window x:Class="Crown___Sovereign.Views.Dialogs.Administracion.EmpleadoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nuevo empleado" Width="430" Height="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource Canvas}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Registrar empleado" FontSize="23" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,18"><TextBlock Text="Nombre completo"/><TextBox x:Name="NameBox" Margin="0,4,0,12"/><TextBlock Text="Cargo"/><ComboBox x:Name="RoleBox" IsEditable="True" Margin="0,4,0,12"/><TextBlock Text="Correo"/><TextBox x:Name="EmailBox" Margin="0,4,0,12"/><TextBlock Text="Teléfono"/><TextBox x:Name="PhoneBox" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="Guardar" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid></Window>
