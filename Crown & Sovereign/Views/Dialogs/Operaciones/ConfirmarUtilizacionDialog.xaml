<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.ConfirmarUtilizacionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Confirmar utilización" Width="520" Height="440" MinHeight="360" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Confirmar utilización" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Confirma que el huésped recibió el servicio." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><StackPanel><TextBlock x:Name="GuestText" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ServiceText" Margin="0,6,0,0"/><TextBlock x:Name="CoverageText" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="ChargeText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Margin="0,14,0,0"/></StackPanel></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Confirmar uso" IsDefault="True" Click="Confirm_Click"/></StackPanel></Grid>
</Window>
