<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.ProductoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Producto" Width="440" Height="540" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource Canvas}">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="TitleText" Text="Nuevo producto" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Datos de catálogo y nivel de reposición" Foreground="{StaticResource Muted}" Margin="0,4,0,18"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Nombre"/><TextBox x:Name="NameBox" Margin="0,4,0,12"/><TextBlock Text="Categoría"/><ComboBox x:Name="CategoryBox" IsEditable="True" Margin="0,4,0,12"/><TextBlock Text="Precio de venta (Bs)"/><TextBox x:Name="PriceBox" Margin="0,4,0,12"/><TextBlock Text="Existencia inicial"/><TextBox x:Name="StockBox" Margin="0,4,0,12"/><TextBlock Text="Stock mínimo"/><TextBox x:Name="MinimumBox" Margin="0,4,0,12"/><CheckBox x:Name="IncludedBox" Content="Incluido en paquetes del huésped" Margin="0,4"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="Guardar" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid>
</Window>
