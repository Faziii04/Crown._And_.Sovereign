<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.ObjetoOlvidadoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registrar objeto encontrado" Width="430" Height="430" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource Canvas}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Nuevo objeto" FontSize="23" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,18"><TextBlock Text="Descripción del objeto"/><TextBox x:Name="DescriptionBox" Margin="0,4,0,12"/><TextBlock Text="Habitación encontrada"/><ComboBox x:Name="RoomBox" DisplayMemberPath="Numero" Margin="0,4,0,12"/><TextBlock Text="Observaciones"/><TextBox x:Name="NotesBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="Guardar" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid></Window>
