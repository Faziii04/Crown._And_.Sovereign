<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.SolicitudServicioDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Solicitar servicio" Width="590" Height="590" MinHeight="500" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Solicitar servicio" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="La solicitud queda pendiente de coordinación. No confirma horario ni genera cargos." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Huésped" Foreground="{StaticResource Muted}"/><TextBlock x:Name="GuestText" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Servicio" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock x:Name="ServiceText" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CoverageText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/><StackPanel x:Name="AppointmentFields"><TextBlock Text="Horario preferido (se confirma posteriormente)" FontWeight="SemiBold" Margin="3,14,0,0"/><DatePicker x:Name="DatePicker"/><TextBlock Text="Hora preferida" FontWeight="SemiBold" Margin="3,8,0,0"/><ComboBox x:Name="TimePicker"/></StackPanel><StackPanel x:Name="TransferFields"><TextBlock Text="Origen" FontWeight="SemiBold" Margin="3,12,0,0"/><TextBox x:Name="OriginBox"/><TextBlock Text="Destino" FontWeight="SemiBold" Margin="3,8,0,0"/><TextBox x:Name="DestinationBox"/><TextBlock Text="Pasajeros" FontWeight="SemiBold" Margin="3,8,0,0"/><TextBox x:Name="PassengersBox" Text="1"/><TextBlock Text="Contacto de coordinación (opcional)" FontWeight="SemiBold" Margin="3,8,0,0"/><TextBox x:Name="ContactBox"/></StackPanel><TextBlock Text="Solicitud u observaciones" FontWeight="SemiBold" Margin="3,12,0,0"/><TextBox x:Name="DescriptionBox" AcceptsReturn="True" Height="72" VerticalContentAlignment="Top" TextWrapping="Wrap"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="3,8,0,0"/></StackPanel></ScrollViewer></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Enviar solicitud" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
