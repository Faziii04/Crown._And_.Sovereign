<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.NuevaCitaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nueva cita" Width="560" Height="610" MinHeight="560" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Programar nueva cita" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Selecciona el huésped, estancia, servicio y responsable correctos." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><StackPanel><TextBlock Text="Huésped alojado" FontWeight="SemiBold"/><ComboBox x:Name="GuestBox" DisplayMemberPath="Name" SelectionChanged="Guest_Changed"/><TextBlock x:Name="StayText" Foreground="{StaticResource Muted}" Margin="2,5,0,0"/><TextBlock Text="Servicio con cita" FontWeight="SemiBold" Margin="3,14,0,0"/><ComboBox x:Name="ServiceBox" DisplayMemberPath="Nombre" SelectionChanged="Service_Changed"/><TextBlock Text="Fecha" FontWeight="SemiBold" Margin="3,12,0,0"/><DatePicker x:Name="DatePicker"/><TextBlock Text="Hora" FontWeight="SemiBold" Margin="3,8,0,0"/><ComboBox x:Name="TimePicker"/><TextBlock Text="Responsable" FontWeight="SemiBold" Margin="3,8,0,0"/><ComboBox x:Name="EmployeePicker" DisplayMemberPath="Nombre"/><TextBlock x:Name="EmployeeHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="3,3,0,0"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="3,8,0,0"/></StackPanel></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Programar" IsDefault="True" Click="Save_Click"/></StackPanel></Grid>
</Window>
