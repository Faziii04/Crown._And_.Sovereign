<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.OrdenMantenimientoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Crear orden de trabajo" Width="420" Height="340" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource Canvas}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Orden de trabajo" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="IncidentText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Asignado a"/><TextBox x:Name="AssigneeBox" Margin="0,4,0,12"/><TextBlock Text="Fecha estimada"/><DatePicker x:Name="DatePicker" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="Crear orden" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid></Window>
