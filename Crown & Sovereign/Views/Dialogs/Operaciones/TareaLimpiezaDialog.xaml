<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.TareaLimpiezaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nueva tarea de limpieza" Width="420" Height="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource Canvas}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Nueva tarea" FontSize="23" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,18"><TextBlock Text="Habitación"/><ComboBox x:Name="RoomBox" DisplayMemberPath="Numero" Margin="0,4,0,12"/><TextBlock Text="Tipo"/><ComboBox x:Name="TypeBox" Margin="0,4,0,12"/><TextBlock Text="Responsable"/><TextBox x:Name="EmployeeBox" Text="Equipo de limpieza" Margin="0,4,0,12"/><TextBlock Text="Prioridad"/><ComboBox x:Name="PriorityBox" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="Guardar" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid></Window>
