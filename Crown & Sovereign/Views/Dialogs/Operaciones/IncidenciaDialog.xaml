<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.IncidenciaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reportar incidencia" Width="430" Height="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource Canvas}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Reportar incidencia" FontSize="23" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,18"><TextBlock Text="Habitación"/><ComboBox x:Name="RoomBox" DisplayMemberPath="Numero" Margin="0,4,0,12"/><TextBlock Text="Descripción"/><TextBox x:Name="DescriptionBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="Prioridad"/><ComboBox x:Name="PriorityBox" Margin="0,4,0,12"/><CheckBox x:Name="BlockBox" Content="Bloquear habitación por seguridad"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="Guardar" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid></Window>
