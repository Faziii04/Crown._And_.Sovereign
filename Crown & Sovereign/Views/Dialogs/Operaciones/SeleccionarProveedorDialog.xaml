<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.SeleccionarProveedorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Asignar proveedor externo" Width="650" Height="590" MinWidth="540" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="Seleccionar proveedor" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="IntroText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="PriceText" Foreground="{StaticResource Information}" Margin="0,0,0,8"/><ListBox x:Name="ProviderList" Grid.Row="1" SelectionChanged="Provider_Changed" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding EmpresaConvenio}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Vigencia}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/><TextBlock Text="{Binding Relacion.Observaciones}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Relacion.CostoProveedor, StringFormat=Bs {0:N2}}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/><TextBlock Text="Costo proveedor" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/><TextBlock Text="{Binding MargenEstimado, StringFormat=Margen a precio catálogo · Bs {0:N2}}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" Margin="0,6,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyText" Grid.Row="1" Text="No hay proveedores elegibles para el servicio en la fecha prevista. Revisa los convenios antes de completar la atención." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed"/><StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock x:Name="WarningText" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/><TextBlock Text="La vigencia del convenio no confirma disponibilidad del proveedor. Confirma externamente antes de completar la coordinación." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" Padding="14,7"/><Button x:Name="ConfirmButton" Content="Asignar y continuar" IsDefault="True" Padding="15,7" Margin="8,0,0,0" Click="Confirm_Click" IsEnabled="False"/></StackPanel>
    </Grid>
</Window>
