<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.ServicioDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configuración del servicio" Width="920" Height="720" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="DialogTitle" Text="Nuevo servicio" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Configura la información, operación y precio oficial. Las relaciones comerciales se administran en sus secciones correspondientes." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel>
  <TabControl x:Name="Steps" Grid.Row="1" SelectionChanged="Steps_SelectionChanged">
   <TabItem Header="1 · Información"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="Información general" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nombre" Margin="0,12,0,2"/><TextBox x:Name="NameBox"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Categoría" Margin="0,8,0,2"/><ComboBox x:Name="CategoryBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Servicio padre (opcional)" Margin="0,8,0,2"/><ComboBox x:Name="ParentBox" DisplayMemberPath="Nombre"/></StackPanel></Grid><TextBlock Text="Descripción" Margin="0,8,0,2"/><TextBox x:Name="DescriptionBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/><TextBlock x:Name="HierarchyPreview" Foreground="{StaticResource Muted}" Margin="2,8"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="2 · Operación"><StackPanel Margin="18"><TextBlock Text="Configuración operativa" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="ActiveCheck" Content="Servicio activo" Margin="4,14,4,4"/><TextBlock Text="Los elementos organizativos pueden estar activos sin ser ofertas independientes." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,0,4,8"/><CheckBox x:Name="ReservableCheck" Content="Se puede solicitar o adquirir individualmente" Margin="4,4"/><CheckBox x:Name="AppointmentCheck" Content="Requiere coordinación de cita" Margin="4,10,4,4"/><StackPanel Orientation="Horizontal" Margin="4,8"><TextBlock Text="Duración estimada" VerticalAlignment="Center"/><TextBox x:Name="DurationBox" Width="100" Margin="8,0"/><TextBlock Text="minutos · valor libre, mínimo 15 si requiere cita" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Reservable no significa disponible a una hora concreta. La disponibilidad depende de empleados, citas, acuerdos y condiciones operativas." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,14,4,0"/></StackPanel></TabItem>
   <TabItem Header="3 · Comercial"><StackPanel Margin="18"><TextBlock Text="Configuración comercial" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Precio oficial al huésped (Bs)" Margin="0,14,0,3"/><TextBox x:Name="PriceBox" Width="220" HorizontalAlignment="Left"/><TextBlock Text="Un precio igual a cero identifica un servicio sin cargo. El costo del proveedor y la cobertura de paquete pertenecen a sus relaciones y no cambian este precio." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="3,5,3,14"/><TextBlock Text="Cobertura de paquetes" FontWeight="SemiBold"/><TextBlock Text="Se consulta en la ficha Comercial y se modifica desde Paquetes y promociones, donde cada paquete mantiene su propia cobertura." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="Proveedores y costos" FontWeight="SemiBold"/><TextBlock Text="Se consultan en la ficha Comercial y se modifican desde Convenios. Cambiar el precio del huésped no altera costos externos." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/></StackPanel></TabItem>
   <TabItem Header="4 · Confirmación"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="Confirma la configuración" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ConfirmationText" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Los precios de servicios ya adquiridos, beneficios de reservas confirmadas, duración de citas existentes e historial no se recalculan al guardar." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,10"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Left" Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PreviousButton" Content="Anterior" Style="{StaticResource SecondaryButton}" Click="Previous_Click" IsEnabled="False"/><Button x:Name="NextButton" Content="Siguiente" Click="Next_Click"/><Button x:Name="SaveButton" Content="Guardar servicio" Click="Save_Click" Visibility="Collapsed"/></StackPanel></DockPanel>
 </Grid>
</Window>
