<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.ServicioDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Servicio" Width="640" Height="740" MinHeight="650" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="DialogTitle" Text="Nuevo servicio" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Define la jerarquía, cobertura y requisitos operativos." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Nombre"/><TextBox x:Name="NameBox"/><TextBlock Text="Categoría" Margin="3,7,0,0"/><ComboBox x:Name="CategoryBox"/><TextBlock Text="Servicio principal" Margin="3,7,0,0"/><ComboBox x:Name="ParentBox" DisplayMemberPath="Nombre"/><TextBlock Text="Proveedor responsable" Margin="3,7,0,0"/><ComboBox x:Name="ProviderBox"/><TextBlock Text="Precio de referencia (Bs)" Margin="3,7,0,0"/><TextBox x:Name="PriceBox"/><CheckBox x:Name="AppointmentCheck" Content="Requiere cita" Margin="5,8"/><TextBlock Text="Duración estimada (minutos)" Margin="3,4,0,0"/><ComboBox x:Name="DurationBox"/><TextBlock Text="Cobertura de paquete" Margin="3,7,0,0"/><ComboBox x:Name="CoverageBox"/><TextBlock Text="Usos incluidos" Margin="3,7,0,0"/><TextBox x:Name="UsesBox" ToolTip="Vacío para cobertura ilimitada o sin límite definido"/><TextBlock Text="Producto relacionado" Margin="3,7,0,0"/><ComboBox x:Name="ProductBox" DisplayMemberPath="Nombre"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="3,8,0,0"/></StackPanel></ScrollViewer></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Guardar servicio" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
