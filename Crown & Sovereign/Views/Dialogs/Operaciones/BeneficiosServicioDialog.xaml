<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.BeneficiosServicioDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Beneficios de servicios" Width="850" Height="620" MinHeight="520" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Beneficios adquiridos" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="GuestText" Foreground="{StaticResource Muted}" Margin="0,3,0,12"/></StackPanel><DataGrid x:Name="BenefitsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Servicio" Binding="{Binding Service}" Width="90"/><DataGridTextColumn Header="Cobertura" Binding="{Binding Benefit.Label}" Width="190"/><DataGridTextColumn Header="Disponibilidad" Binding="{Binding Benefit.Remaining}" Width="110"/><DataGridTextColumn Header="Paquete adquirido" Binding="{Binding Benefit.PackageNames}" Width="*"/><DataGridTextColumn Header="Detalle" Binding="{Binding Benefit.Detail}" Width="2*"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="Cerrar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True"/></Grid>
</Window>
