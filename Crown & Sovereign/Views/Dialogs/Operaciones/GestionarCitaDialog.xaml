<Window x:Class="Crown___Sovereign.Views.Dialogs.Operaciones.GestionarCitaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gestionar cita" Width="560" Height="530" MinHeight="460" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Gestionar cita" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Inicia, completa, reprograma o cierra la cita." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><StackPanel><TextBlock x:Name="GuestText" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ServiceText" Margin="0,6,0,0"/><TextBlock x:Name="DateText" Margin="0,6,0,0"/><TextBlock x:Name="EmployeeText" Margin="0,6,0,0"/><Border Background="#F1F5F9" Padding="10" CornerRadius="5" Margin="0,14,0,0"><TextBlock x:Name="StatusText" FontWeight="SemiBold"/></Border><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="3,10,0,0"/></StackPanel></Border><Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Cancelar cita" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="Cancel_Click"/><Button Grid.Column="1" Content="Reprogramar" Style="{StaticResource SecondaryButton}" Click="Reschedule_Click"/><Button Grid.Column="2" Content="No presentado" Style="{StaticResource SecondaryButton}" Click="NoShow_Click"/><Button Grid.Column="3" x:Name="PrimaryAction" Click="Primary_Click"/></Grid></Grid>
</Window>
