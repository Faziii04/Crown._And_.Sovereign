<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.CargoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Agregar cargo" Width="520" Height="440" MinHeight="380" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Agregar cargo al folio" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Registra un cargo manual con concepto e importe." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><StackPanel><TextBlock Text="Concepto"/><TextBox x:Name="ConceptBox"/><TextBlock Text="Importe (Bs)" Margin="3,10,0,0"/><TextBox x:Name="AmountBox"/><TextBlock Text="El cargo aparecerá en movimientos y saldo del folio." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="3,12,0,0"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="3,10,0,0"/></StackPanel></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Agregar cargo" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
