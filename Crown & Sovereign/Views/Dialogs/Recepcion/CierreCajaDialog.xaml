<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.CierreCajaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reconciliar turno de caja" Width="920" Height="760" MinWidth="780" MinHeight="650" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Cerrar turno de caja" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ShiftText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,14,8"><TextBlock Text="Efectivo esperado" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Composición del turno" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><TextBlock x:Name="OpeningText" Margin="0,10,0,0"/><TextBlock x:Name="CashText" Margin="0,5,0,0"/><TextBlock x:Name="RefundText" Margin="0,5,0,0"/><TextBlock x:Name="CancellationText" Margin="0,5,0,0"/><Separator Margin="0,10"/><TextBlock x:Name="ExpectedText" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/><TextBlock Text="Pagos electrónicos (no forman parte del conteo físico)" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock x:Name="NonCashText" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="14,0,0,8"><TextBlock Text="Conteo físico" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Efectivo contado (Bs)" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/><TextBox x:Name="CountedBox" FontSize="21" TextChanged="Counted_Changed"/><TextBlock x:Name="DifferenceText" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,2"/><Expander Header="Contar por denominaciones (opcional)" Margin="0,8,0,0"><StackPanel><DataGrid x:Name="DenominationGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="205" Margin="0,6"><DataGrid.Columns><DataGridTextColumn Header="Denominación" Binding="{Binding TextoDenominacion}" IsReadOnly="True" Width="*"/><DataGridTemplateColumn Header="Cantidad" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" TextChanged="Denomination_Changed" HorizontalContentAlignment="Right"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='Bs {0:N2}'}" IsReadOnly="True" Width="145"/></DataGrid.Columns></DataGrid><Button Content="Utilizar total contado" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="UseDenominations_Click"/></StackPanel></Expander></StackPanel>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Observaciones" FontWeight="SemiBold"/><TextBox x:Name="NotesBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,5,0,0"/><TextBlock x:Name="PendingOperationsText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><TextBlock x:Name="ValidationText" Grid.Column="1" Foreground="{StaticResource Danger}" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="10,0,0,4"/></Grid>
        </Grid></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Confirmar cierre" IsDefault="True" Click="CloseShift_Click"/></StackPanel>
    </Grid>
</Window>
