<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.ContactarEsperaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registrar contacto" Width="520" Height="500" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Registrar contacto" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="GuestText" Foreground="{StaticResource Muted}" Margin="0,4,0,16"/></StackPanel><TextBlock Grid.Row="1" Text="Medio"/><ComboBox x:Name="MediumBox" Grid.Row="1" Margin="0,22,0,10"/><TextBlock Grid.Row="2" Text="Resultado"/><ComboBox x:Name="ResultBox" Grid.Row="2" Margin="0,22,0,10"/><TextBlock Grid.Row="3" Text="Notas"/><TextBox x:Name="NotesBox" Grid.Row="4" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,8,0,0"/><StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button Content="Guardar registro" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid>
</Window>
