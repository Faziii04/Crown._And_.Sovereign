<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.HuespedDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Huésped" Width="590" Height="560" MinHeight="500" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="DialogTitle" Text="Registrar huésped" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="La información se comparte con reservas y estancias." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><StackPanel><TextBlock Text="Nombre completo"/><TextBox x:Name="NameBox"/><TextBlock Text="Documento" Margin="3,8,0,0"/><DockPanel><TextBox x:Name="DocumentBox"/><Button x:Name="FindDocumentButton" Content="Buscar existente" Click="FindDocument_Click" Margin="6,0,0,0"/></DockPanel><TextBlock x:Name="DuplicateText" Foreground="{StaticResource Primary}" TextWrapping="Wrap" Margin="0,5"/><Button x:Name="UseExistingButton" Content="Usar este huésped" HorizontalAlignment="Left" Visibility="Collapsed" Click="UseExisting_Click"/><TextBlock Text="Correo electrónico" Margin="3,8,0,0"/><TextBox x:Name="EmailBox"/><TextBlock Text="Teléfono" Margin="3,8,0,0"/><TextBox x:Name="PhoneBox"/><CheckBox x:Name="ConsentCheck" Content="Consentimiento para tratamiento de datos registrado" Margin="4,14"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/></StackPanel></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Guardar huésped" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
