<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.SolicitudRecursoEstanciaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Solicitar recurso adicional" Width="520" Height="570" MinWidth="460" MinHeight="500" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Solicitar recurso adicional" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ContextText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="Recurso" FontWeight="SemiBold"/><ComboBox x:Name="ResourceBox" DisplayMemberPath="Nombre" SelectionChanged="Resource_Changed" Margin="0,5,0,12"/><TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AvailabilityText" Margin="0,10,0,0" FontWeight="SemiBold"/><TextBlock Text="Cantidad adicional" Margin="0,12,0,3"/><StackPanel Orientation="Horizontal"><Button Content="−" Click="Decrease_Click" Style="{StaticResource SecondaryButton}"/><TextBlock x:Name="QuantityText" Text="1" VerticalAlignment="Center" Margin="14,0" FontSize="18"/><Button Content="＋" Click="Increase_Click" Style="{StaticResource SecondaryButton}"/></StackPanel><TextBlock Text="Observaciones de preparación" FontWeight="SemiBold" Margin="0,14,0,4"/><TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"/><TextBlock x:Name="PriceText" FontWeight="SemiBold" FontSize="17" Margin="0,12,0,0"/><TextBlock x:Name="WarningText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button x:Name="SaveButton" Content="Confirmar solicitud" IsDefault="True" Click="Save_Click"/></StackPanel></Grid>
</Window>
