<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.PagoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Registrar pago" Width="760" Height="640" MinWidth="650" MinHeight="560" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Registrar pago" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="AccountText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Saldo pendiente" Foreground="{StaticResource Muted}"/><TextBlock x:Name="BalanceText" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/></StackPanel><TextBlock x:Name="ShiftText" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid>
            <Grid Grid.Row="1" Margin="0,14,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Medio de pago" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Importe (Bs)" FontWeight="SemiBold"/><TextBlock Grid.Column="2"/></Grid><DataGrid x:Name="PartsGrid" Grid.Row="1" ItemsSource="{Binding Parts}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="None" RowHeight="42" Margin="0,6,0,0"><DataGrid.Columns>
                <DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.Metodos}" SelectedItem="{Binding Metodo, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding MontoTexto, UpdateSourceTrigger=PropertyChanged}" TextChanged="PartAmount_Changed" HorizontalContentAlignment="Right"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Quitar" Tag="{Binding}" Click="RemovePart_Click" Style="{StaticResource SecondaryButton}" Padding="5,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns></DataGrid></Grid>
            <Button Grid.Row="2" Content="＋ Añadir medio de pago" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="AddPart_Click"/>
            <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Referencia de operación (si corresponde)" Foreground="{StaticResource Muted}"/><TextBox x:Name="ReferenceBox"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="22,0,0,0"><TextBlock Text="Total a registrar" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TotalText" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Saldo posterior" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock x:Name="RemainingText" FontSize="18" FontWeight="SemiBold"/></StackPanel></Grid>
        </Grid></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button Content="Confirmar pago" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
