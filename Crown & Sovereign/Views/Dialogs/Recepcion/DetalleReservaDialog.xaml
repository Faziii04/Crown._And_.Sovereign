<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.DetalleReservaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Detalle de reserva" Width="560" Height="500" MinHeight="440" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="TitleText" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Resumen de la reserva y estado actual." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><StackPanel><TextBlock x:Name="GuestText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RoomText" Margin="0,8,0,0"/><TextBlock x:Name="DatesText" Margin="0,5,0,0"/><TextBlock x:Name="ChannelText" Margin="0,5,0,0"/><TextBlock x:Name="PackageText" Margin="0,5,0,0"/><Border Background="#F1F5F9" CornerRadius="5" Padding="10" Margin="0,16,0,0"><TextBlock x:Name="StatusText" FontWeight="SemiBold"/></Border></StackPanel></Border>
        <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CancelReservationButton" Content="Cancelar reserva" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource Danger}" HorizontalAlignment="Left" Click="CancelReservation_Click"/><Button Grid.Column="1" Content="Cerrar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Grid.Column="2" Content="Editar reserva" Click="EditReservation_Click"/></Grid>
    </Grid>
</Window>
