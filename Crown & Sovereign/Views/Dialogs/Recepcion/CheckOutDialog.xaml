<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.CheckOutDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Check-out" Width="560" Height="510" MinHeight="440" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Confirmar check-out" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Revisa la estancia y el saldo antes de liberar la habitación." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="18"><StackPanel><TextBlock x:Name="GuestText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RoomText" Foreground="{StaticResource Muted}" Margin="0,5,0,14"/><TextBlock Text="Saldo pendiente" Foreground="{StaticResource Muted}"/><TextBlock x:Name="BalanceText" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="3,14,0,0"/><TextBlock Text="Al confirmar, la estancia finalizará y la habitación quedará pendiente de limpieza." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="3,16,0,0"/></StackPanel></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Volver" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Confirmar check-out" IsDefault="True" Click="Confirm_Click"/></StackPanel>
    </Grid>
</Window>
