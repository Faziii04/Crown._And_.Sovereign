<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.CheckOutDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Preparar salida" Width="760" Height="690" MinWidth="620" MinHeight="560" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="TitleText" Text="Preparar salida" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Verifica el folio y revisa las condiciones operativas antes de cerrar la estancia." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16"><Grid><Grid x:Name="PreparationPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="GuestText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RoomText" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/><TextBlock x:Name="DepartureText" Foreground="{StaticResource Muted}" Margin="0,3,0,12"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Verificaciones" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ChecklistText" TextWrapping="Wrap" Margin="0,9,0,0"/><TextBlock x:Name="WarningsText" Foreground="#8A5B18" Background="#FFF4DB" TextWrapping="Wrap" Padding="8" Margin="0,9,0,0"/><WrapPanel Margin="0,6,0,0"><Button Content="Ver folio" Tag="1" Click="Context_Click" Style="{StaticResource SecondaryButton}" Padding="7,4"/><Button Content="Ver servicios" Tag="2" Click="Context_Click" Style="{StaticResource SecondaryButton}" Padding="7,4"/><Button Content="Ver recursos" Tag="4" Click="Context_Click" Style="{StaticResource SecondaryButton}" Padding="7,4"/><Button Content="Ver llaves" Tag="5" Click="Context_Click" Style="{StaticResource SecondaryButton}" Padding="7,4"/></WrapPanel><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel><Border Grid.Column="1" Background="{StaticResource Canvas}" CornerRadius="7" Padding="14"><StackPanel><TextBlock Text="Resumen financiero" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Total cargos" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/><TextBlock x:Name="ChargesText" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Total pagado" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock x:Name="PaidText" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Saldo pendiente" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock x:Name="BalanceText" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/><Button x:Name="PayButton" Content="Registrar pago" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" Click="Pay_Click"/><Button Content="Consultar folio" Style="{StaticResource SecondaryButton}" Margin="0,5,0,0" Click="Folio_Click"/></StackPanel></Border></Grid><TextBlock Grid.Row="2" Text="El saldo positivo es un bloqueo obligatorio. Llaves, recursos y solicitudes pendientes son avisos operativos y no se cambian automáticamente." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/></Grid>
    <StackPanel x:Name="CompletionPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Salida completada" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="CompletedGuest" FontSize="18" Margin="0,8,0,0" HorizontalAlignment="Center"/><TextBlock x:Name="CompletedAt" Foreground="{StaticResource Muted}" Margin="0,4,0,0" HorizontalAlignment="Center"/><TextBlock x:Name="CompletedFolio" Margin="0,14,0,0" HorizontalAlignment="Center"/><TextBlock x:Name="CompletedBalance" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" HorizontalAlignment="Center"/><TextBlock x:Name="CompletedRooms" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
  </Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button x:Name="ConfirmButton" Content="Confirmar check-out" IsDefault="True" Click="Confirm_Click"/><Button x:Name="DoneButton" Content="Listo" Visibility="Collapsed" Click="Done_Click"/></StackPanel>
 </Grid>
</Window>
