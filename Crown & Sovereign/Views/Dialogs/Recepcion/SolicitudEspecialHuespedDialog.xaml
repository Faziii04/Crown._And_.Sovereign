<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.SolicitudEspecialHuespedDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Solicitud especial" Width="500" Height="390" WindowStartupLocation="CenterOwner" Background="#F4F6F8"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Registrar solicitud especial" FontSize="22" FontWeight="SemiBold"/><Border Grid.Row="1" Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,12"><StackPanel><TextBlock Text="Reserva asociada"/><ComboBox x:Name="ReservationBox" DisplayMemberPath="Id" Margin="0,4,0,10"/><TextBlock Text="Descripción"/><TextBox x:Name="DescriptionBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="La solicitud se vincula a la reserva; el sistema no registra quién del grupo la originó." Foreground="#64748B" TextWrapping="Wrap"/><TextBlock x:Name="ErrorText" Foreground="#B65757"/></StackPanel></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Margin="0,0,6,0"/><Button Content="Registrar" IsDefault="True" Click="Save_Click"/></StackPanel></Grid></Window>
