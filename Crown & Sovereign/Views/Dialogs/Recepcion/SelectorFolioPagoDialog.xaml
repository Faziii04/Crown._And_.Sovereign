<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.SelectorFolioPagoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Seleccionar folio" Width="980" Height="650" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Seleccionar folio" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="DescriptionText" Text="Elige la cuenta que recibirá el pago." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,10"><TextBox x:Name="SearchBox" Width="400" ToolTip="Huésped, documento, habitación, reserva o folio" TextChanged="Search_Changed"/><ComboBox x:Name="FilterBox" Width="200" SelectionChanged="Filter_Changed"/></StackPanel>
        <DataGrid x:Name="FoliosGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Folio_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Huésped principal" Binding="{Binding Huésped}" Width="*"/><DataGridTextColumn Header="Cuenta" Binding="{Binding Contexto}" Width="180"/><DataGridTextColumn Header="Habitación" Binding="{Binding Habitación}" Width="120"/><DataGridTextColumn Header="Folio" Binding="{Binding FolioId}" Width="90"/><DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/><DataGridTextColumn Header="Saldo pendiente" Binding="{Binding Saldo, StringFormat='Bs {0:N2}'}" Width="145"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button Content="Seleccionar folio" IsDefault="True" Click="Select_Click"/></StackPanel>
    </Grid>
</Window>
