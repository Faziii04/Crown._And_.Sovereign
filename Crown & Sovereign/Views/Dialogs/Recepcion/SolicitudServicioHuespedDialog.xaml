<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.SolicitudServicioHuespedDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Solicitar servicio" Width="520" Height="500" WindowStartupLocation="CenterOwner" Background="#F4F6F8"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="TitleText" Text="Solicitar servicio" FontSize="22" FontWeight="SemiBold"/><Border Grid.Row="1" Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,12"><StackPanel><TextBlock Text="Servicio"/><ComboBox x:Name="ServiceBox" DisplayMemberPath="Nombre" SelectionChanged="Service_Changed" Margin="0,4,0,10"/><TextBlock x:Name="AppointmentHint" Foreground="#AD7B34" TextWrapping="Wrap"/><TextBlock Text="Fecha y hora deseadas (si requiere cita)" Margin="0,10,0,4"/><DatePicker x:Name="DateBox"/><TextBox x:Name="TimeBox" Text="15:00" Margin="0,5,0,10"/><TextBlock Text="Detalle de la solicitud"/><TextBox x:Name="DescriptionBox" Height="75" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4"/><TextBlock x:Name="ErrorText" Foreground="#B65757" TextWrapping="Wrap"/></StackPanel></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Margin="0,0,6,0"/><Button Content="Enviar solicitud" IsDefault="True" Click="Save_Click"/></StackPanel></Grid></Window>
