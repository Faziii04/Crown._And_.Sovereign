<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.SolicitudServicioHuespedDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Solicitar servicio" Width="560" Height="620" MinWidth="500" MinHeight="540" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="TitleText" Text="Solicitar servicio" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="StayText" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,12"><StackPanel><TextBlock x:Name="GuestLabel" Text="Huésped"/><ComboBox x:Name="GuestBox" DisplayMemberPath="Nombre" Margin="0,4,0,10"/><TextBlock Text="Servicio"/><ComboBox x:Name="ServiceBox" DisplayMemberPath="Nombre" SelectionChanged="Service_Changed" Margin="0,4,0,8"/><TextBlock x:Name="CoverageText" Foreground="{StaticResource Primary}" TextWrapping="Wrap"/><TextBlock x:Name="AppointmentHint" Foreground="#AD7B34" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="Fecha y hora deseadas (no es confirmación de horario)" Margin="0,10,0,4"/><DatePicker x:Name="DateBox"/><TextBox x:Name="TimeBox" Text="15:00" Margin="0,5,0,10"/><TextBlock Text="Observaciones"/><TextBox x:Name="DescriptionBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4"/><TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/></StackPanel></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/><Button Content="Enviar solicitud" IsDefault="True" Click="Save_Click"/></StackPanel></Grid></Window>
