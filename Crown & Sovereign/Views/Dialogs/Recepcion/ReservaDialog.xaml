<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.ReservaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wizard="clr-namespace:Crown___Sovereign.Views.UserControls.Recepcion.Reservas.Wizard" Title="Nueva reserva" Width="1140" Height="780" MinWidth="0" MinHeight="0" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock x:Name="DialogTitle" Text="Nueva reserva" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Completa los pasos y revisa el importe estimado antes de guardar." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
   <TabControl x:Name="WizardTabs" Grid.Column="0" Margin="0,0,14,0" SelectedIndex="0">
    <TabItem Header="1 · Estancia"><wizard:PasoEstanciaControl x:Name="StayStep"/></TabItem>
    <TabItem Header="2 · Habitaciones"><wizard:PasoHabitacionesControl x:Name="RoomsStep"/></TabItem>
    <TabItem Header="3 · Huéspedes"><wizard:PasoHuespedesControl x:Name="GuestsStep"/></TabItem>
    <TabItem Header="4 · Adicionales"><wizard:PasoAdicionalesControl x:Name="ExtrasStep"/></TabItem>
    <TabItem Header="5 · Revisar"><wizard:PasoResumenReservaControl x:Name="ReviewStep"/></TabItem>
   </TabControl>
   <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Resumen de reserva" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="StayDurationAside" Foreground="{StaticResource Muted}" Margin="0,9,0,3"/><TextBlock x:Name="RateSummary" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Separator Margin="0,8"/><TextBlock Text="Alojamiento" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LodgingAmount" FontWeight="SemiBold"/><TextBlock Text="Paquetes" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock x:Name="PackageSummary" Text="Sin paquete" TextWrapping="Wrap"/><TextBlock x:Name="PackageAmount" FontWeight="SemiBold"/><TextBlock Text="Recursos adicionales" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock x:Name="ResourceAmount" FontWeight="SemiBold"/><TextBlock Text="Servicios adicionales" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock x:Name="ServiceAmount" FontWeight="SemiBold"/><TextBlock Text="Descuentos" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock x:Name="DiscountAmount" FontWeight="SemiBold"/><TextBlock Text="Impuestos" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock x:Name="TaxAmount" FontWeight="SemiBold"/><Separator Margin="0,10"/><TextBlock x:Name="PricingWarning" Foreground="{StaticResource Danger}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="TOTAL DE RESERVA" Foreground="{StaticResource Muted}"/><TextBlock x:Name="EstimatedTotal" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Primary}" TextWrapping="Wrap"/><Button Content="Ver desglose completo" Style="{StaticResource SecondaryButton}" Click="ShowBreakdown_Click" Margin="0,9,0,0"/><TextBlock Text="Los pagos y anticipos son independientes del precio acordado." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button x:Name="PreviousStepButton" Grid.Column="2" Content="‹ Anterior" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="PreviousStep_Click"/><Button x:Name="NextStepButton" Grid.Column="3" Content="Siguiente ›" Margin="8,0,0,0" Click="NextStep_Click"/><Button x:Name="SavePendingButton" Grid.Column="4" Content="Guardar pendiente" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="SavePending_Click"/><Button x:Name="SaveButton" Grid.Column="5" Content="Confirmar reserva" IsDefault="True" Margin="8,0,0,0" Click="Save_Click"/></Grid>
 </Grid>
</Window>
