<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.ExtenderEstanciaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Extender estancia" Width="620" Height="600" MinWidth="520" MinHeight="500" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Extender estancia" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="GuestText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="Salida prevista actual" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CurrentDepartureText" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,12"/><TextBlock Text="Nueva fecha de salida" FontWeight="SemiBold"/><DatePicker x:Name="DeparturePicker" SelectedDateChanged="Date_Changed" Margin="0,5,0,12"/><TextBlock x:Name="RoomAvailabilityText" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBlock Text="Desglose económico" FontWeight="SemiBold"/><TextBlock x:Name="LodgingText" Margin="0,6,0,0"/><TextBlock x:Name="ResourcesText" Margin="0,3,0,0"/><TextBlock Text="Los beneficios por estancia del paquete no se multiplican automáticamente. Las condiciones y usos adquiridos se conservan." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock x:Name="TotalText" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button x:Name="ConfirmButton" Content="Confirmar extensión" IsDefault="True" Click="Confirm_Click"/></StackPanel></Grid>
</Window>
