<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.CierreCompletadoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cierre de caja completado" Width="570" Height="510" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Turno cerrado" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="DateText" Foreground="{StaticResource Muted}" Margin="0,3,0,14"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="22"><StackPanel><TextBlock x:Name="ShiftText" FontWeight="SemiBold"/><Separator Margin="0,12"/><TextBlock x:Name="OpeningText" Margin="0,4"/><TextBlock x:Name="CashText" Margin="0,4"/><TextBlock x:Name="RefundText" Margin="0,4"/><TextBlock x:Name="CancellationText" Margin="0,4"/><TextBlock x:Name="ExpectedText" Margin="0,4"/><TextBlock x:Name="CountedText" Margin="0,4"/><Separator Margin="0,12"/><TextBlock x:Name="DifferenceText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cerrar" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button Content="Imprimir resumen" Click="Print_Click"/></StackPanel></Grid>
</Window>
