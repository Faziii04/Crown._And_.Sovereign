<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.DetalleTurnoCajaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Detalle de turno" Width="1050" Height="700" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><UniformGrid Grid.Row="1" Columns="4" Margin="-4,0,0,10"><Border Background="White" Padding="10" Margin="4"><StackPanel><TextBlock Text="Fondo inicial" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OpeningText" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="10" Margin="4"><StackPanel><TextBlock Text="Efectivo esperado" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ExpectedText" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="10" Margin="4"><StackPanel><TextBlock Text="Efectivo contado" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CountedText" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border><Border Background="White" Padding="10" Margin="4"><StackPanel><TextBlock Text="Diferencia" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DifferenceText" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid><DataGrid x:Name="MovementsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="125"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Folio" Binding="{Binding FolioId}" Width="80"/><DataGridTextColumn Header="Método" Binding="{Binding Metodo}" Width="120"/><DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="1.5*"/><DataGridTextColumn Header="Importe" Binding="{Binding Monto, StringFormat='Bs {0:N2}'}" Width="130"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12"><Button Content="Cerrar" IsCancel="True" Style="{StaticResource SecondaryButton}"/></StackPanel></Grid>
</Window>
