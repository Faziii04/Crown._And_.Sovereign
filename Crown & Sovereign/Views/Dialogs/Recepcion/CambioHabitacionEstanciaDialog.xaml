<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.CambioHabitacionEstanciaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cambiar habitación" Width="700" Height="620" MinWidth="580" MinHeight="520" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Cambiar habitación" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="GuestText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Habitación a cambiar" FontWeight="SemiBold"/><ComboBox x:Name="SourceBox" DisplayMemberPath="Numero" SelectionChanged="Source_Changed" Margin="0,4,0,10"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Motivo" FontWeight="SemiBold"/><ComboBox x:Name="ReasonBox" Margin="0,4,0,10"/><TextBlock Text="Habitaciones disponibles · limpias y operativas" Foreground="{StaticResource Muted}"/></StackPanel><DataGrid x:Name="DestinationGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,7"><DataGrid.Columns><DataGridTextColumn Header="Habitación" Binding="{Binding Habitacion.Numero}" Width="120"/><DataGridTextColumn Header="Tipo" Binding="{Binding Habitacion.Tipo}" Width="*"/><DataGridTextColumn Header="Piso" Binding="{Binding Habitacion.Piso}" Width="70"/><DataGridTextColumn Header="Estado" Binding="{Binding Clasificacion}" Width="150"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3"><TextBlock Text="Observaciones"/><TextBox x:Name="NotesBox" Margin="0,4,0,0"/></StackPanel></Grid></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button Content="Confirmar cambio" IsDefault="True" Click="Confirm_Click"/></StackPanel></Grid>
</Window>
