<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.PagoDetalleDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Detalle del pago" Width="620" Height="590" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Detalle del pago" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel><TextBlock x:Name="PaymentText" TextWrapping="Wrap"/><Separator Margin="0,14"/><TextBlock Text="Correcciones financieras" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Las devoluciones y anulaciones requieren revisión de Gerencia antes de ejecutarse." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="RefundButton" Content="Solicitar devolución" Click="Refund_Click" Style="{StaticResource SecondaryButton}"/><Button x:Name="CancelButton" Content="Solicitar anulación" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"/></StackPanel><TextBlock x:Name="CorrectionText" Foreground="{StaticResource Success}" TextWrapping="Wrap" Margin="0,12"/></StackPanel></Border><Button Grid.Row="2" Content="Cerrar" IsCancel="True" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0"/></Grid>
</Window>
