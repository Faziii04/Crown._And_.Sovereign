<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.Habitaciones.SolicitarLimpiezaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Solicitar limpieza" Width="520" Height="570" MinWidth="460" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Solicitar limpieza" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="RoomText" Foreground="{StaticResource Muted}" Margin="0,4,0,14"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Motivo" FontWeight="SemiBold"/><ComboBox x:Name="ReasonBox" Margin="0,5,0,12"/><TextBlock Text="Prioridad solicitada" FontWeight="SemiBold"/><ComboBox x:Name="PriorityBox" Margin="0,5,0,12"/><TextBlock Text="Observaciones" FontWeight="SemiBold"/><TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,5,0,8"/><TextBlock x:Name="ArrivalText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Enviar solicitud" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid>
</Window>
