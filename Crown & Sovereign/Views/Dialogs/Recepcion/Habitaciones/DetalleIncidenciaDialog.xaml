<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.Habitaciones.DetalleIncidenciaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Detalle de incidencia" Width="510" Height="460" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Detalle de incidencia" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="RoomText" Foreground="{StaticResource Muted}" Margin="0,4,0,14"/></StackPanel><StackPanel Grid.Row="1"><TextBlock x:Name="DescriptionText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailsText" TextWrapping="Wrap" Margin="0,12,0,0"/><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,0"><TextBlock x:Name="ImpactText" TextWrapping="Wrap"/></Border><TextBlock x:Name="NotesText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel><Button Grid.Row="2" Content="Cerrar" Style="{StaticResource SecondaryButton}" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0"/></Grid>
</Window>
