<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.Habitaciones.ReportarIncidenciaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reportar incidencia" Width="560" Height="690" MinWidth="500" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Reportar incidencia" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="RoomText" Foreground="{StaticResource Muted}" Margin="0,4,0,14"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Categoría" FontWeight="SemiBold"/><ComboBox x:Name="CategoryBox" Margin="0,5,0,12"/><TextBlock Text="Descripción" FontWeight="SemiBold"/><TextBox x:Name="DescriptionBox" TextWrapping="Wrap" AcceptsReturn="True" Height="68" Margin="0,5,0,12"/><TextBlock Text="Prioridad solicitada" FontWeight="SemiBold"/><ComboBox x:Name="PriorityBox" Margin="0,5,0,12"/><TextBlock Text="Impacto observado" FontWeight="SemiBold"/><RadioButton x:Name="SafeRadio" Content="La habitación puede seguir utilizándose" GroupName="Impact" Margin="0,5"/><RadioButton x:Name="UrgentRadio" Content="La habitación requiere revisión urgente" GroupName="Impact" Margin="0,5"/><RadioButton x:Name="PreventUseRadio" Content="Existe un posible impedimento para alojar huéspedes" GroupName="Impact" Margin="0,5"/><TextBlock Text="Observaciones" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBox x:Name="NotesBox" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,5,0,8"/><TextBlock x:Name="WarningText" Text="El reporte no bloquea la habitación. El equipo de Mantenimiento evalúa la medida correspondiente." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Registrar incidencia" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid>
</Window>
