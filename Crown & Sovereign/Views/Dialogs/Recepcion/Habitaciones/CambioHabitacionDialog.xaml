<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.Habitaciones.CambioHabitacionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cambiar habitación" Width="900" Height="680" MinWidth="780" MinHeight="560" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,12"><TextBlock Text="Cambiar habitación" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="StayText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Habitación actual" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CurrentRoomText" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock x:Name="GuestsText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock x:Name="IncidentText" Foreground="#9A4545" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
   <Grid Grid.Column="1" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><ComboBox x:Name="FloorBox" Width="125" SelectionChanged="Filter_Changed"/><ComboBox x:Name="TypeBox" Width="150" Margin="7,0,0,0" SelectionChanged="Filter_Changed"/><ComboBox x:Name="AmenityBox" Width="150" Margin="7,0,0,0" SelectionChanged="Filter_Changed"/></WrapPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,9"><ItemsControl x:Name="RoomList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Id}" Click="SelectRoom_Click" Padding="12" Margin="4" Width="185" Height="104"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Style.Triggers><DataTrigger Binding="{Binding Seleccionada}" Value="True"><Setter Property="Background" Value="#E8EEF3"/><Setter Property="BorderBrush" Value="#3E5974"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="{Binding RoomTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="{Binding Availability}" Foreground="#39816A" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel Grid.Row="2"><TextBlock Text="Motivo del cambio" FontWeight="SemiBold"/><ComboBox x:Name="ReasonBox" Margin="0,4,0,8"/><TextBlock Text="Observaciones" FontWeight="SemiBold"/><TextBox x:Name="NotesBox" Margin="0,4"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/></StackPanel></Grid>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Confirmar cambio" Margin="8,0,0,0" Click="Confirm_Click"/></StackPanel>
 </Grid>
</Window>
