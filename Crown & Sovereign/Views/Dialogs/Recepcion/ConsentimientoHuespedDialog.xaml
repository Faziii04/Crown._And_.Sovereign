<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.ConsentimientoHuespedDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Actualizar consentimiento" Width="480" Height="390" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6F8"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Actualizar consentimiento" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="GuestName" Foreground="#64748B" Margin="0,4,0,12"/></StackPanel><Border Grid.Row="1" Background="White" BorderBrush="#DCE2E8" BorderThickness="1" CornerRadius="7" Padding="16"><StackPanel><TextBlock Text="Selecciona el nuevo estado" FontWeight="SemiBold"/><RadioButton x:Name="YesRadio" Content="Sí, autoriza el tratamiento" Margin="4,12"/><RadioButton x:Name="NoRadio" Content="No autoriza el tratamiento" Margin="4,4"/><TextBlock Text="Observación de registro" Margin="0,14,0,4"/><TextBox x:Name="NoteBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock x:Name="ErrorText" Foreground="#B65757" TextWrapping="Wrap"/></StackPanel></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" IsCancel="True" Margin="0,0,6,0"/><Button Content="Guardar cambio" IsDefault="True" Click="Save_Click"/></StackPanel></Grid></Window>
