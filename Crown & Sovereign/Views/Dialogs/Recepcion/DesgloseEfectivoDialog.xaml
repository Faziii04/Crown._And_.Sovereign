<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.DesgloseEfectivoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Desglose de efectivo" Width="850" Height="560" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Desglose de efectivo" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ShiftText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><DataGrid x:Name="MovementsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM HH:mm}" Width="140"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/><DataGridTextColumn Header="Huésped" Binding="{Binding Huesped}" Width="*"/><DataGridTextColumn Header="Folio" Binding="{Binding FolioId}" Width="90"/><DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="1.5*"/><DataGridTextColumn Header="Efectivo" Binding="{Binding Monto, StringFormat='Bs {0:N2}'}" Width="140"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="2" Margin="0,12"><TextBlock x:Name="TotalText" FontSize="18" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Cerrar" IsCancel="True" Style="{StaticResource SecondaryButton}"/></DockPanel></Grid>
</Window>
