<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.FacturaEmitirDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Emitir factura" Width="820" Height="680" MinWidth="680" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Emitir factura" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="FolioText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Cliente"/><TextBox x:Name="ClientBox" TextChanged="Client_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Documento"/><TextBox x:Name="DocumentBox"/></StackPanel></Grid>
  <DataGrid x:Name="LinesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Cargo" Binding="{Binding Concepto}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="100"/><DataGridTextColumn Header="Precio unitario" Binding="{Binding PrecioUnitario, StringFormat='Bs {0:N2}'}" Width="150"/><DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat='Bs {0:N2}'}" Width="150"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12"><TextBlock x:Name="SubtotalText"/><TextBlock x:Name="TaxText"/><TextBlock x:Name="TotalText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/></StackPanel><TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{StaticResource Danger}" VerticalAlignment="Bottom" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button Content="Emitir y ver factura" IsDefault="True" Click="Emit_Click"/></StackPanel>
 </Grid>
</Window>
