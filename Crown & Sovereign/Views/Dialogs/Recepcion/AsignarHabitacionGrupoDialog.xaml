<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.AsignarHabitacionGrupoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Añadir habitación al grupo" Width="540" Height="430" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Añadir habitación" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="GroupText" Foreground="{StaticResource Muted}" Margin="0,4,0,14"/></StackPanel><TextBlock Grid.Row="1" Text="Reserva del grupo"/><ComboBox x:Name="ReservationBox" Grid.Row="1" Margin="0,22,0,10" DisplayMemberPath="Huesped" SelectionChanged="Reservation_Changed"/><TextBlock Grid.Row="2" Text="Habitación disponible durante toda la estancia"/><ComboBox x:Name="RoomBox" Grid.Row="2" Margin="0,22,0,10" DisplayMemberPath="Numero"/><TextBlock Grid.Row="3" x:Name="InfoText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}"/><Button Content="Añadir" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid></Window>
