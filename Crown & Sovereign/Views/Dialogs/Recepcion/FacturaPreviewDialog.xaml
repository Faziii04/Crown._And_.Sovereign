<Window x:Class="Crown___Sovereign.Views.Dialogs.Recepcion.FacturaPreviewDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vista previa de factura" Width="640" Height="690" MinHeight="600" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Vista previa de factura" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Documento de muestra · sin integración tributaria." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="28"><StackPanel><TextBlock Text="CROWN &amp; SOVEREIGN" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Av. Arce · La Paz, Bolivia" Foreground="{StaticResource Muted}" Margin="0,3,0,15"/><Separator/><Grid Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FACTURA" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="InvoiceNumber" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="InvoiceDate" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="HUÉSPED" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="GuestName" FontWeight="SemiBold"/><TextBlock x:Name="GuestDocument" Margin="0,4,0,0"/></StackPanel></Grid><Separator/><Grid Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Concepto" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Importe" FontWeight="SemiBold"/><TextBlock x:Name="Description" Grid.Row="1" Margin="0,10,0,0"/><TextBlock x:Name="Amount" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"/></Grid><Separator/><Grid Margin="0,18,0,0"><TextBlock Text="Total" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="TotalText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource Primary}"/></Grid><TextBlock Text="Vista previa de la factura." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,20,0,0"/></StackPanel></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cerrar" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Imprimir" Click="Print_Click"/></StackPanel>
    </Grid>
</Window>
