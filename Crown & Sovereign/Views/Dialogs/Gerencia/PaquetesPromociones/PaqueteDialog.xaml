<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.PaquetesPromociones.PaqueteDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Paquete comercial" Width="1060" Height="740" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}" FontFamily="Segoe UI">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock x:Name="DialogHeading" Text="Nuevo paquete" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="Oferta adicional al alojamiento. Los beneficios se adquieren con la reserva y conservan sus condiciones." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
  <TabControl x:Name="Steps" Grid.Row="1" SelectionChanged="Steps_SelectionChanged">
   <TabItem Header="1 · Información general"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="20" MaxWidth="850" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,16,16"><TextBlock Text="Nombre comercial" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Margin="0,6,0,0" MaxLength="100"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,0,16"><TextBlock Text="Precio adicional del paquete (Bs)" FontWeight="SemiBold"/><TextBox x:Name="PriceBox" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,16"><TextBlock Text="Descripción" FontWeight="SemiBold"/><TextBox x:Name="DescriptionBox" Margin="0,6,0,0" MinHeight="86" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="400"/></StackPanel>
    <CheckBox x:Name="ActiveBox" Grid.Row="2" IsChecked="True" Content="Disponible para nuevas reservas"/><TextBlock Grid.Row="2" Grid.Column="1" Text="El estado activo de paquetes existe solo en el prototipo actual; el esquema PostgreSQL suministrado no guarda esta opción." TextWrapping="Wrap" Foreground="#AD7B34" Margin="10,0"/>
    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,22,0,0"><TextBlock Text="Imágenes del paquete" FontWeight="SemiBold"/><TextBlock Text="Una URL http(s) por línea. Se guardan en la estructura paquete_imagen disponible." Foreground="{StaticResource Muted}" Margin="0,3,0,6"/><TextBox x:Name="ImagesBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></StackPanel>
   </Grid></ScrollViewer></TabItem>
   <TabItem Header="2 · Beneficios incluidos"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,7,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="2,0,2,10"><TextBlock Text="Catálogo de servicios" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Busca y filtra el catálogo antes de añadir beneficios." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/></StackPanel><Grid Grid.Row="1" Height="36" Margin="0,0,0,8"><TextBox x:Name="ServiceSearch" VerticalContentAlignment="Center" Padding="9,4" ToolTip="Buscar por nombre de servicio, categoría o proveedor" TextChanged="ServiceSearch_TextChanged"/><TextBlock x:Name="SearchPrompt" Text="Buscar servicio, categoría o proveedor…" Foreground="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
     <Grid Grid.Row="2" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="Categoría" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,3"/><ComboBox x:Name="CategoryFilter" SelectionChanged="CatalogFilter_SelectionChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Subcategoría" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,3"/><ComboBox x:Name="SubcategoryFilter" SelectionChanged="CatalogFilter_SelectionChanged"/></StackPanel></Grid>
     <Grid Grid.Row="3" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="Proveedor" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,3"/><ComboBox x:Name="ProviderFilter" SelectionChanged="CatalogFilter_SelectionChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,5,0"><TextBlock Text="Inclusión" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,3"/><ComboBox x:Name="InclusionFilter" SelectionChanged="CatalogFilter_SelectionChanged"/></StackPanel><Button Grid.Column="2" Content="Limpiar" Style="{StaticResource SecondaryButton}" Padding="9,4" VerticalAlignment="Bottom" Click="ClearCatalogFilters_Click" ToolTip="Restablecer búsqueda y filtros"/></Grid>
     <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="2,1,2,6"><TextBlock Text="Coincidencias" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="ServiceResultCount" DockPanel.Dock="Right" Foreground="{StaticResource Primary}" FontSize="11" FontWeight="SemiBold"/></DockPanel><Grid Grid.Row="1"><ListBox x:Name="ServiceList" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Ruta}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Proveedor}" Foreground="{StaticResource Warning}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EsExterno}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><Button Grid.Column="1" Tag="{Binding Id}" Click="AddService_Click" Padding="10,5" VerticalAlignment="Center"><Button.Style><Style TargetType="Button"><Setter Property="Content" Value="Agregar"/><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding YaIncluido}" Value="True"><Setter Property="Content" Value="Agregado"/><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="ServicesEmpty" Text="No hay servicios con estos criterios. Prueba otros filtros o pulsa Limpiar." Foreground="{StaticResource Muted}" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" Margin="12"/></Grid></Grid></Grid></Border>
    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="7,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="2,0,2,10"><DockPanel><TextBlock Text="Beneficios seleccionados" FontSize="17" FontWeight="SemiBold"/><Border DockPanel.Dock="Right" Background="#EEF3F7" CornerRadius="10" Padding="8,3" Margin="8,0,0,0"><TextBlock x:Name="BenefitCountText" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/></Border></DockPanel><TextBlock Text="Ajusta la cobertura y el límite de cada servicio." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/></StackPanel><Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="BenefitsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Servicio}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Proveedor}" Foreground="{StaticResource Warning}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Proveedor}" Value="Interno"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Proveedor}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><Button Grid.Column="1" Content="Quitar" Tag="{Binding ServicioId}" Click="RemoveBenefit_Click" Padding="9,4"/><StackPanel Grid.Row="1" Margin="0,9,8,0"><TextBlock Text="Cobertura" Foreground="{StaticResource Muted}" FontSize="10"/><ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CoverageOptions}" SelectedItem="{Binding Cobertura, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Coverage_Changed" MinWidth="130"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><StackPanel Width="62" Margin="0,0,8,0"><TextBlock Text="Usos" Foreground="{StaticResource Muted}" FontSize="10"/><TextBox Text="{Binding LimiteUsos, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" IsEnabled="{Binding HabilitaLimite}"/></StackPanel><CheckBox Content="Compartido*" IsChecked="{Binding Compartido, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" Margin="0,0,0,6"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="BenefitsEmpty" Text="Aún no agregaste beneficios. Usa el catálogo para incluir un servicio." Foreground="{StaticResource Muted}" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="18" Visibility="Collapsed"/></Grid></Grid></Border>
    <TextBlock x:Name="BenefitsHint" Grid.Row="1" Grid.ColumnSpan="2" Text="Ilimitado no requiere usos. Por día y Por estancia requieren un límite positivo. * Compartido es solo prototipo; el esquema no guarda este alcance." Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="11" Margin="2,9,2,0"/>
   </Grid></TabItem>
   <TabItem Header="3 · Confirmación"><ScrollViewer><StackPanel Margin="26" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Revisa la oferta" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="El precio del paquete se suma al alojamiento. No incluye noches ni reemplaza la tarifa de habitación." Foreground="{StaticResource Primary}" TextWrapping="Wrap" Margin="0,8,0,18"/><TextBlock x:Name="ReviewName" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReviewPrice" FontSize="25" Foreground="{StaticResource Primary}" Margin="0,3,0,12"/><TextBlock x:Name="ReviewBenefits" TextWrapping="Wrap"/><TextBlock x:Name="HistoricalNote" Text="Los cambios de catálogo aplican a nuevas compras. Las reservas existentes conservan el precio acordado y la copia de beneficios capturada al confirmar." TextWrapping="Wrap" Foreground="#39816A" Margin="0,22,0,0"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancelar" IsCancel="True" Padding="18,8" Margin="0,0,8,0"/><Button x:Name="NextButton" Content="Siguiente" Padding="20,8" Click="Next_Click"/><Button x:Name="SaveButton" Content="Guardar paquete" Padding="20,8" Click="Save_Click" Visibility="Collapsed"/></StackPanel></DockPanel>
 </Grid>
</Window>

