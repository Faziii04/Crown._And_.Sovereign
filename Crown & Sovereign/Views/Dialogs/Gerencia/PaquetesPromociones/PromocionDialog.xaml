<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.PaquetesPromociones.PromocionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Promoción" Width="570" Height="500" MinWidth="500" MinHeight="440" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}" FontFamily="Segoe UI">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock x:Name="Heading" Text="Nueva promoción" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="El esquema persistente admite promociones porcentuales del 0 al 100 %. El descuento se aplica al alojamiento." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
  <StackPanel Grid.Row="1"><TextBlock Text="Nombre de campaña" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Margin="0,5,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,12"><TextBlock Text="Descuento (%)" FontWeight="SemiBold"/><TextBox x:Name="PercentBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Estado administrativo" FontWeight="SemiBold"/><CheckBox x:Name="ActiveBox" Content="Activa" IsChecked="True" Margin="0,9,0,0"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,12"><TextBlock Text="Válida desde" FontWeight="SemiBold"/><DatePicker x:Name="StartDate" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Válida hasta" FontWeight="SemiBold"/><DatePicker x:Name="EndDate" Margin="0,5,0,0"/></StackPanel></Grid><Border Background="#FFF5E8" CornerRadius="6" Padding="10"><TextBlock Text="Vigencia y estado son distintos: una campaña puede estar activa pero fuera de sus fechas. La recepción solo ofrecerá campañas activas y válidas para la fecha de llegada." Foreground="#8C632E" TextWrapping="Wrap"/></Border></StackPanel>
  <DockPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancelar" IsCancel="True" Padding="16,8" Margin="0,0,8,0"/><Button Content="Guardar promoción" Padding="18,8" Click="Save_Click"/></StackPanel></DockPanel>
 </Grid>
</Window>
