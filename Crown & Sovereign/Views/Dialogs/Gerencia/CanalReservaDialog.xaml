<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.CanalReservaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Canal de reserva" Width="420" Height="335" MinWidth="360" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="Heading" Text="Nuevo canal" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="La comisión es un porcentaje y se informa aparte del precio al huésped." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Nombre del canal"/><TextBox x:Name="ChannelName"/><TextBlock Text="Comisión (%)"/><TextBox x:Name="Commission" Text="0"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="Guardar" Click="Save_Click"/></StackPanel></Grid></Window>
