 Title="Vista de impresión del reporte" Width="980" Height="720" WindowStartupLocation="CenterOwner" Background="#EEF1F5">
 <DockPanel Margin="14"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10"><Button Content="Imprimir…" Padding="14,7" Click="Print_Click"/><Button Content="Cerrar" Padding="14,7" Margin="8,0,0,0" Click="Close_Click"/></StackPanel>
  <Border Background="White" BorderBrush="#D9DFE7" BorderThickness="1" Padding="8"><FlowDocumentReader x:Name="DocumentViewer" ViewingMode="Print" IsFindEnabled="False" IsPrintEnabled="False" IsTwoPageViewEnabled="False" IsPageViewEnabled="True"/></Border>
 </DockPanel>
