<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.Supervision.NotificarSituacionOperativaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Notificar situación operativa" Width="560" Height="470" MinHeight="420" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Notificar situación operativa" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="La notificación se mostrará al Encargado de servicios dentro de la aplicación." Foreground="{StaticResource Muted}" Margin="0,3"/></StackPanel><StackPanel Grid.Row="1" Margin="0,16"><TextBlock Text="Situación" FontWeight="SemiBold"/><TextBlock x:Name="SituationText" TextWrapping="Wrap" Margin="0,4,0,12"/><TextBlock Text="Destinatario"/><TextBlock x:Name="RecipientText" FontWeight="SemiBold" Margin="0,4,0,12"/><TextBlock Text="Mensaje"/><TextBox x:Name="MessageBox" Height="115" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4"/><TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="Enviar notificación" Style="{StaticResource PrimaryButton}" Click="Send_Click"/></StackPanel></Grid>
</Window>
