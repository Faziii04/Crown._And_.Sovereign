<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.AjusteMasivoTarifasDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ajuste de tarifas" Width="720" Height="620" MinWidth="540" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Ajuste masivo de tarifas" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Elige el origen y revisa todos los importes antes de aplicar. Solo se actualizan las configuraciones existentes; no se crean precios faltantes." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/></StackPanel><WrapPanel Grid.Row="1" Margin="0,0,0,10"><StackPanel Width="240"><TextBlock Text="Origen de precios"/><ComboBox x:Name="Scope" SelectionChanged="Input_Changed"><ComboBoxItem Content="Tarifas base actuales"/><ComboBoxItem Content="Precios estacionales existentes"/></ComboBox></StackPanel><StackPanel Width="170"><TextBlock Text="Tipo de ajuste"/><ComboBox x:Name="Mode" SelectionChanged="Input_Changed"><ComboBoxItem Content="Porcentaje (%)"/><ComboBoxItem Content="Importe fijo (Bs)"/></ComboBox></StackPanel><StackPanel Width="140"><TextBlock Text="Valor"/><TextBox x:Name="Amount" Text="0" TextChanged="Input_Changed"/></StackPanel><Button Content="Generar vista previa" VerticalAlignment="Bottom" Click="Preview_Click"/></WrapPanel><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="Summary" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><DataGrid x:Name="PreviewGrid" Grid.Row="1" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Habitación · temporada · canal" Binding="{Binding Concepto}" Width="2*"/><DataGridTextColumn Header="Actual" Binding="{Binding Antes, StringFormat=Bs {0:N2}}" Width="*"/><DataGridTextColumn Header="Propuesto" Binding="{Binding Despues, StringFormat=Bs {0:N2}}" Width="*"/></DataGrid.Columns></DataGrid></Grid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button x:Name="ApplyButton" Content="Aplicar cambios revisados" IsEnabled="False" Click="Apply_Click"/></StackPanel></Grid></Window>
