<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.Politicas.EditarPoliticaDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Editar política" Width="520" Height="390" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="DescriptionText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel>
  <StackPanel Grid.Row="1"><TextBlock Text="Valor actual" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CurrentText" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,12"/><TextBlock Text="Nuevo valor"/><TextBox x:Name="ValueBox" Padding="10,8" Margin="0,5,0,8"/><ComboBox x:Name="PetBox" Padding="8,6" Visibility="Collapsed"/><TextBlock x:Name="RuleText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="Revisar cambio" Padding="14,7" Click="Save_Click"/></StackPanel>
 </Grid>
</Window>
