<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.Politicas.SimularCancelacionReservaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Simular cancelación" Width="520" Height="515" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource Canvas}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Simular cancelación de reserva" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="La simulación es de solo lectura; no cancela reservas ni genera cargos." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel>
  <StackPanel Grid.Row="1"><TextBlock Text="Fecha prevista de ingreso"/><DatePicker x:Name="ArrivalDate" Margin="0,4,0,10"/><TextBlock Text="Fecha de cancelación simulada"/><DatePicker x:Name="CancelDate" Margin="0,4,0,10"/><TextBlock Text="Hora de cancelación"/><TextBox x:Name="CancelTime" Text="12:00" Padding="9,6" Margin="0,4,0,12"/><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="13"><StackPanel><TextBlock x:Name="PolicyText"/><TextBlock x:Name="ResultTitle" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock x:Name="ResultText" TextWrapping="Wrap"/><TextBlock x:Name="LimitationText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cerrar" Padding="14,7" Click="Close_Click"/><Button Content="Calcular simulación" Padding="14,7" Margin="8,0,0,0" Click="Simulate_Click"/></StackPanel>
 </Grid>
</Window>
