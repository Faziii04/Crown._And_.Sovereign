<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.CopiarTarifasTemporadaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Copiar tarifas de temporada" Width="520" Height="430" MinWidth="420" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Copiar configuraciones" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Solo copia precios por habitación y canal. No cambia reservas ni cargos históricos." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Temporada de origen"/><ComboBox x:Name="Source" DisplayMemberPath="Nombre" SelectionChanged="Selection_Changed"/><TextBlock Text="Temporada de destino"/><ComboBox x:Name="Target" DisplayMemberPath="Nombre" SelectionChanged="Selection_Changed"/><CheckBox x:Name="ReplaceExisting" Content="Reemplazar los precios ya configurados en destino" Margin="5,10" Checked="Selection_Changed" Unchecked="Selection_Changed"/><Button Content="Revisar copia" HorizontalAlignment="Left" Click="Preview_Click"/><TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="4,12"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button x:Name="ApplyButton" Content="Copiar precios revisados" IsEnabled="False" Click="Apply_Click"/></StackPanel></Grid></Window>
