<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.TarifaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tarifa base" Width="420" Height="350" MinWidth="360" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Editar tarifa base" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="RoomTypeText" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Precio base por noche (Bs)"/><TextBox x:Name="PriceBox" Margin="0,4,0,12"/><TextBlock Text="Se usa como respaldo cuando no existe una tarifa estacional para el canal elegido. Los precios estacionales ya configurados permanecen iguales." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="3,0"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="Guardar tarifa base" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid></Window>
