<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.ConfiguracionTarifaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Precio de temporada" Width="430" Height="340" MinWidth="360" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Precio de temporada" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="Context" Foreground="{StaticResource Muted}" Margin="0,5,0,14" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Importe por noche (Bs)"/><TextBox x:Name="Price"/><TextBlock Text="Solo cambia este canal y temporada. Las reservas ya confirmadas conservan su precio acordado." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="3,8"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="Guardar precio" Click="Save_Click"/></StackPanel></Grid></Window>
