<Window x:Class="Crown___Sovereign.Views.Dialogs.Gerencia.MotivoRechazoFinancieroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rechazar solicitud financiera" Width="500" Height="330" MinWidth="460" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource Canvas}">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Motivo del rechazo" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="RequestText" Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8"/>
        <TextBox x:Name="ReasonBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="90" VerticalContentAlignment="Top"/>
        <DockPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Volver" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="Confirmar rechazo" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="Confirm_Click"/></StackPanel></DockPanel>
    </Grid>
</Window>
