<Window x:Class="Crown___Sovereign.Views.Windows.NotificacionesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Notificaciones" Width="620" Height="480" MinWidth="480" MinHeight="340" WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,12"><TextBlock Text="Notificaciones" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" Margin="0,4"/></StackPanel><ListBox x:Name="NotificationList" Grid.Row="1" BorderBrush="{StaticResource Line}" Background="White" SelectionChanged="NotificationList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Fecha, StringFormat={}{0:dd MMM yyyy HH:mm}}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="No leída" Foreground="{StaticResource Primary}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Leida}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Selecciona una notificación para abrir su sección asociada." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="Cerrar" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="14,6" Click="Close_Click"/></DockPanel></Grid></Window>
